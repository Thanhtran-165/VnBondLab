//@version=6
indicator("VN YieldCurveLab v2.3.0 — Horizon Separation & Sample Power",
     shorttitle = "VN YieldCurveLab 2.3.0",
     overlay = false,
     max_bars_back = 5000,
     precision = 4,
     dynamic_requests = false)

//======================================================
// v2.3.0: separate 1W tactical and 4W strategic validation,
// adaptive 52/52 -> 104/104 sample-power windows, episode-aware hard gates.
// 00) INPUTS
//======================================================
int panelView = input.int(1, "Panel (1=State, 2=Tactical 1W, 3=Strategic 4W, 4=Diagnostics)", minval = 1, maxval = 4)
bool showP1 = panelView == 1
bool showP2 = panelView == 2
bool showP3 = panelView == 3
bool showP4 = panelView == 4

//======================================================
// 01) STRICT CONSTANTS
//======================================================
const string TF_DATA = "D"
const string SYM_VNX = "HOSE:VNINDEX"
const string SYM_1Y  = "TVC:VN01Y"
const string SYM_2Y  = "TVC:VN02Y"
const string SYM_3Y  = "TVC:VN03Y"
const string SYM_5Y  = "TVC:VN05Y"
const string SYM_7Y  = "TVC:VN07Y"
const string SYM_10Y = "TVC:VN10Y"
const string SYM_IB  = "VNINBR"
const string SYM_PR  = "VNINTR"

// Rolling state windows
const int LEN_STATS = 252
const int LEN_COV   = 252
const float CLIP_Z  = 2.5

// Regime thresholds
const float STRESS_LOW_PCTL  = 20.0
const float STRESS_HIGH_PCTL = 80.0
const float LIQ_LOW_PCTL     = 30.0
const float LIQ_HIGH_PCTL    = 70.0

// Coverage and freshness gates
const float COV_CURVE_MIN = 0.90
const int MAX_STALE_BARS  = 3

// Adaptive sample-power architecture
const int STD_DEV_WEEKS  = 52
const int STD_VAL_WEEKS  = 52
const int HIGH_DEV_WEEKS = 104
const int HIGH_VAL_WEEKS = 104
const int STD_TOTAL_WEEKS  = STD_DEV_WEEKS + STD_VAL_WEEKS
const int HIGH_TOTAL_WEEKS = HIGH_DEV_WEEKS + HIGH_VAL_WEEKS
const int MAX_TACTICAL_SAMPLES  = HIGH_TOTAL_WEEKS
const int MAX_STRATEGIC_SAMPLES = HIGH_TOTAL_WEEKS

// Horizon separation
const int TACTICAL_HORIZON_WEEKS  = 1
const int STRATEGIC_HORIZON_WEEKS = 4
const int TACTICAL_COOLDOWN_WEEKS  = 1
const int STRATEGIC_COOLDOWN_WEEKS = 4

// Sample gates
const int MIN_STATE_N_STD  = 8
const int MIN_STATE_N_HIGH = 16
const int MIN_TACTICAL_EP_STD  = 3
const int MIN_TACTICAL_EP_HIGH = 6
const int MIN_STRATEGIC_EP_STD  = 3
const int MIN_STRATEGIC_EP_HIGH = 5

// Tactical decision thresholds — log-return space
const float TACT_EFFECT_STRONG = 0.0050  // 0.50%
const float TACT_EFFECT_WEAK   = 0.0025  // 0.25%

// Strategic decision thresholds — log-return space
const float STRAT_EFFECT_STRONG = 0.0200 // 2.00%
const float STRAT_EFFECT_WEAK   = 0.0100 // 1.00%

// Shared hard gates
const float HIT_LIFT_STRONG = 5.0
const float HIT_LIFT_WEAK   = 3.0
const float T_MIN_STRONG    = 1.96
const float CI_Z_95         = 1.96
const float EVIDENCE_STRONG = 70.0
const float EVIDENCE_WEAK   = 55.0

// Internal states
const int STATE_NA   = 0
const int STATE_LOW  = 1
const int STATE_MID  = 2
const int STATE_HIGH = 3

const int DEC_NO_SIGNAL    = 0
const int DEC_DEFENSIVE    = 1
const int DEC_CAUTIOUS     = 2
const int DEC_NEUTRAL      = 3
const int DEC_CONSTRUCTIVE = 4
const int DEC_MIXED        = 5

//======================================================
// 02) HELPERS
//======================================================
f_num(float value, string fmt) =>
    na(value) ? "NA" : str.tostring(value, fmt)

f_pct1(float value) =>
    na(value) ? "NA" : str.tostring(value, "#.0") + "%"

f_pct2(float value) =>
    na(value) ? "NA" : str.tostring(value, "#.00") + "%"

f_log_to_pct(float logReturn) =>
    na(logReturn) ? na : (math.exp(logReturn) - 1.0) * 100.0

f_count(bool condition, int length) =>
    float x = condition ? 1.0 : 0.0
    float cumulative = ta.cum(x)
    cumulative - nz(cumulative[length])

f_winsor_z(float src, int length, float clip) =>
    float mean0 = ta.sma(src, length)
    float sd0 = ta.stdev(src, length)
    float upper = mean0 + clip * sd0
    float lower = mean0 - clip * sd0
    float clipped = math.max(lower, math.min(upper, src))
    float mean1 = ta.sma(clipped, length)
    float sd1 = ta.stdev(clipped, length)
    sd1 > 0 ? (src - mean1) / sd1 : 0.0

f_state_name(int state) =>
    state == STATE_HIGH ? "HIGH" :
     state == STATE_LOW ? "LOW" :
     state == STATE_MID ? "MID" : "NA"

f_decision_name(int code) =>
    code == DEC_DEFENSIVE ? "DEFENSIVE" :
     code == DEC_CAUTIOUS ? "CAUTIOUS" :
     code == DEC_NEUTRAL ? "NEUTRAL" :
     code == DEC_CONSTRUCTIVE ? "CONSTRUCTIVE" :
     code == DEC_MIXED ? "MIXED" : "NO SIGNAL"

f_model_data_label(float covCurve, float covVnx, bool fresh) =>
    float modelCoverage = math.min(covCurve, covVnx)
    string out = "DATAQ LOW"
    if fresh and modelCoverage >= 0.95
        out := "DATAQ HIGH"
    else if fresh and modelCoverage >= COV_CURVE_MIN
        out := "DATAQ MED"
    out

f_bg_tag(string tag) =>
    color out = color.new(color.gray, 84)
    if tag == "HIGH" or tag == "YC4" or tag == "INVERTED" or tag == "DATAQ LOW" or tag == "DEFENSIVE"
        out := color.new(color.red, 12)
    else if tag == "LOW" or tag == "YC1" or tag == "DATAQ HIGH" or tag == "CONSTRUCTIVE"
        out := color.new(color.lime, 14)
    else
        out := color.new(color.orange, 16)
    out

f_evidence_bg(float score) =>
    na(score) ? color.new(color.gray, 80) :
     score >= EVIDENCE_STRONG ? color.new(color.lime, 15) :
     score >= EVIDENCE_WEAK ? color.new(color.orange, 18) : color.new(color.red, 15)

f_readiness_bg(float score) =>
    na(score) ? color.new(color.gray, 80) :
     score >= 90 ? color.new(color.lime, 15) :
     score >= 70 ? color.new(color.orange, 18) : color.new(color.red, 15)

f_validation_bg(string status) =>
    str.contains(status, "NEGATIVE") ? color.new(color.red, 12) :
     str.contains(status, "POSITIVE") ? color.new(color.lime, 14) :
     str.contains(status, "UNSTABLE") ? color.new(color.red, 24) :
     str.contains(status, "INCONCLUSIVE") or str.contains(status, "LOW") or str.contains(status, "DESCRIPTIVE") or str.contains(status, "BUILDING") ? color.new(color.orange, 18) :
     color.new(color.gray, 80)

f_hit_bg(float hitLift) =>
    na(hitLift) ? color.new(color.gray, 80) :
     hitLift >= HIT_LIFT_STRONG ? color.new(color.red, 12) :
     hitLift <= -HIT_LIFT_STRONG ? color.new(color.lime, 14) : color.new(color.orange, 18)

f_push_limited(array<int> states, array<float> returns, int state, float outcome, int maxSize) =>
    array.push(states, state)
    array.push(returns, outcome)
    if array.size(returns) > maxSize
        array.shift(states)
        array.shift(returns)

f_push_boundary(array<int> states, array<float> closes, int state, float closeValue, int maxSize) =>
    array.push(states, state)
    array.push(closes, closeValue)
    if array.size(closes) > maxSize
        array.shift(states)
        array.shift(closes)

// Descriptive state/complement statistics over an array range.
// Output: nTarget, meanTarget, hitTarget, nComp, meanComp, hitComp, diff, Welch-t.
f_stats_range(array<int> states, array<float> returns, int startIndex, int sampleCount, int targetState) =>
    float nTarget = 0.0
    float sumTarget = 0.0
    float sumSqTarget = 0.0
    float downTarget = 0.0
    float nComp = 0.0
    float sumComp = 0.0
    float sumSqComp = 0.0
    float downComp = 0.0

    int sizeNow = array.size(returns)
    if sampleCount > 0 and startIndex >= 0 and startIndex < sizeNow
        int stopIndex = math.min(sizeNow - 1, startIndex + sampleCount - 1)
        for i = startIndex to stopIndex
            int state = array.get(states, i)
            float r = array.get(returns, i)
            if state == targetState
                nTarget += 1.0
                sumTarget += r
                sumSqTarget += r * r
                downTarget += r < 0 ? 1.0 : 0.0
            else if state != STATE_NA
                nComp += 1.0
                sumComp += r
                sumSqComp += r * r
                downComp += r < 0 ? 1.0 : 0.0

    float meanTarget = nTarget > 0 ? sumTarget / nTarget : na
    float meanComp = nComp > 0 ? sumComp / nComp : na
    float varTarget = nTarget > 1 ? math.max(0.0, (sumSqTarget - nTarget * meanTarget * meanTarget) / (nTarget - 1.0)) : na
    float varComp = nComp > 1 ? math.max(0.0, (sumSqComp - nComp * meanComp * meanComp) / (nComp - 1.0)) : na
    float hitTarget = nTarget > 0 ? 100.0 * downTarget / nTarget : na
    float hitComp = nComp > 0 ? 100.0 * downComp / nComp : na
    float diff = not na(meanTarget) and not na(meanComp) ? meanTarget - meanComp : na
    float seDiff = not na(varTarget) and not na(varComp) and nTarget > 0 and nComp > 0 ? math.sqrt(varTarget / nTarget + varComp / nComp) : na
    float tWelch = not na(diff) and not na(seDiff) and seDiff > 0 ? diff / seDiff : na
    [nTarget, meanTarget, hitTarget, nComp, meanComp, hitComp, diff, tWelch]

// Episode-aware statistics with category-specific cooldown.
// Output: target N/mean/hit, complement N/mean/hit,
//         target-minus-complement, SE, Welch-t, 95% CI low/high.
f_episode_stats_range(array<int> states, array<float> returns, int startIndex, int sampleCount, int targetState, int cooldownWeeks) =>
    float nTarget = 0.0
    float sumTarget = 0.0
    float sumSqTarget = 0.0
    float downTarget = 0.0
    float nComp = 0.0
    float sumComp = 0.0
    float sumSqComp = 0.0
    float downComp = 0.0

    // A single accepted-entry clock prevents target and complement
    // outcomes from overlapping each other at the strategic horizon.
    int lastAcceptedEntry = -1000000
    int sizeNow = array.size(returns)

    if sampleCount > 0 and startIndex >= 0 and startIndex < sizeNow
        int stopIndex = math.min(sizeNow - 1, startIndex + sampleCount - 1)
        for i = startIndex to stopIndex
            int stateNow = array.get(states, i)
            float r = array.get(returns, i)
            int stateBefore = i > 0 ? array.get(states, i - 1) : STATE_NA
            bool episodeStart = i == 0 or stateNow != stateBefore
            bool cooldownOK = i - lastAcceptedEntry >= cooldownWeeks

            if episodeStart and cooldownOK and stateNow != STATE_NA
                if stateNow == targetState
                    nTarget += 1.0
                    sumTarget += r
                    sumSqTarget += r * r
                    downTarget += r < 0 ? 1.0 : 0.0
                else
                    nComp += 1.0
                    sumComp += r
                    sumSqComp += r * r
                    downComp += r < 0 ? 1.0 : 0.0
                lastAcceptedEntry := i

    float meanTarget = nTarget > 0 ? sumTarget / nTarget : na
    float meanComp = nComp > 0 ? sumComp / nComp : na
    float varTarget = nTarget > 1 ? math.max(0.0, (sumSqTarget - nTarget * meanTarget * meanTarget) / (nTarget - 1.0)) : na
    float varComp = nComp > 1 ? math.max(0.0, (sumSqComp - nComp * meanComp * meanComp) / (nComp - 1.0)) : na
    float hitTarget = nTarget > 0 ? 100.0 * downTarget / nTarget : na
    float hitComp = nComp > 0 ? 100.0 * downComp / nComp : na
    float diff = not na(meanTarget) and not na(meanComp) ? meanTarget - meanComp : na
    float seDiff = not na(varTarget) and not na(varComp) and nTarget > 0 and nComp > 0 ? math.sqrt(varTarget / nTarget + varComp / nComp) : na
    float tWelch = not na(diff) and not na(seDiff) and seDiff > 0 ? diff / seDiff : na
    float ciLow = not na(diff) and not na(seDiff) ? diff - CI_Z_95 * seDiff : na
    float ciHigh = not na(diff) and not na(seDiff) ? diff + CI_Z_95 * seDiff : na

    [nTarget, meanTarget, hitTarget,
     nComp, meanComp, hitComp,
     diff, seDiff, tWelch, ciLow, ciHigh]

f_state_validation_status(bool historyReady, bool episodeReady, float devDiff, float valDiff, float ciLow, float ciHigh, float valT, float weakEffect) =>
    bool signOK = episodeReady and not na(devDiff) and not na(valDiff) and math.sign(devDiff) == math.sign(valDiff) and math.sign(valDiff) != 0
    bool ciExcludesZero = episodeReady and not na(ciLow) and not na(ciHigh) and (ciLow > 0 or ciHigh < 0)
    bool validated = signOK and ciExcludesZero and not na(valT) and math.abs(valT) >= T_MIN_STRONG and math.abs(valDiff) >= weakEffect
    string status = not historyReady ? "BUILDING HISTORY" :
         not episodeReady ? "EPISODE N LOW" :
         not signOK ? "DIRECTION UNSTABLE" :
         validated and valDiff < 0 ? "VALIDATED NEGATIVE" :
         validated and valDiff > 0 ? "VALIDATED POSITIVE" : "INCONCLUSIVE"
    status

f_evidence_score(bool sampleReady, bool signOK, bool ciOK, float valDiff, float valT, float hitLift, float effectStrong, float minEpisodeN, float devN, float devCompN, float valN, float valCompN) =>
    float minObserved = math.min(math.min(devN, devCompN), math.min(valN, valCompN))
    float samplePoints = sampleReady and minEpisodeN > 0 ? math.min(10.0, 10.0 * minObserved / minEpisodeN) : 0.0
    float signPoints = signOK ? 20.0 : 0.0
    float ciPoints = signOK and ciOK ? 20.0 : 0.0
    float effectPoints = not na(valDiff) and effectStrong > 0 ? math.min(20.0, 20.0 * math.abs(valDiff) / effectStrong) : 0.0
    float tPoints = not na(valT) ? math.min(20.0, 20.0 * math.abs(valT) / 2.50) : 0.0
    float hitPoints = not na(hitLift) ? math.min(10.0, 10.0 * math.abs(hitLift) / 10.0) : 0.0
    float raw = samplePoints + signPoints + ciPoints + effectPoints + tPoints + hitPoints
    float score = not sampleReady ? 0.0 :
         not signOK ? math.min(20.0, raw) :
         not ciOK ? math.min(49.0, raw) : raw
    score

f_horizon_decision(bool operational, bool validatedNegative, bool validatedPositive, float diff, float downsideLift, float evidence, float weakEffect, float strongEffect) =>
    int code = DEC_NO_SIGNAL
    if operational
        bool strongAdverse = validatedNegative and diff <= -strongEffect and downsideLift >= HIT_LIFT_STRONG and evidence >= EVIDENCE_STRONG
        bool weakAdverse = validatedNegative and diff <= -weakEffect and downsideLift >= HIT_LIFT_WEAK and evidence >= EVIDENCE_WEAK
        bool strongPositive = validatedPositive and diff >= strongEffect and downsideLift <= -HIT_LIFT_STRONG and evidence >= EVIDENCE_STRONG
        if strongAdverse
            code := DEC_DEFENSIVE
        else if weakAdverse
            code := DEC_CAUTIOUS
        else if strongPositive
            code := DEC_CONSTRUCTIVE
        else
            code := DEC_NEUTRAL
    code

f_same_state_transition(array<int> states, int startIndex, int sampleCount, int targetState) =>
    float nFrom = 0.0
    float nSame = 0.0
    int sizeNow = array.size(states)
    if sampleCount >= 2 and startIndex >= 0 and startIndex < sizeNow - 1
        int stopIndex = math.min(sizeNow - 2, startIndex + sampleCount - 2)
        for i = startIndex to stopIndex
            int stateNow = array.get(states, i)
            int stateNext = array.get(states, i + 1)
            if stateNow == targetState
                nFrom += 1.0
                nSame += stateNext == targetState ? 1.0 : 0.0
    float probability = nFrom > 0 ? 100.0 * nSame / nFrom : na
    [nFrom, probability]

//======================================================
// 03) OPERATING MODE
//======================================================
bool chartTimeframeOK = timeframe.isdaily and timeframe.multiplier == 1
bool confirmedBar = barstate.isconfirmed

//======================================================
// 04) RAW DATA REQUESTS
//======================================================
float y1Raw  = request.security(SYM_1Y,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float y2Raw  = request.security(SYM_2Y,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float y3Raw  = request.security(SYM_3Y,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float y5Raw  = request.security(SYM_5Y,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float y7Raw  = request.security(SYM_7Y,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float y10Raw = request.security(SYM_10Y, TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float ibRaw  = request.security(SYM_IB,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)
float prRaw  = request.security(SYM_PR,  TF_DATA, close, barmerge.gaps_on, barmerge.lookahead_off)

int vnxTimeRaw    = request.security(SYM_VNX, TF_DATA, time,      barmerge.gaps_on, barmerge.lookahead_off)
int vnxWeekKeyRaw = request.security(SYM_VNX, TF_DATA, time("W"), barmerge.gaps_on, barmerge.lookahead_off)
float vnxCloseRaw = request.security(SYM_VNX, TF_DATA, close,     barmerge.gaps_on, barmerge.lookahead_off)

//======================================================
// 05) DISPLAY SERIES — NOT SAMPLE VALIDITY
//======================================================
var float y1Display  = na
var float y2Display  = na
var float y3Display  = na
var float y5Display  = na
var float y7Display  = na
var float y10Display = na
var float ibDisplay  = na
var float prDisplay  = na

y1Display  := na(y1Raw)  ? y1Display[1]  : y1Raw
y2Display  := na(y2Raw)  ? y2Display[1]  : y2Raw
y3Display  := na(y3Raw)  ? y3Display[1]  : y3Raw
y5Display  := na(y5Raw)  ? y5Display[1]  : y5Raw
y7Display  := na(y7Raw)  ? y7Display[1]  : y7Raw
y10Display := na(y10Raw) ? y10Display[1] : y10Raw
ibDisplay  := na(ibRaw)  ? ibDisplay[1]  : ibRaw
prDisplay  := na(prRaw)  ? prDisplay[1]  : prRaw

//======================================================
// 06) DATA INTEGRITY ENGINE
//======================================================
bool coreRawOK = not na(y2Raw) and not na(y5Raw) and not na(y10Raw)
bool fullRawOK = not na(y1Raw) and not na(y2Raw) and not na(y3Raw) and not na(y5Raw) and not na(y7Raw) and not na(y10Raw)
bool liquidityRawOK = not na(ibRaw) and not na(prRaw)
bool vnxRawOK = not na(vnxTimeRaw) and not na(vnxCloseRaw)

float coreCount = f_count(coreRawOK, LEN_COV)
float fullCount = f_count(fullRawOK, LEN_COV)
float liquidityCount = f_count(liquidityRawOK, LEN_COV)
float vnxCount = f_count(vnxRawOK, LEN_COV)

float covCurve = coreCount / LEN_COV
float covFull = fullCount / LEN_COV
float covLiquidity = liquidityCount / LEN_COV
float covVnx = vnxCount / LEN_COV

int barsSinceCore = ta.barssince(coreRawOK)
int barsSinceVnx = ta.barssince(vnxRawOK)
bool coreFresh = not na(barsSinceCore) and barsSinceCore <= MAX_STALE_BARS
bool vnxFresh = not na(barsSinceVnx) and barsSinceVnx <= 1
bool dataReady = chartTimeframeOK and coreFresh and vnxFresh and covCurve >= COV_CURVE_MIN and covVnx >= COV_CURVE_MIN
string dataLabel = f_model_data_label(covCurve, covVnx, coreFresh and vnxFresh)

//======================================================
// 07) MACRO STATE ENGINE
//======================================================
float level = (y2Display + y5Display + y10Display) / 3.0
float slope = y10Display - y2Display
float curvature = 2.0 * y5Display - y2Display - y10Display

float levelPctCalc = ta.percentrank(level, LEN_STATS)
float slopePctCalc = ta.percentrank(slope, LEN_STATS)
float curvePctCalc = ta.percentrank(curvature, LEN_STATS)

float levelPct = chartTimeframeOK ? levelPctCalc : na
float slopePct = chartTimeframeOK ? slopePctCalc : na
float curvePct = chartTimeframeOK ? curvePctCalc : na

float levelPressure = levelPct
float slopeRisk = slope <= 0 ? 100.0 : 100.0 - slopePct
float curveRisk = not na(curvePct) ? math.abs(curvePct - 50.0) * 2.0 : na
float curveStress = 0.45 * levelPressure + 0.45 * slopeRisk + 0.10 * curveRisk
float stressPctCalc = ta.percentrank(curveStress, LEN_STATS)
float stressPct = chartTimeframeOK ? stressPctCalc : na

int stressState = na(stressPct) ? STATE_NA :
     stressPct >= STRESS_HIGH_PCTL ? STATE_HIGH :
     stressPct <= STRESS_LOW_PCTL ? STATE_LOW : STATE_MID

float liquidityGap = ibDisplay - prDisplay
float liquidityGapPctCalc = ta.percentrank(liquidityGap, LEN_STATS)
float liquidityGapPct = chartTimeframeOK ? liquidityGapPctCalc : na
string liquidityState = na(liquidityGapPct) ? "NA" :
     liquidityGapPct >= LIQ_HIGH_PCTL ? "TIGHT" :
     liquidityGapPct <= LIQ_LOW_PCTL ? "EASY" : "NORMAL"

string levelReg = na(levelPct) ? "NA" : levelPct >= 80 ? "HIGH" : levelPct <= 20 ? "LOW" : "MID"
string slopeReg = na(slopePct) ? "NA" :
     slope <= 0 ? "INVERTED" :
     slopePct >= 80 ? "STEEP_HIGH" :
     slopePct <= 20 ? "LOW_SLOPE" : "NORMAL_SLOPE"

string ycCode = "YC0"
string ycLabel = "Neutral/Mixed"
if levelReg == "HIGH" and slopeReg != "STEEP_HIGH" and slopeReg != "NA"
    ycCode := "YC4"
    ycLabel := "High level + non-steep/inverted"
else if levelReg == "HIGH" and slopeReg == "STEEP_HIGH"
    ycCode := "YC3"
    ycLabel := "High level + steep"
else if levelReg == "LOW" and slopeReg == "STEEP_HIGH"
    ycCode := "YC2"
    ycLabel := "Low level + steep"
else if levelReg == "LOW"
    ycCode := "YC1"
    ycLabel := "Low-level easing state"

float z1  = f_winsor_z(y1Display,  LEN_STATS, CLIP_Z)
float z2  = f_winsor_z(y2Display,  LEN_STATS, CLIP_Z)
float z3  = f_winsor_z(y3Display,  LEN_STATS, CLIP_Z)
float z5  = f_winsor_z(y5Display,  LEN_STATS, CLIP_Z)
float z7  = f_winsor_z(y7Display,  LEN_STATS, CLIP_Z)
float z10 = f_winsor_z(y10Display, LEN_STATS, CLIP_Z)
float zMean = (z1 + z2 + z3 + z5 + z7 + z10) / 6.0
float dispersion = math.sqrt(((z1-zMean)*(z1-zMean) + (z2-zMean)*(z2-zMean) + (z3-zMean)*(z3-zMean) +
     (z5-zMean)*(z5-zMean) + (z7-zMean)*(z7-zMean) + (z10-zMean)*(z10-zMean)) / 6.0)
string structureState = dispersion < 0.30 ? "COHERENT" : dispersion > 0.70 ? "DISPERSED" : "MIXED"

//======================================================
// 08) DUAL-HORIZON OUTCOME ENGINE
//======================================================
var array<int> boundaryStates = array.new_int(0)
var array<float> boundaryCloses = array.new_float(0)
var array<int> tacticalStates = array.new_int(0)
var array<float> tacticalReturns = array.new_float(0)
var array<int> strategicStates = array.new_int(0)
var array<float> strategicReturns = array.new_float(0)

float previousVnxClose = ta.valuewhen(vnxRawOK, vnxCloseRaw, 1)
int previousVnxWeekKey = ta.valuewhen(vnxRawOK, vnxWeekKeyRaw, 1)
int previousStressState = ta.valuewhen(vnxRawOK, stressState, 1)
bool previousSampleValid = ta.valuewhen(vnxRawOK, coreRawOK and not na(stressPct) and stressState != STATE_NA, 1)

bool newVnxWeek = chartTimeframeOK and vnxRawOK and not na(previousVnxWeekKey) and vnxWeekKeyRaw != previousVnxWeekKey
var int lastProcessedWeekKey = na
bool processWeekBoundary = newVnxWeek and (na(lastProcessedWeekKey) or vnxWeekKeyRaw != lastProcessedWeekKey)

if processWeekBoundary
    int boundaryState = previousSampleValid ? previousStressState : STATE_NA
    f_push_boundary(boundaryStates, boundaryCloses, boundaryState, previousVnxClose, STRATEGIC_HORIZON_WEEKS + 1)

    int boundarySize = array.size(boundaryCloses)
    if boundarySize >= TACTICAL_HORIZON_WEEKS + 1
        int tacticalStartIndex = boundarySize - (TACTICAL_HORIZON_WEEKS + 1)
        float tacticalStartClose = array.get(boundaryCloses, tacticalStartIndex)
        float tacticalEndClose = array.get(boundaryCloses, boundarySize - 1)
        int tacticalStartState = array.get(boundaryStates, tacticalStartIndex)
        if tacticalStartClose > 0 and tacticalEndClose > 0
            float tacticalOutcome = math.log(tacticalEndClose / tacticalStartClose)
            // STATE_NA is retained to preserve the weekly clock and episode breaks.
            f_push_limited(tacticalStates, tacticalReturns, tacticalStartState, tacticalOutcome, MAX_TACTICAL_SAMPLES)

    if boundarySize >= STRATEGIC_HORIZON_WEEKS + 1
        int strategicStartIndex = boundarySize - (STRATEGIC_HORIZON_WEEKS + 1)
        float strategicStartClose = array.get(boundaryCloses, strategicStartIndex)
        float strategicEndClose = array.get(boundaryCloses, boundarySize - 1)
        int strategicStartState = array.get(boundaryStates, strategicStartIndex)
        if strategicStartClose > 0 and strategicEndClose > 0
            float strategicOutcome = math.log(strategicEndClose / strategicStartClose)
            // STATE_NA is retained to preserve the weekly clock and episode breaks.
            f_push_limited(strategicStates, strategicReturns, strategicStartState, strategicOutcome, MAX_STRATEGIC_SAMPLES)

    lastProcessedWeekKey := vnxWeekKeyRaw

int tacticalSampleSize = array.size(tacticalReturns)
int strategicSampleSize = array.size(strategicReturns)

bool tacticalHighPower = tacticalSampleSize >= HIGH_TOTAL_WEEKS
bool tacticalStdPower = tacticalSampleSize >= STD_TOTAL_WEEKS
bool strategicHighPower = strategicSampleSize >= HIGH_TOTAL_WEEKS
bool strategicStdPower = strategicSampleSize >= STD_TOTAL_WEEKS

int tacticalDevWeeks = tacticalHighPower ? HIGH_DEV_WEEKS : STD_DEV_WEEKS
int tacticalValWeeks = tacticalHighPower ? HIGH_VAL_WEEKS : STD_VAL_WEEKS
int tacticalActiveTotal = tacticalDevWeeks + tacticalValWeeks
int tacticalDevStart = tacticalStdPower ? tacticalSampleSize - tacticalActiveTotal : 0
int tacticalValStart = tacticalStdPower ? tacticalDevStart + tacticalDevWeeks : 0

int strategicDevWeeks = strategicHighPower ? HIGH_DEV_WEEKS : STD_DEV_WEEKS
int strategicValWeeks = strategicHighPower ? HIGH_VAL_WEEKS : STD_VAL_WEEKS
int strategicActiveTotal = strategicDevWeeks + strategicValWeeks
int strategicDevStart = strategicStdPower ? strategicSampleSize - strategicActiveTotal : 0
int strategicValStart = strategicStdPower ? strategicDevStart + strategicDevWeeks : 0

int tacticalMinStateN = tacticalHighPower ? MIN_STATE_N_HIGH : MIN_STATE_N_STD
int tacticalMinEpisodeN = tacticalHighPower ? MIN_TACTICAL_EP_HIGH : MIN_TACTICAL_EP_STD
int strategicMinStateN = strategicHighPower ? MIN_STATE_N_HIGH : MIN_STATE_N_STD
int strategicMinEpisodeN = strategicHighPower ? MIN_STRATEGIC_EP_HIGH : MIN_STRATEGIC_EP_STD

string tacticalPowerLabel = tacticalHighPower ? "HIGH 104/104" : tacticalStdPower ? "STD 52/52" : "BUILDING"
string strategicPowerLabel = strategicHighPower ? "HIGH 104/104" : strategicStdPower ? "STD 52/52" : "BUILDING"

//======================================================
// 09) TACTICAL 1W STATISTICS
//======================================================
// Validation descriptive statistics.
[tValNLow, tValMeanLow, tValHitLow, _, _, _, tValDiffLow, tValTLow] = f_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_LOW)
[tValNMid, tValMeanMid, tValHitMid, _, _, _, tValDiffMid, tValTMid] = f_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_MID)
[tValNHigh, tValMeanHigh, tValHitHigh, _, _, _, tValDiffHigh, tValTHigh] = f_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_HIGH)

// Development episodes.
[tDevEpNLow, tDevEpMeanLow, tDevEpHitLow, tDevEpCompNLow, tDevEpCompMeanLow, tDevEpCompHitLow, tDevEpDiffLow, _, tDevEpTLow, tDevEpCILowLow, tDevEpCIHighLow] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalDevStart, tacticalStdPower ? tacticalDevWeeks : 0, STATE_LOW, TACTICAL_COOLDOWN_WEEKS)
[tDevEpNMid, tDevEpMeanMid, tDevEpHitMid, tDevEpCompNMid, tDevEpCompMeanMid, tDevEpCompHitMid, tDevEpDiffMid, _, tDevEpTMid, tDevEpCILowMid, tDevEpCIHighMid] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalDevStart, tacticalStdPower ? tacticalDevWeeks : 0, STATE_MID, TACTICAL_COOLDOWN_WEEKS)
[tDevEpNHigh, tDevEpMeanHigh, tDevEpHitHigh, tDevEpCompNHigh, tDevEpCompMeanHigh, tDevEpCompHitHigh, tDevEpDiffHigh, _, tDevEpTHigh, tDevEpCILowHigh, tDevEpCIHighHigh] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalDevStart, tacticalStdPower ? tacticalDevWeeks : 0, STATE_HIGH, TACTICAL_COOLDOWN_WEEKS)

// Validation episodes.
[tValEpNLow, tValEpMeanLow, tValEpHitLow, tValEpCompNLow, tValEpCompMeanLow, tValEpCompHitLow, tValEpDiffLow, _, tValEpTLow, tValEpCILowLow, tValEpCIHighLow] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_LOW, TACTICAL_COOLDOWN_WEEKS)
[tValEpNMid, tValEpMeanMid, tValEpHitMid, tValEpCompNMid, tValEpCompMeanMid, tValEpCompHitMid, tValEpDiffMid, _, tValEpTMid, tValEpCILowMid, tValEpCIHighMid] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_MID, TACTICAL_COOLDOWN_WEEKS)
[tValEpNHigh, tValEpMeanHigh, tValEpHitHigh, tValEpCompNHigh, tValEpCompMeanHigh, tValEpCompHitHigh, tValEpDiffHigh, _, tValEpTHigh, tValEpCILowHigh, tValEpCIHighHigh] = f_episode_stats_range(tacticalStates, tacticalReturns, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_HIGH, TACTICAL_COOLDOWN_WEEKS)

[_, tPersistLow] = f_same_state_transition(tacticalStates, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_LOW)
[_, tPersistMid] = f_same_state_transition(tacticalStates, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_MID)
[_, tPersistHigh] = f_same_state_transition(tacticalStates, tacticalValStart, tacticalStdPower ? tacticalValWeeks : 0, STATE_HIGH)

//======================================================
// 10) STRATEGIC 4W STATISTICS
//======================================================
[sValNLow, sValMeanLow, sValHitLow, _, _, _, sValDiffLow, sValTLow] = f_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_LOW)
[sValNMid, sValMeanMid, sValHitMid, _, _, _, sValDiffMid, sValTMid] = f_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_MID)
[sValNHigh, sValMeanHigh, sValHitHigh, _, _, _, sValDiffHigh, sValTHigh] = f_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_HIGH)

[sDevEpNLow, sDevEpMeanLow, sDevEpHitLow, sDevEpCompNLow, sDevEpCompMeanLow, sDevEpCompHitLow, sDevEpDiffLow, _, sDevEpTLow, sDevEpCILowLow, sDevEpCIHighLow] = f_episode_stats_range(strategicStates, strategicReturns, strategicDevStart, strategicStdPower ? strategicDevWeeks : 0, STATE_LOW, STRATEGIC_COOLDOWN_WEEKS)
[sDevEpNMid, sDevEpMeanMid, sDevEpHitMid, sDevEpCompNMid, sDevEpCompMeanMid, sDevEpCompHitMid, sDevEpDiffMid, _, sDevEpTMid, sDevEpCILowMid, sDevEpCIHighMid] = f_episode_stats_range(strategicStates, strategicReturns, strategicDevStart, strategicStdPower ? strategicDevWeeks : 0, STATE_MID, STRATEGIC_COOLDOWN_WEEKS)
[sDevEpNHigh, sDevEpMeanHigh, sDevEpHitHigh, sDevEpCompNHigh, sDevEpCompMeanHigh, sDevEpCompHitHigh, sDevEpDiffHigh, _, sDevEpTHigh, sDevEpCILowHigh, sDevEpCIHighHigh] = f_episode_stats_range(strategicStates, strategicReturns, strategicDevStart, strategicStdPower ? strategicDevWeeks : 0, STATE_HIGH, STRATEGIC_COOLDOWN_WEEKS)

[sValEpNLow, sValEpMeanLow, sValEpHitLow, sValEpCompNLow, sValEpCompMeanLow, sValEpCompHitLow, sValEpDiffLow, _, sValEpTLow, sValEpCILowLow, sValEpCIHighLow] = f_episode_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_LOW, STRATEGIC_COOLDOWN_WEEKS)
[sValEpNMid, sValEpMeanMid, sValEpHitMid, sValEpCompNMid, sValEpCompMeanMid, sValEpCompHitMid, sValEpDiffMid, _, sValEpTMid, sValEpCILowMid, sValEpCIHighMid] = f_episode_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_MID, STRATEGIC_COOLDOWN_WEEKS)
[sValEpNHigh, sValEpMeanHigh, sValEpHitHigh, sValEpCompNHigh, sValEpCompMeanHigh, sValEpCompHitHigh, sValEpDiffHigh, _, sValEpTHigh, sValEpCILowHigh, sValEpCIHighHigh] = f_episode_stats_range(strategicStates, strategicReturns, strategicValStart, strategicStdPower ? strategicValWeeks : 0, STATE_HIGH, STRATEGIC_COOLDOWN_WEEKS)

//======================================================
// 11) CURRENT-STATE LOOKUP — TACTICAL
//======================================================
float tValN = stressState == STATE_LOW ? tValNLow : stressState == STATE_HIGH ? tValNHigh : stressState == STATE_MID ? tValNMid : na
float tValMean = stressState == STATE_LOW ? tValMeanLow : stressState == STATE_HIGH ? tValMeanHigh : stressState == STATE_MID ? tValMeanMid : na
float tValDiff = stressState == STATE_LOW ? tValDiffLow : stressState == STATE_HIGH ? tValDiffHigh : stressState == STATE_MID ? tValDiffMid : na
float tValHit = stressState == STATE_LOW ? tValHitLow : stressState == STATE_HIGH ? tValHitHigh : stressState == STATE_MID ? tValHitMid : na
float tPersistence = stressState == STATE_LOW ? tPersistLow : stressState == STATE_HIGH ? tPersistHigh : stressState == STATE_MID ? tPersistMid : na

float tDevEpN = stressState == STATE_LOW ? tDevEpNLow : stressState == STATE_HIGH ? tDevEpNHigh : stressState == STATE_MID ? tDevEpNMid : na
float tDevEpCompN = stressState == STATE_LOW ? tDevEpCompNLow : stressState == STATE_HIGH ? tDevEpCompNHigh : stressState == STATE_MID ? tDevEpCompNMid : na
float tDevEpMean = stressState == STATE_LOW ? tDevEpMeanLow : stressState == STATE_HIGH ? tDevEpMeanHigh : stressState == STATE_MID ? tDevEpMeanMid : na
float tDevEpCompMean = stressState == STATE_LOW ? tDevEpCompMeanLow : stressState == STATE_HIGH ? tDevEpCompMeanHigh : stressState == STATE_MID ? tDevEpCompMeanMid : na
float tDevEpDiff = stressState == STATE_LOW ? tDevEpDiffLow : stressState == STATE_HIGH ? tDevEpDiffHigh : stressState == STATE_MID ? tDevEpDiffMid : na
float tDevEpHit = stressState == STATE_LOW ? tDevEpHitLow : stressState == STATE_HIGH ? tDevEpHitHigh : stressState == STATE_MID ? tDevEpHitMid : na
float tDevEpCompHit = stressState == STATE_LOW ? tDevEpCompHitLow : stressState == STATE_HIGH ? tDevEpCompHitHigh : stressState == STATE_MID ? tDevEpCompHitMid : na

float tValEpN = stressState == STATE_LOW ? tValEpNLow : stressState == STATE_HIGH ? tValEpNHigh : stressState == STATE_MID ? tValEpNMid : na
float tValEpCompN = stressState == STATE_LOW ? tValEpCompNLow : stressState == STATE_HIGH ? tValEpCompNHigh : stressState == STATE_MID ? tValEpCompNMid : na
float tValEpMean = stressState == STATE_LOW ? tValEpMeanLow : stressState == STATE_HIGH ? tValEpMeanHigh : stressState == STATE_MID ? tValEpMeanMid : na
float tValEpCompMean = stressState == STATE_LOW ? tValEpCompMeanLow : stressState == STATE_HIGH ? tValEpCompMeanHigh : stressState == STATE_MID ? tValEpCompMeanMid : na
float tValEpDiff = stressState == STATE_LOW ? tValEpDiffLow : stressState == STATE_HIGH ? tValEpDiffHigh : stressState == STATE_MID ? tValEpDiffMid : na
float tValEpT = stressState == STATE_LOW ? tValEpTLow : stressState == STATE_HIGH ? tValEpTHigh : stressState == STATE_MID ? tValEpTMid : na
float tValEpCILow = stressState == STATE_LOW ? tValEpCILowLow : stressState == STATE_HIGH ? tValEpCILowHigh : stressState == STATE_MID ? tValEpCILowMid : na
float tValEpCIHigh = stressState == STATE_LOW ? tValEpCIHighLow : stressState == STATE_HIGH ? tValEpCIHighHigh : stressState == STATE_MID ? tValEpCIHighMid : na
float tValEpHit = stressState == STATE_LOW ? tValEpHitLow : stressState == STATE_HIGH ? tValEpHitHigh : stressState == STATE_MID ? tValEpHitMid : na
float tValEpCompHit = stressState == STATE_LOW ? tValEpCompHitLow : stressState == STATE_HIGH ? tValEpCompHitHigh : stressState == STATE_MID ? tValEpCompHitMid : na
float tDownsideLift = not na(tValEpHit) and not na(tValEpCompHit) ? tValEpHit - tValEpCompHit : na

//======================================================
// 12) CURRENT-STATE LOOKUP — STRATEGIC
//======================================================
float sValN = stressState == STATE_LOW ? sValNLow : stressState == STATE_HIGH ? sValNHigh : stressState == STATE_MID ? sValNMid : na
float sValMean = stressState == STATE_LOW ? sValMeanLow : stressState == STATE_HIGH ? sValMeanHigh : stressState == STATE_MID ? sValMeanMid : na
float sValDiff = stressState == STATE_LOW ? sValDiffLow : stressState == STATE_HIGH ? sValDiffHigh : stressState == STATE_MID ? sValDiffMid : na
float sValHit = stressState == STATE_LOW ? sValHitLow : stressState == STATE_HIGH ? sValHitHigh : stressState == STATE_MID ? sValHitMid : na

float sDevEpN = stressState == STATE_LOW ? sDevEpNLow : stressState == STATE_HIGH ? sDevEpNHigh : stressState == STATE_MID ? sDevEpNMid : na
float sDevEpCompN = stressState == STATE_LOW ? sDevEpCompNLow : stressState == STATE_HIGH ? sDevEpCompNHigh : stressState == STATE_MID ? sDevEpCompNMid : na
float sDevEpMean = stressState == STATE_LOW ? sDevEpMeanLow : stressState == STATE_HIGH ? sDevEpMeanHigh : stressState == STATE_MID ? sDevEpMeanMid : na
float sDevEpCompMean = stressState == STATE_LOW ? sDevEpCompMeanLow : stressState == STATE_HIGH ? sDevEpCompMeanHigh : stressState == STATE_MID ? sDevEpCompMeanMid : na
float sDevEpDiff = stressState == STATE_LOW ? sDevEpDiffLow : stressState == STATE_HIGH ? sDevEpDiffHigh : stressState == STATE_MID ? sDevEpDiffMid : na
float sDevEpHit = stressState == STATE_LOW ? sDevEpHitLow : stressState == STATE_HIGH ? sDevEpHitHigh : stressState == STATE_MID ? sDevEpHitMid : na
float sDevEpCompHit = stressState == STATE_LOW ? sDevEpCompHitLow : stressState == STATE_HIGH ? sDevEpCompHitHigh : stressState == STATE_MID ? sDevEpCompHitMid : na

float sValEpN = stressState == STATE_LOW ? sValEpNLow : stressState == STATE_HIGH ? sValEpNHigh : stressState == STATE_MID ? sValEpNMid : na
float sValEpCompN = stressState == STATE_LOW ? sValEpCompNLow : stressState == STATE_HIGH ? sValEpCompNHigh : stressState == STATE_MID ? sValEpCompNMid : na
float sValEpMean = stressState == STATE_LOW ? sValEpMeanLow : stressState == STATE_HIGH ? sValEpMeanHigh : stressState == STATE_MID ? sValEpMeanMid : na
float sValEpCompMean = stressState == STATE_LOW ? sValEpCompMeanLow : stressState == STATE_HIGH ? sValEpCompMeanHigh : stressState == STATE_MID ? sValEpCompMeanMid : na
float sValEpDiff = stressState == STATE_LOW ? sValEpDiffLow : stressState == STATE_HIGH ? sValEpDiffHigh : stressState == STATE_MID ? sValEpDiffMid : na
float sValEpT = stressState == STATE_LOW ? sValEpTLow : stressState == STATE_HIGH ? sValEpTHigh : stressState == STATE_MID ? sValEpTMid : na
float sValEpCILow = stressState == STATE_LOW ? sValEpCILowLow : stressState == STATE_HIGH ? sValEpCILowHigh : stressState == STATE_MID ? sValEpCILowMid : na
float sValEpCIHigh = stressState == STATE_LOW ? sValEpCIHighLow : stressState == STATE_HIGH ? sValEpCIHighHigh : stressState == STATE_MID ? sValEpCIHighMid : na
float sValEpHit = stressState == STATE_LOW ? sValEpHitLow : stressState == STATE_HIGH ? sValEpHitHigh : stressState == STATE_MID ? sValEpHitMid : na
float sValEpCompHit = stressState == STATE_LOW ? sValEpCompHitLow : stressState == STATE_HIGH ? sValEpCompHitHigh : stressState == STATE_MID ? sValEpCompHitMid : na
float sDownsideLift = not na(sValEpHit) and not na(sValEpCompHit) ? sValEpHit - sValEpCompHit : na

//======================================================
// 13) HORIZON READINESS, EVIDENCE & VALIDATION
//======================================================
bool tacticalStateReady = tacticalStdPower and not na(tValN) and tValN >= tacticalMinStateN
bool strategicStateReady = strategicStdPower and not na(sValN) and sValN >= strategicMinStateN

bool tacticalEpisodeReady = tacticalStdPower and
     not na(tDevEpN) and not na(tDevEpCompN) and not na(tValEpN) and not na(tValEpCompN) and
     tDevEpN >= tacticalMinEpisodeN and tDevEpCompN >= tacticalMinEpisodeN and
     tValEpN >= tacticalMinEpisodeN and tValEpCompN >= tacticalMinEpisodeN

bool strategicEpisodeReady = strategicStdPower and
     not na(sDevEpN) and not na(sDevEpCompN) and not na(sValEpN) and not na(sValEpCompN) and
     sDevEpN >= strategicMinEpisodeN and sDevEpCompN >= strategicMinEpisodeN and
     sValEpN >= strategicMinEpisodeN and sValEpCompN >= strategicMinEpisodeN

bool tacticalSignOK = tacticalEpisodeReady and not na(tDevEpDiff) and not na(tValEpDiff) and math.sign(tDevEpDiff) == math.sign(tValEpDiff) and math.sign(tValEpDiff) != 0
bool tacticalCIOK = tacticalEpisodeReady and not na(tValEpCILow) and not na(tValEpCIHigh) and (tValEpCILow > 0 or tValEpCIHigh < 0)
bool tacticalValidated = tacticalSignOK and tacticalCIOK and not na(tValEpT) and math.abs(tValEpT) >= T_MIN_STRONG and math.abs(tValEpDiff) >= TACT_EFFECT_WEAK
bool tacticalValidatedNegative = tacticalValidated and tValEpDiff < 0
bool tacticalValidatedPositive = tacticalValidated and tValEpDiff > 0

bool strategicSignOK = strategicEpisodeReady and not na(sDevEpDiff) and not na(sValEpDiff) and math.sign(sDevEpDiff) == math.sign(sValEpDiff) and math.sign(sValEpDiff) != 0
bool strategicCIOK = strategicEpisodeReady and not na(sValEpCILow) and not na(sValEpCIHigh) and (sValEpCILow > 0 or sValEpCIHigh < 0)
bool strategicValidated = strategicSignOK and strategicCIOK and not na(sValEpT) and math.abs(sValEpT) >= T_MIN_STRONG and math.abs(sValEpDiff) >= STRAT_EFFECT_WEAK
bool strategicValidatedNegative = strategicValidated and sValEpDiff < 0
bool strategicValidatedPositive = strategicValidated and sValEpDiff > 0

bool tacticalOperational = chartTimeframeOK and dataReady and tacticalStdPower and stressState != STATE_NA
bool strategicOperational = chartTimeframeOK and dataReady and strategicStdPower and stressState != STATE_NA
bool modelOperational = tacticalOperational or strategicOperational

float tacticalReadinessHistory = math.min(35.0, 35.0 * tacticalSampleSize / STD_TOTAL_WEEKS)
float strategicReadinessHistory = math.min(35.0, 35.0 * strategicSampleSize / STD_TOTAL_WEEKS)
float readinessDataPoints = dataReady ? math.min(50.0, 50.0 * math.min(covCurve, covVnx) / 0.95) : 0.0
float readinessFreshPoints = coreFresh and vnxFresh ? 15.0 : 0.0
float tacticalReadiness = readinessDataPoints + tacticalReadinessHistory + readinessFreshPoints
float strategicReadiness = readinessDataPoints + strategicReadinessHistory + readinessFreshPoints

float tacticalEvidence = f_evidence_score(tacticalEpisodeReady, tacticalSignOK, tacticalCIOK, tValEpDiff, tValEpT, tDownsideLift, TACT_EFFECT_STRONG, tacticalMinEpisodeN, tDevEpN, tDevEpCompN, tValEpN, tValEpCompN)
float strategicEvidence = f_evidence_score(strategicEpisodeReady, strategicSignOK, strategicCIOK, sValEpDiff, sValEpT, sDownsideLift, STRAT_EFFECT_STRONG, strategicMinEpisodeN, sDevEpN, sDevEpCompN, sValEpN, sValEpCompN)

string tacticalStatus = f_state_validation_status(tacticalStdPower, tacticalEpisodeReady, tDevEpDiff, tValEpDiff, tValEpCILow, tValEpCIHigh, tValEpT, TACT_EFFECT_WEAK)
string strategicStatus = f_state_validation_status(strategicStdPower, strategicEpisodeReady, sDevEpDiff, sValEpDiff, sValEpCILow, sValEpCIHigh, sValEpT, STRAT_EFFECT_WEAK)

int tacticalDecision = f_horizon_decision(tacticalOperational, tacticalValidatedNegative, tacticalValidatedPositive, tValEpDiff, tDownsideLift, tacticalEvidence, TACT_EFFECT_WEAK, TACT_EFFECT_STRONG)
int strategicDecision = f_horizon_decision(strategicOperational, strategicValidatedNegative, strategicValidatedPositive, sValEpDiff, sDownsideLift, strategicEvidence, STRAT_EFFECT_WEAK, STRAT_EFFECT_STRONG)

string tacticalBias = f_decision_name(tacticalDecision)
string strategicBias = f_decision_name(strategicDecision)

int combinedDecision = DEC_NO_SIGNAL
if modelOperational
    bool oppositeDirections = (
         ((tacticalDecision == DEC_DEFENSIVE or tacticalDecision == DEC_CAUTIOUS) and strategicDecision == DEC_CONSTRUCTIVE) or
         (tacticalDecision == DEC_CONSTRUCTIVE and (strategicDecision == DEC_DEFENSIVE or strategicDecision == DEC_CAUTIOUS))
    )
    if oppositeDirections
        combinedDecision := DEC_MIXED
    else if strategicDecision == DEC_DEFENSIVE
        combinedDecision := DEC_DEFENSIVE
    else if strategicDecision == DEC_CAUTIOUS
        combinedDecision := DEC_CAUTIOUS
    else if tacticalDecision == DEC_DEFENSIVE
        combinedDecision := DEC_CAUTIOUS
    else if tacticalDecision == DEC_CAUTIOUS
        combinedDecision := DEC_CAUTIOUS
    else if strategicDecision == DEC_CONSTRUCTIVE
        combinedDecision := DEC_CONSTRUCTIVE
    else if tacticalDecision == DEC_CONSTRUCTIVE and not strategicOperational
        combinedDecision := DEC_CONSTRUCTIVE
    else
        combinedDecision := DEC_NEUTRAL

string combinedName = f_decision_name(combinedDecision)
string tacticalDisplay = confirmedBar ? tacticalBias : "PROVISIONAL: " + tacticalBias
string strategicDisplay = confirmedBar ? strategicBias : "PROVISIONAL: " + strategicBias
string combinedDisplay = confirmedBar ? combinedName : "PROVISIONAL: " + combinedName

//======================================================
// 14) ALERTS — CONFIRMED DAILY BAR ONLY
//======================================================
bool newCombinedDefensive = confirmedBar and modelOperational and combinedDecision == DEC_DEFENSIVE and combinedDecision[1] != DEC_DEFENSIVE
bool newCombinedCautious = confirmedBar and modelOperational and combinedDecision == DEC_CAUTIOUS and combinedDecision[1] != DEC_CAUTIOUS
bool newCombinedConstructive = confirmedBar and modelOperational and combinedDecision == DEC_CONSTRUCTIVE and combinedDecision[1] != DEC_CONSTRUCTIVE

alertcondition(newCombinedDefensive, "V2.3 Combined Defensive", "VN YieldCurveLab v2.3.0: confirmed combined DEFENSIVE stance")
alertcondition(newCombinedCautious, "V2.3 Combined Cautious", "VN YieldCurveLab v2.3.0: confirmed combined CAUTIOUS stance")
alertcondition(newCombinedConstructive, "V2.3 Combined Constructive", "VN YieldCurveLab v2.3.0: confirmed combined CONSTRUCTIVE stance")

//======================================================
// 15) PLOTS
//======================================================
plot(y2Display, "VN02Y", color.new(color.blue, 0), 2)
plot(y5Display, "VN05Y", color.new(color.green, 0), 2)
plot(y10Display, "VN10Y", color.new(color.red, 0), 2)
plot(y1Display, "VN01Y", color.new(color.gray, 62), 1)
plot(y3Display, "VN03Y", color.new(color.orange, 58), 1)
plot(y7Display, "VN07Y", color.new(color.purple, 58), 1)
plot(ibDisplay, "VNINBR", color.new(color.yellow, 0), 1)
plot(prDisplay, "VNINTR", color.new(color.teal, 0), 1)

float ycMin = math.min(math.min(math.min(y1Display, y2Display), math.min(y3Display, y5Display)), math.min(y7Display, y10Display))
float ycMax = math.max(math.max(math.max(y1Display, y2Display), math.max(y3Display, y5Display)), math.max(y7Display, y10Display))
float rollingMin = ta.lowest(ycMin, LEN_STATS)
float rollingMax = ta.highest(ycMax, LEN_STATS)
float rollingRange = rollingMax - rollingMin
float stressMapped = rollingMin + stressPct / 100.0 * (rollingRange > 0 ? rollingRange : 1.0)
plot(stressMapped, "Curve Stress PCTL (mapped)", color.new(color.white, 35), 2)

//======================================================
// 16) TABLES
//======================================================
var table stateTable = na
var table tacticalTable = na
var table strategicTable = na
var table diagnosticTable = na

color bgTitle = color.new(color.black, 8)
color bgHead = color.new(color.black, 24)
color bgA = color.new(color.black, 16)
color bgB = color.new(color.black, 27)
color frameColor = color.new(color.black, 0)
color textColor = color.white

f_cell(table tableId, int column, int row, string cellText, color background, string horizontal, string textSize) =>
    table.cell(tableId, column, row, cellText, bgcolor = background, text_color = textColor, text_halign = horizontal, text_size = textSize)

if barstate.islast
    // P1 — STATE & HORIZON SUMMARY
    if showP1
        if na(stateTable)
            stateTable := table.new(position.top_left, 4, 17, frame_width = 2, frame_color = frameColor)

        f_cell(stateTable, 0, 0, "P1 | V2.3 MACRO + DUAL HORIZON", bgTitle, text.align_left, size.small)
        for i = 1 to 3
            f_cell(stateTable, i, 0, "", bgTitle, text.align_left, size.small)

        f_cell(stateTable, 0, 1, "ITEM", bgHead, text.align_left, size.tiny)
        f_cell(stateTable, 1, 1, "VALUE", bgHead, text.align_right, size.tiny)
        f_cell(stateTable, 2, 1, "RANK / STATUS", bgHead, text.align_right, size.tiny)
        f_cell(stateTable, 3, 1, "INTERPRETATION", bgHead, text.align_left, size.tiny)

        f_cell(stateTable, 0, 2, "LEVEL", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 2, f_num(level, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 2, 2, f_pct1(levelPct), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 3, 2, levelReg, f_bg_tag(levelReg), text.align_left, size.tiny)

        f_cell(stateTable, 0, 3, "SLOPE 10Y-2Y", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 3, f_num(slope, "#.00"), bgB, text.align_right, size.tiny)
        f_cell(stateTable, 2, 3, f_pct1(slopePct), bgB, text.align_right, size.tiny)
        f_cell(stateTable, 3, 3, slopeReg, f_bg_tag(slopeReg), text.align_left, size.tiny)

        f_cell(stateTable, 0, 4, "CURVATURE", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 4, f_num(curvature, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 2, 4, f_pct1(curvePct), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 3, 4, structureState, bgA, text.align_left, size.tiny)

        f_cell(stateTable, 0, 5, "YC REGIME", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 5, ycCode, f_bg_tag(ycCode), text.align_right, size.tiny)
        f_cell(stateTable, 2, 5, "", bgB, text.align_right, size.tiny)
        f_cell(stateTable, 3, 5, ycLabel, bgB, text.align_left, size.tiny)

        f_cell(stateTable, 0, 6, "CURVE STRESS", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 6, f_num(curveStress, "#.1"), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 2, 6, f_pct1(stressPct), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 3, 6, f_state_name(stressState), f_bg_tag(f_state_name(stressState)), text.align_left, size.tiny)

        f_cell(stateTable, 0, 7, "LIQUIDITY GAP", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 7, f_num(liquidityGap, "#.00"), bgB, text.align_right, size.tiny)
        f_cell(stateTable, 2, 7, f_pct1(liquidityGapPct), bgB, text.align_right, size.tiny)
        f_cell(stateTable, 3, 7, liquidityState, bgB, text.align_left, size.tiny)

        f_cell(stateTable, 0, 8, "MODEL DATAQ", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 8, dataLabel, f_bg_tag(dataLabel), text.align_right, size.tiny)
        f_cell(stateTable, 2, 8, "C/V/F/L " + f_num(covCurve * 100.0, "#.0") + "/" + f_num(covVnx * 100.0, "#.0") + "/" + f_num(covFull * 100.0, "#.0") + "/" + f_num(covLiquidity * 100.0, "#.0"), bgA, text.align_right, size.tiny)
        f_cell(stateTable, 3, 8, coreFresh and vnxFresh ? "FRESH" : "STALE", coreFresh and vnxFresh ? color.new(color.lime, 78) : color.new(color.red, 72), text.align_left, size.tiny)

        string engineStatus = not chartTimeframeOK ? "USE A 1D CHART" : not dataReady ? "DATA GATE FAIL" : tacticalStdPower or strategicStdPower ? "ENGINE READY" : "BUILDING HISTORY"
        f_cell(stateTable, 0, 9, "SAMPLE POWER", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 9, engineStatus, modelOperational ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)
        f_cell(stateTable, 2, 9, "T " + str.tostring(tacticalSampleSize) + "/" + str.tostring(HIGH_TOTAL_WEEKS), bgB, text.align_right, size.tiny)
        f_cell(stateTable, 3, 9, "S " + str.tostring(strategicSampleSize) + "/" + str.tostring(HIGH_TOTAL_WEEKS), bgB, text.align_left, size.tiny)

        f_cell(stateTable, 0, 10, "TACTICAL POWER", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 10, tacticalPowerLabel, tacticalStdPower ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)
        f_cell(stateTable, 2, 10, "READY " + f_num(tacticalReadiness, "#"), f_readiness_bg(tacticalReadiness), text.align_right, size.tiny)
        f_cell(stateTable, 3, 10, "1W non-overlap", bgA, text.align_left, size.tiny)

        f_cell(stateTable, 0, 11, "TACTICAL EVIDENCE", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 11, f_num(tacticalEvidence, "#") + "/100", f_evidence_bg(tacticalEvidence), text.align_right, size.tiny)
        f_cell(stateTable, 2, 11, tacticalStatus, f_validation_bg(tacticalStatus), text.align_right, size.tiny)
        f_cell(stateTable, 3, 11, tacticalDisplay, f_bg_tag(tacticalBias), text.align_left, size.tiny)

        f_cell(stateTable, 0, 12, "STRATEGIC POWER", bgA, text.align_left, size.tiny)
        f_cell(stateTable, 1, 12, strategicPowerLabel, strategicStdPower ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)
        f_cell(stateTable, 2, 12, "READY " + f_num(strategicReadiness, "#"), f_readiness_bg(strategicReadiness), text.align_right, size.tiny)
        f_cell(stateTable, 3, 12, "4W exact horizon", bgA, text.align_left, size.tiny)

        f_cell(stateTable, 0, 13, "STRATEGIC EVIDENCE", bgB, text.align_left, size.tiny)
        f_cell(stateTable, 1, 13, f_num(strategicEvidence, "#") + "/100", f_evidence_bg(strategicEvidence), text.align_right, size.tiny)
        f_cell(stateTable, 2, 13, strategicStatus, f_validation_bg(strategicStatus), text.align_right, size.tiny)
        f_cell(stateTable, 3, 13, strategicDisplay, f_bg_tag(strategicBias), text.align_left, size.tiny)

        f_cell(stateTable, 0, 15, "COMBINED STANCE", bgTitle, text.align_left, size.small)
        f_cell(stateTable, 1, 15, combinedDisplay, f_bg_tag(combinedName), text.align_right, size.small)
        f_cell(stateTable, 2, 15, confirmedBar ? "EOD CONFIRMED" : "DAILY BAR OPEN", confirmedBar ? color.new(color.lime, 80) : color.new(color.orange, 70), text.align_right, size.tiny)
        f_cell(stateTable, 3, 15, "Strategic dominates; mixed horizons disclosed", bgTitle, text.align_left, size.tiny)

        f_cell(stateTable, 0, 16, "NOTICE", bgTitle, text.align_left, size.tiny)
        f_cell(stateTable, 1, 16, "Readiness ≠ evidence", bgTitle, text.align_right, size.tiny)
        f_cell(stateTable, 2, 16, "Adaptive 52/52 → 104/104", bgTitle, text.align_right, size.tiny)
        f_cell(stateTable, 3, 16, "Decision support; not causal", bgTitle, text.align_left, size.tiny)
    else
        if not na(stateTable)
            table.delete(stateTable)
            stateTable := na

    // P2 — TACTICAL 1W EVIDENCE
    if showP2
        if na(tacticalTable)
            tacticalTable := table.new(position.top_right, 4, 18, frame_width = 2, frame_color = frameColor)

        f_cell(tacticalTable, 0, 0, "P2 | TACTICAL 1W VALIDATION", bgTitle, text.align_left, size.small)
        for i = 1 to 3
            f_cell(tacticalTable, i, 0, "", bgTitle, text.align_left, size.small)

        f_cell(tacticalTable, 0, 1, "CURRENT STATE", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 1, f_state_name(stressState), f_bg_tag(f_state_name(stressState)), text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 1, tacticalPowerLabel, tacticalStdPower ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 1, "EVID " + f_num(tacticalEvidence, "#"), f_evidence_bg(tacticalEvidence), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 3, "DEVELOPMENT EPISODES", bgHead, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 3, "STATE", bgHead, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 3, "COMPLEMENT", bgHead, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 3, "DIFF", bgHead, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 4, "N", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 4, f_num(tDevEpN, "#"), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 4, f_num(tDevEpCompN, "#"), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 4, tacticalSignOK ? "SIGN PASS" : tacticalEpisodeReady ? "SIGN FAIL" : "EP N LOW", tacticalSignOK ? color.new(color.lime, 78) : tacticalEpisodeReady ? color.new(color.red, 72) : color.new(color.orange, 72), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 5, "MEAN", bgB, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 5, f_pct2(f_log_to_pct(tDevEpMean)), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 5, f_pct2(f_log_to_pct(tDevEpCompMean)), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 5, f_pct2(f_log_to_pct(tDevEpDiff)), bgB, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 6, "HIT DOWN", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 6, f_pct1(tDevEpHit), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 6, f_pct1(tDevEpCompHit), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 6, (tDevEpHit - tDevEpCompHit >= 0 ? "+" : "") + f_num(tDevEpHit - tDevEpCompHit, "#.1") + "pp", f_hit_bg(tDevEpHit - tDevEpCompHit), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 8, "VALIDATION EPISODES", bgHead, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 8, "STATE", bgHead, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 8, "COMPLEMENT", bgHead, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 8, "DIFF / t", bgHead, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 9, "N", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 9, f_num(tValEpN, "#"), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 9, f_num(tValEpCompN, "#"), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 9, "t " + f_num(tValEpT, "#.00"), bgA, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 10, "MEAN", bgB, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 10, f_pct2(f_log_to_pct(tValEpMean)), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 10, f_pct2(f_log_to_pct(tValEpCompMean)), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 10, f_pct2(f_log_to_pct(tValEpDiff)), bgB, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 11, "95% CI DIFF", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 11, f_pct2(f_log_to_pct(tValEpCILow)), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 11, f_pct2(f_log_to_pct(tValEpCIHigh)), bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 11, tacticalCIOK ? "EXCLUDES 0" : "CONTAINS 0", tacticalCIOK ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 12, "HIT DOWN", bgB, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 12, f_pct1(tValEpHit), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 12, f_pct1(tValEpCompHit), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 12, (tDownsideLift >= 0 ? "+" : "") + f_num(tDownsideLift, "#.1") + "pp", f_hit_bg(tDownsideLift), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 13, "DIRECTION", bgA, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 13, tacticalStatus, f_validation_bg(tacticalStatus), text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 13, "1W COOLDOWN", bgA, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 13, tacticalValidated ? "HARD GATE PASS" : "HARD GATE FAIL", tacticalValidated ? color.new(color.lime, 78) : color.new(color.red, 72), text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 14, "DESCRIPTIVE", bgB, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 14, "N " + f_num(tValN, "#"), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 14, f_pct2(f_log_to_pct(tValMean)), bgB, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 14, "Persist " + f_pct1(tPersistence), bgB, text.align_right, size.tiny)

        f_cell(tacticalTable, 0, 16, "TACTICAL BIAS", bgTitle, text.align_left, size.small)
        f_cell(tacticalTable, 1, 16, tacticalDisplay, f_bg_tag(tacticalBias), text.align_right, size.small)
        f_cell(tacticalTable, 2, 16, f_num(tacticalEvidence, "#") + "/100", f_evidence_bg(tacticalEvidence), text.align_right, size.small)
        f_cell(tacticalTable, 3, 16, confirmedBar ? "CONFIRMED" : "PROVISIONAL", confirmedBar ? color.new(color.lime, 80) : color.new(color.orange, 70), text.align_right, size.small)

        f_cell(tacticalTable, 0, 17, "METHOD", bgTitle, text.align_left, size.tiny)
        f_cell(tacticalTable, 1, 17, "1W non-overlap", bgTitle, text.align_right, size.tiny)
        f_cell(tacticalTable, 2, 17, tacticalPowerLabel, bgTitle, text.align_right, size.tiny)
        f_cell(tacticalTable, 3, 17, "Entry episodes", bgTitle, text.align_right, size.tiny)
    else
        if not na(tacticalTable)
            table.delete(tacticalTable)
            tacticalTable := na

    // P3 — STRATEGIC 4W EVIDENCE
    if showP3
        if na(strategicTable)
            strategicTable := table.new(position.top_right, 4, 18, frame_width = 2, frame_color = frameColor)

        f_cell(strategicTable, 0, 0, "P3 | STRATEGIC 4W VALIDATION", bgTitle, text.align_left, size.small)
        for i = 1 to 3
            f_cell(strategicTable, i, 0, "", bgTitle, text.align_left, size.small)

        f_cell(strategicTable, 0, 1, "CURRENT STATE", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 1, f_state_name(stressState), f_bg_tag(f_state_name(stressState)), text.align_right, size.tiny)
        f_cell(strategicTable, 2, 1, strategicPowerLabel, strategicStdPower ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)
        f_cell(strategicTable, 3, 1, "EVID " + f_num(strategicEvidence, "#"), f_evidence_bg(strategicEvidence), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 3, "DEVELOPMENT EPISODES", bgHead, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 3, "STATE", bgHead, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 3, "COMPLEMENT", bgHead, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 3, "DIFF", bgHead, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 4, "N", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 4, f_num(sDevEpN, "#"), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 4, f_num(sDevEpCompN, "#"), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 4, strategicSignOK ? "SIGN PASS" : strategicEpisodeReady ? "SIGN FAIL" : "EP N LOW", strategicSignOK ? color.new(color.lime, 78) : strategicEpisodeReady ? color.new(color.red, 72) : color.new(color.orange, 72), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 5, "MEAN", bgB, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 5, f_pct2(f_log_to_pct(sDevEpMean)), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 5, f_pct2(f_log_to_pct(sDevEpCompMean)), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 5, f_pct2(f_log_to_pct(sDevEpDiff)), bgB, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 6, "HIT DOWN", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 6, f_pct1(sDevEpHit), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 6, f_pct1(sDevEpCompHit), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 6, (sDevEpHit - sDevEpCompHit >= 0 ? "+" : "") + f_num(sDevEpHit - sDevEpCompHit, "#.1") + "pp", f_hit_bg(sDevEpHit - sDevEpCompHit), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 8, "VALIDATION EPISODES", bgHead, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 8, "STATE", bgHead, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 8, "COMPLEMENT", bgHead, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 8, "DIFF / t", bgHead, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 9, "N", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 9, f_num(sValEpN, "#"), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 9, f_num(sValEpCompN, "#"), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 9, "t " + f_num(sValEpT, "#.00"), bgA, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 10, "MEAN", bgB, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 10, f_pct2(f_log_to_pct(sValEpMean)), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 10, f_pct2(f_log_to_pct(sValEpCompMean)), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 10, f_pct2(f_log_to_pct(sValEpDiff)), bgB, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 11, "95% CI DIFF", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 11, f_pct2(f_log_to_pct(sValEpCILow)), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 11, f_pct2(f_log_to_pct(sValEpCIHigh)), bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 11, strategicCIOK ? "EXCLUDES 0" : "CONTAINS 0", strategicCIOK ? color.new(color.lime, 78) : color.new(color.orange, 72), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 12, "HIT DOWN", bgB, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 12, f_pct1(sValEpHit), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 12, f_pct1(sValEpCompHit), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 12, (sDownsideLift >= 0 ? "+" : "") + f_num(sDownsideLift, "#.1") + "pp", f_hit_bg(sDownsideLift), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 13, "DIRECTION", bgA, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 13, strategicStatus, f_validation_bg(strategicStatus), text.align_right, size.tiny)
        f_cell(strategicTable, 2, 13, "4W COOLDOWN", bgA, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 13, strategicValidated ? "HARD GATE PASS" : "HARD GATE FAIL", strategicValidated ? color.new(color.lime, 78) : color.new(color.red, 72), text.align_right, size.tiny)

        f_cell(strategicTable, 0, 14, "DESCRIPTIVE", bgB, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 14, "N " + f_num(sValN, "#"), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 14, f_pct2(f_log_to_pct(sValMean)), bgB, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 14, f_pct2(f_log_to_pct(sValDiff)), bgB, text.align_right, size.tiny)

        f_cell(strategicTable, 0, 16, "STRATEGIC BIAS", bgTitle, text.align_left, size.small)
        f_cell(strategicTable, 1, 16, strategicDisplay, f_bg_tag(strategicBias), text.align_right, size.small)
        f_cell(strategicTable, 2, 16, f_num(strategicEvidence, "#") + "/100", f_evidence_bg(strategicEvidence), text.align_right, size.small)
        f_cell(strategicTable, 3, 16, confirmedBar ? "CONFIRMED" : "PROVISIONAL", confirmedBar ? color.new(color.lime, 80) : color.new(color.orange, 70), text.align_right, size.small)

        f_cell(strategicTable, 0, 17, "METHOD", bgTitle, text.align_left, size.tiny)
        f_cell(strategicTable, 1, 17, "Exact 4W return", bgTitle, text.align_right, size.tiny)
        f_cell(strategicTable, 2, 17, strategicPowerLabel, bgTitle, text.align_right, size.tiny)
        f_cell(strategicTable, 3, 17, "4W cooldown", bgTitle, text.align_right, size.tiny)
    else
        if not na(strategicTable)
            table.delete(strategicTable)
            strategicTable := na

    // P4 — CROSS-HORIZON DIAGNOSTICS
    if showP4
        if na(diagnosticTable)
            diagnosticTable := table.new(position.top_right, 6, 24, frame_width = 2, frame_color = frameColor)

        f_cell(diagnosticTable, 0, 0, "P4 | HORIZON + POWER DIAGNOSTICS", bgTitle, text.align_left, size.small)
        for i = 1 to 5
            f_cell(diagnosticTable, i, 0, "", bgTitle, text.align_left, size.small)

        f_cell(diagnosticTable, 0, 1, "TACTICAL VALIDATION", bgHead, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 1, "N", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 1, "DIFF", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 1, "t", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 1, "STATUS", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 1, "MEAN", bgHead, text.align_right, size.tiny)

        bool tReadyLow = tacticalStdPower and tDevEpNLow >= tacticalMinEpisodeN and tDevEpCompNLow >= tacticalMinEpisodeN and tValEpNLow >= tacticalMinEpisodeN and tValEpCompNLow >= tacticalMinEpisodeN
        bool tReadyMid = tacticalStdPower and tDevEpNMid >= tacticalMinEpisodeN and tDevEpCompNMid >= tacticalMinEpisodeN and tValEpNMid >= tacticalMinEpisodeN and tValEpCompNMid >= tacticalMinEpisodeN
        bool tReadyHigh = tacticalStdPower and tDevEpNHigh >= tacticalMinEpisodeN and tDevEpCompNHigh >= tacticalMinEpisodeN and tValEpNHigh >= tacticalMinEpisodeN and tValEpCompNHigh >= tacticalMinEpisodeN
        string tStatusLow = f_state_validation_status(tacticalStdPower, tReadyLow, tDevEpDiffLow, tValEpDiffLow, tValEpCILowLow, tValEpCIHighLow, tValEpTLow, TACT_EFFECT_WEAK)
        string tStatusMid = f_state_validation_status(tacticalStdPower, tReadyMid, tDevEpDiffMid, tValEpDiffMid, tValEpCILowMid, tValEpCIHighMid, tValEpTMid, TACT_EFFECT_WEAK)
        string tStatusHigh = f_state_validation_status(tacticalStdPower, tReadyHigh, tDevEpDiffHigh, tValEpDiffHigh, tValEpCILowHigh, tValEpCIHighHigh, tValEpTHigh, TACT_EFFECT_WEAK)

        f_cell(diagnosticTable, 0, 2, "LOW", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 2, f_num(tValEpNLow, "#") + "/" + f_num(tValEpCompNLow, "#"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 2, f_pct2(f_log_to_pct(tValEpDiffLow)), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 2, f_num(tValEpTLow, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 2, tStatusLow, f_validation_bg(tStatusLow), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 2, f_pct2(f_log_to_pct(tValMeanLow)), bgA, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 3, "MID", bgB, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 3, f_num(tValEpNMid, "#") + "/" + f_num(tValEpCompNMid, "#"), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 3, f_pct2(f_log_to_pct(tValEpDiffMid)), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 3, f_num(tValEpTMid, "#.00"), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 3, tStatusMid, f_validation_bg(tStatusMid), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 3, f_pct2(f_log_to_pct(tValMeanMid)), bgB, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 4, "HIGH", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 4, f_num(tValEpNHigh, "#") + "/" + f_num(tValEpCompNHigh, "#"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 4, f_pct2(f_log_to_pct(tValEpDiffHigh)), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 4, f_num(tValEpTHigh, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 4, tStatusHigh, f_validation_bg(tStatusHigh), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 4, f_pct2(f_log_to_pct(tValMeanHigh)), bgA, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 6, "STRATEGIC VALIDATION", bgHead, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 6, "N", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 6, "DIFF", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 6, "t", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 6, "STATUS", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 6, "MEAN", bgHead, text.align_right, size.tiny)

        bool sReadyLow = strategicStdPower and sDevEpNLow >= strategicMinEpisodeN and sDevEpCompNLow >= strategicMinEpisodeN and sValEpNLow >= strategicMinEpisodeN and sValEpCompNLow >= strategicMinEpisodeN
        bool sReadyMid = strategicStdPower and sDevEpNMid >= strategicMinEpisodeN and sDevEpCompNMid >= strategicMinEpisodeN and sValEpNMid >= strategicMinEpisodeN and sValEpCompNMid >= strategicMinEpisodeN
        bool sReadyHigh = strategicStdPower and sDevEpNHigh >= strategicMinEpisodeN and sDevEpCompNHigh >= strategicMinEpisodeN and sValEpNHigh >= strategicMinEpisodeN and sValEpCompNHigh >= strategicMinEpisodeN
        string sStatusLow = f_state_validation_status(strategicStdPower, sReadyLow, sDevEpDiffLow, sValEpDiffLow, sValEpCILowLow, sValEpCIHighLow, sValEpTLow, STRAT_EFFECT_WEAK)
        string sStatusMid = f_state_validation_status(strategicStdPower, sReadyMid, sDevEpDiffMid, sValEpDiffMid, sValEpCILowMid, sValEpCIHighMid, sValEpTMid, STRAT_EFFECT_WEAK)
        string sStatusHigh = f_state_validation_status(strategicStdPower, sReadyHigh, sDevEpDiffHigh, sValEpDiffHigh, sValEpCILowHigh, sValEpCIHighHigh, sValEpTHigh, STRAT_EFFECT_WEAK)

        f_cell(diagnosticTable, 0, 7, "LOW", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 7, f_num(sValEpNLow, "#") + "/" + f_num(sValEpCompNLow, "#"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 7, f_pct2(f_log_to_pct(sValEpDiffLow)), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 7, f_num(sValEpTLow, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 7, sStatusLow, f_validation_bg(sStatusLow), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 7, f_pct2(f_log_to_pct(sValMeanLow)), bgA, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 8, "MID", bgB, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 8, f_num(sValEpNMid, "#") + "/" + f_num(sValEpCompNMid, "#"), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 8, f_pct2(f_log_to_pct(sValEpDiffMid)), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 8, f_num(sValEpTMid, "#.00"), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 8, sStatusMid, f_validation_bg(sStatusMid), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 8, f_pct2(f_log_to_pct(sValMeanMid)), bgB, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 9, "HIGH", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 9, f_num(sValEpNHigh, "#") + "/" + f_num(sValEpCompNHigh, "#"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 9, f_pct2(f_log_to_pct(sValEpDiffHigh)), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 9, f_num(sValEpTHigh, "#.00"), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 9, sStatusHigh, f_validation_bg(sStatusHigh), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 9, f_pct2(f_log_to_pct(sValMeanHigh)), bgA, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 11, "HORIZON SUMMARY", bgHead, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 11, "POWER", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 11, "SAMPLES", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 11, "EVID", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 11, "BIAS", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 11, "STATUS", bgHead, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 12, "TACTICAL 1W", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 12, tacticalPowerLabel, bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 12, str.tostring(tacticalSampleSize), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 12, f_num(tacticalEvidence, "#"), f_evidence_bg(tacticalEvidence), text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 12, tacticalBias, f_bg_tag(tacticalBias), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 12, tacticalStatus, f_validation_bg(tacticalStatus), text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 13, "STRATEGIC 4W", bgB, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 13, strategicPowerLabel, bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 13, str.tostring(strategicSampleSize), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 13, f_num(strategicEvidence, "#"), f_evidence_bg(strategicEvidence), text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 13, strategicBias, f_bg_tag(strategicBias), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 13, strategicStatus, f_validation_bg(strategicStatus), text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 15, "DATA", bgHead, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 15, "CORE", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 15, "VNINDEX", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 15, "FULL", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 15, "LIQ", bgHead, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 15, "FRESH", bgHead, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 16, "COVERAGE", bgA, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 16, f_pct1(covCurve * 100.0), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 16, f_pct1(covVnx * 100.0), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 16, f_pct1(covFull * 100.0), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 16, f_pct1(covLiquidity * 100.0), bgA, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 16, coreFresh and vnxFresh ? "YES" : "NO", coreFresh and vnxFresh ? color.new(color.lime, 78) : color.new(color.red, 72), text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 18, "STRUCTURE", bgB, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 18, structureState, bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 18, "Disp " + f_num(dispersion, "#.00"), bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 18, liquidityState, bgB, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 18, ycCode, f_bg_tag(ycCode), text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 18, f_state_name(stressState), f_bg_tag(f_state_name(stressState)), text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 20, "METHOD", bgTitle, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 20, "1W tactical", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 20, "4W strategic", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 20, "Episode aware", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 20, "CI + sign gate", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 20, "Adaptive power", bgTitle, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 22, "COMBINED", bgTitle, text.align_left, size.small)
        f_cell(diagnosticTable, 1, 22, combinedDisplay, f_bg_tag(combinedName), text.align_right, size.small)
        f_cell(diagnosticTable, 2, 22, "T " + tacticalBias, f_bg_tag(tacticalBias), text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 22, "S " + strategicBias, f_bg_tag(strategicBias), text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 22, confirmedBar ? "CONFIRMED" : "PROVISIONAL", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 22, "Not probability", bgTitle, text.align_right, size.tiny)

        f_cell(diagnosticTable, 0, 23, "NOTICE", bgTitle, text.align_left, size.tiny)
        f_cell(diagnosticTable, 1, 23, "Readiness ≠ evidence", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 2, 23, "Strategic dominates", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 3, 23, "4W overlaps blocked", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 4, 23, "52/52 then 104/104", bgTitle, text.align_right, size.tiny)
        f_cell(diagnosticTable, 5, 23, "Research Beta", bgTitle, text.align_right, size.tiny)
    else
        if not na(diagnosticTable)
            table.delete(diagnosticTable)
            diagnosticTable := na
