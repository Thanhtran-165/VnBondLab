//@version=5
indicator("VN YieldCurveLab v1.7.0 — Academic Defaults (STRICT: AR-AdjN + Partial Corr + BestLag Discipline)",
     shorttitle="VN YieldCurveLab 1.7",
     overlay=false,
     max_labels_count=500,
     max_lines_count=500,
     max_bars_back=5000,
     precision=4)

//======================================================
// 0) INPUT (ONLY PANEL)
//======================================================
panel_view = input.int(1, "Panel (1=Shape, 2=Grid, 3=Research)", minval=1, maxval=3)
show_p1 = panel_view == 1
show_p2 = panel_view == 2
show_p3 = panel_view == 3

//======================================================
// 1) ACADEMIC DEFAULTS (STRICT, HARD-CODED)
//======================================================
string TF_DATA = "D"

// Windows
int   LEN_STATS    = 252
int   LEN_RESEARCH = 252
int   LEN_HALF     = 126
int   LEN_STAB     = 60

// Robustness
float CLIP_Z       = 2.5
float RET_CLIP_SD  = 3.0

// Research gates
float MIN_EFF_RATIO = 0.80      // strict sample adequacy
float COV_MED       = 0.85
float COV_HIGH      = 0.95

// BestLag discipline (k=3 fixed lags)
int   LAG1 = 1
int   LAG2 = 5
int   LAG3 = 20
float R_ACCEPT   = 0.20
float MARGIN_MIN = 0.05
float T_CRIT     = 2.4
float R_HALF_MIN = 0.15

// Stress percentile thresholds (strict)
float STRESS_LOW_PCTL  = 20.0
float STRESS_HIGH_PCTL = 80.0

// Event tagging (moderate, strict gating)
bool  SHOW_EVENTS    = true
int   EVENT_MIN_GAP  = 20
int   EVENT_XOFF     = 2
float EVENT_YPAD_PCT = 2.0

// Symbols (hard defaults)
string SYM_1Y  = "TVC:VN01Y"
string SYM_2Y  = "TVC:VN02Y"
string SYM_3Y  = "TVC:VN03Y"
string SYM_5Y  = "TVC:VN05Y"
string SYM_7Y  = "TVC:VN07Y"
string SYM_10Y = "TVC:VN10Y"
string SYM_IB  = "VNINBR"
string SYM_PR  = "VNINTR"
string SYM_VNX = "HOSE:VNINDEX"

//======================================================
// 2) HELPERS
//======================================================
f_robust_z(src, length, clip) =>
    m  = ta.sma(src, length)
    sd = ta.stdev(src, length)
    up = m + clip * sd
    dn = m - clip * sd
    clipped = math.max(dn, math.min(up, src))
    cm  = ta.sma(clipped, length)
    csd = ta.stdev(clipped, length)
    csd > 0 ? (src - cm) / csd : 0.0

f_num(v, fmt) =>
    string s = "NA"
    if not na(v)
        s := str.tostring(v, fmt)
    s

// Rolling count without ta.sum
f_count(cond, length) =>
    float v = cond ? 1.0 : 0.0
    float cs = ta.cum(v)
    cs - nz(cs[length])

f_cov(x, y, length) =>
    mx = ta.sma(x, length)
    my = ta.sma(y, length)
    ta.sma((x - mx) * (y - my), length)

f_var(x, length) =>
    mx = ta.sma(x, length)
    ta.sma((x - mx) * (x - mx), length)

f_t_from_df(r, df) =>
    float t = na
    if not na(r) and not na(df) and df > 0 and math.abs(r) < 1
        t := r * math.sqrt(df / (1 - r*r))
    t

f_partial_corr(r_xy, r_xz, r_yz) =>
    float out = na
    if not na(r_xy) and not na(r_xz) and not na(r_yz)
        float den = math.sqrt((1 - r_xz*r_xz) * (1 - r_yz*r_yz))
        out := den > 0 ? (r_xy - r_xz*r_yz) / den : na
    out

f_bg_tag(tag) =>
    color out = color.new(color.gray, 85)
    if tag == "HIGH" or tag == "RICH" or tag == "YC4" or tag == "INVERTED" or tag == "STRESS HIGH" or tag == "LOWQ" or tag == "DATAQ LOW"
        out := color.new(color.red, 12)
    else if tag == "LOW" or tag == "CHEAP" or tag == "YC1" or tag == "STRESS LOW" or tag == "HIGHQ" or tag == "DATAQ HIGH"
        out := color.new(color.lime, 14)
    else
        out := color.new(color.orange, 16)
    out

f_corrBg(float r) =>
    color bg = color.new(color.black, 80)
    if not na(r)
        float a = math.abs(r)
        int tr =
             a >= 0.50 ? 10 :
             a >= 0.35 ? 25 :
             a >= 0.20 ? 45 :
             a >= 0.10 ? 65 : 80
        color base = r >= 0 ? color.lime : color.red
        bg := color.new(base, tr)
    bg

//======================================================
// 3) DATA (STRICT: forward-fill for continuity + raw coverage for DATAQ)
//======================================================
// Raw (gaps_on) to measure coverage honestly
y1_raw  = request.security(SYM_1Y,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
y2_raw  = request.security(SYM_2Y,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
y3_raw  = request.security(SYM_3Y,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
y5_raw  = request.security(SYM_5Y,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
y7_raw  = request.security(SYM_7Y,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
y10_raw = request.security(SYM_10Y, TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
ib_raw  = request.security(SYM_IB,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)
pr_raw  = request.security(SYM_PR,  TF_DATA, close, barmerge.gaps_on,  barmerge.lookahead_off)

// VNINDEX (gaps_off)
vnx = request.security(SYM_VNX, TF_DATA, close, barmerge.gaps_off, barmerge.lookahead_off)

// Forward-fill for continuous curve analytics
var float y1  = na
var float y2  = na
var float y3  = na
var float y5  = na
var float y7  = na
var float y10 = na
var float ib  = na
var float pr  = na

y1  := na(y1_raw)  ? nz(y1[1])  : y1_raw
y2  := na(y2_raw)  ? nz(y2[1])  : y2_raw
y3  := na(y3_raw)  ? nz(y3[1])  : y3_raw
y5  := na(y5_raw)  ? nz(y5[1])  : y5_raw
y7  := na(y7_raw)  ? nz(y7[1])  : y7_raw
y10 := na(y10_raw) ? nz(y10[1]) : y10_raw
ib  := na(ib_raw)  ? nz(ib[1])  : ib_raw
pr  := na(pr_raw)  ? nz(pr[1])  : pr_raw

// VNINDEX log return
vnx_ret = (not na(vnx) and not na(vnx[1]) and vnx[1] > 0) ? math.log(vnx / vnx[1]) : na

// Winsorize returns
ret_mean = ta.sma(vnx_ret, LEN_RESEARCH)
ret_sd   = ta.stdev(vnx_ret, LEN_RESEARCH)
ret_up   = ret_mean + RET_CLIP_SD * ret_sd
ret_dn   = ret_mean - RET_CLIP_SD * ret_sd
vnx_ret_clip = (not na(vnx_ret) and not na(ret_sd) and ret_sd > 0) ? math.max(ret_dn, math.min(ret_up, vnx_ret)) : vnx_ret

//======================================================
// 4) FACTORS (stationary via percentiles)
//======================================================
level = (y2 + y5 + y10) / 3.0
slope = y10 - y2
curve = 2.0 * y5 - y2 - y10

// Percentiles (0..100)
level_pct = ta.percentrank(level, LEN_STATS)
slope_pct = ta.percentrank(slope, LEN_STATS)
curve_pct = ta.percentrank(curve, LEN_STATS)

// Stress components (percentile-based)
level_comp = level_pct
slope_risk = slope <= 0 ? 100.0 : (100.0 - slope_pct)
// Curve risk: distance from median (0..100)
curve_risk = not na(curve_pct) ? (math.abs(curve_pct - 50.0) / 50.0) * 100.0 : na

// Raw stress (0..100), strict weights
macro_stress = (0.45 * level_comp) + (0.45 * slope_risk) + (0.10 * curve_risk)

//======================================================
// 5) QUALITY (structure + DATAQ coverage)
//======================================================
y1_z  = f_robust_z(y1,  LEN_STATS, CLIP_Z)
y2_z  = f_robust_z(y2,  LEN_STATS, CLIP_Z)
y3_z  = f_robust_z(y3,  LEN_STATS, CLIP_Z)
y5_z  = f_robust_z(y5,  LEN_STATS, CLIP_Z)
y7_z  = f_robust_z(y7,  LEN_STATS, CLIP_Z)
y10_z = f_robust_z(y10, LEN_STATS, CLIP_Z)

mean_z = (y1_z + y2_z + y3_z + y5_z + y7_z + y10_z) / 6.0
dz1  = y1_z  - mean_z
dz2  = y2_z  - mean_z
dz3  = y3_z  - mean_z
dz5  = y5_z  - mean_z
dz7  = y7_z  - mean_z
dz10 = y10_z - mean_z

var_z = (dz1*dz1 + dz2*dz2 + dz3*dz3 + dz5*dz5 + dz7*dz7 + dz10*dz10) / 6.0
dist  = math.sqrt(var_z)

dist_label = dist < 0.30 ? "PURE" : dist > 0.70 ? "DISTORTED" : "MIXED"

// Structural quality (0..100)
dist_clamp  = math.min(1.2, math.max(0.0, dist))
qual_struct = 100.0 - (dist_clamp / 1.2) * 100.0

// DATAQ coverage (use RAW availability for core curve)
core_raw_ok = (not na(y2_raw)) and (not na(y5_raw)) and (not na(y10_raw))
cov_core = f_count(core_raw_ok, LEN_RESEARCH) / LEN_RESEARCH
qual_data = cov_core * 100.0

// Total quality = min(struct, data) (strict)
qual_total = math.min(qual_struct, qual_data)
quality_label =
     qual_total >= 75 ? "HIGHQ" :
     qual_total >= 50 ? "MEDQ"  : "LOWQ"

dataq_label =
     cov_core >= COV_HIGH ? "DATAQ HIGH" :
     cov_core >= COV_MED  ? "DATAQ MED"  : "DATAQ LOW"

// Stress adjusted by quality
stress_adj = macro_stress * (qual_total / 100.0)

// Percentile stress for stationarity
stress_pct  = ta.percentrank(macro_stress, LEN_STATS)
stressA_pct = ta.percentrank(stress_adj,   LEN_STATS)

// Stress regime (by percentile, strict)
stress_reg =
     stressA_pct >= STRESS_HIGH_PCTL ? "STRESS HIGH" :
     stressA_pct <= STRESS_LOW_PCTL  ? "STRESS LOW"  : "MID"

//======================================================
// 6) YC REGIME (strict, percentile-based)
//======================================================
level_reg = level_pct >= 80 ? "HIGH" : level_pct <= 20 ? "LOW" : "MID"
slope_reg =
     slope <= 0 ? "INVERTED" :
     slope_pct >= 80 ? "STEEP_HIGH" :
     slope_pct <= 20 ? "STEEP_LOW"  : "FLAT"

string yc_code  = "YC0"
string yc_label = "Neutral/Mixed."
if level_reg == "HIGH" and (slope_reg == "FLAT" or slope_reg == "INVERTED")
    yc_code  := "YC4"
    yc_label := "Tight: high level + flat/inverted."
else if level_reg == "HIGH" and slope_reg == "STEEP_HIGH"
    yc_code  := "YC3"
    yc_label := "Late tightening: high level + steep."
else if level_reg == "LOW" and slope_reg == "STEEP_HIGH"
    yc_code  := "YC2"
    yc_label := "Early easing: low level + steep."
else if level_reg == "LOW"
    yc_code  := "YC1"
    yc_label := "Easing mature: low level."

//======================================================
// 7) PLOTS (kept simple; tables are primary UI)
//======================================================
plot(y2,  "VN02Y",  color.new(color.blue, 0),  2)
plot(y5,  "VN05Y",  color.new(color.green, 0), 2)
plot(y10, "VN10Y",  color.new(color.red, 0),   2)
plot(y1,  "VN01Y",  color.new(color.gray, 60), 1)
plot(y3,  "VN03Y",  color.new(color.orange,60),1)
plot(y7,  "VN07Y",  color.new(color.purple,60),1)
plot(ib,  "VNINBR", color.new(color.yellow,0), 1)
plot(pr,  "VNINTR", color.new(color.teal, 0),  1)

// Map stress percentile to yield axis
min12   = math.min(y1, y2)
min35   = math.min(y3, y5)
min710  = math.min(y7, y10)
yc_min6 = math.min(math.min(min12, min35), min710)

max12   = math.max(y1, y2)
max35   = math.max(y3, y5)
max710  = math.max(y7, y10)
yc_max6 = math.max(math.max(max12, max35), max710)

y_min = ta.lowest(yc_min6, LEN_STATS)
y_max = ta.highest(yc_max6, LEN_STATS)
y_rng = y_max - y_min

stress_map = y_min + (stressA_pct / 100.0) * (y_rng > 0 ? y_rng : 1.0)
plot(stress_map, "StressPCTL(mapped)", color.new(color.white, 35), 2)

//======================================================
// 8) RESEARCH CORE (STRICT: AR-AdjN + Partial Corr + BestLag Discipline)
//======================================================
bool tf_ok = timeframe.isdaily
int  needBars = LEN_STATS + LEN_RESEARCH + LAG3 + 20
bool enoughBars = bar_index >= needBars

// Valid sample (strict: require core_raw_ok to avoid inferring over forward-fill holes)
bool valid_all = tf_ok and enoughBars and core_raw_ok and (not na(stressA_pct)) and (not na(vnx_ret_clip))

float n_eff = f_count(valid_all, LEN_RESEARCH)
float ratio = n_eff / LEN_RESEARCH
bool  ready = (ratio >= MIN_EFF_RATIO) and (cov_core >= COV_MED) and tf_ok and enoughBars

// Persistence adjustment
float rhoS = ta.correlation(stressA_pct, stressA_pct[1], LEN_RESEARCH)
float rhoR = ta.correlation(vnx_ret_clip, vnx_ret_clip[1], LEN_RESEARCH)
float cdi  = rhoS * rhoR

float n_eff_ar = na
bool  persist_on = false
if ready and not na(cdi) and math.abs(cdi) < 0.98 and (1 + cdi) != 0
    n_eff_ar := n_eff * (1 - cdi) / (1 + cdi)
    n_eff_ar := math.max(5.0, math.min(n_eff, n_eff_ar))
    persist_on := true

// Degrees of freedom for (adj) correlation inference
float df_corr  = (persist_on and not na(n_eff_ar)) ? (n_eff_ar - 2.0) : na
float df_pcorr = (persist_on and not na(n_eff_ar)) ? (n_eff_ar - 3.0) : na

// Base correlations (exploratory)
float corr_raw = ta.correlation(stress_pct,  vnx_ret_clip, LEN_RESEARCH)
float corr_adj = ta.correlation(stressA_pct, vnx_ret_clip, LEN_RESEARCH)
float r2_adj   = not na(corr_adj) ? corr_adj * corr_adj : na
float t_adj_ar = f_t_from_df(corr_adj, df_corr)

// Partial corr controlling avg(IB,PR)
float ctrl = (ib + pr) / 2.0
float ctrl_pct = ta.percentrank(ctrl, LEN_STATS)
float r_xz = ta.correlation(stressA_pct,  ctrl_pct,    LEN_RESEARCH)
float r_yz = ta.correlation(vnx_ret_clip, ctrl_pct,    LEN_RESEARCH)
float pcorr = f_partial_corr(corr_adj, r_xz, r_yz)
float t_pcorr_ar = f_t_from_df(pcorr, df_pcorr)

// Lags (Adj stress percentile)
float rL1  = ta.correlation(stressA_pct[LAG1], vnx_ret_clip, LEN_RESEARCH)
float rL5  = ta.correlation(stressA_pct[LAG2], vnx_ret_clip, LEN_RESEARCH)
float rL20 = ta.correlation(stressA_pct[LAG3], vnx_ret_clip, LEN_RESEARCH)

// BestLag disciplined (mask when not ready)
int   bestLag = na
float bestCorr = na
float secondAbs = na
float margin = na
float bestCorr_half = na
bool  half_ok = false

if ready
    float a1 = math.abs(rL1)
    float a2 = math.abs(rL5)
    float a3 = math.abs(rL20)

    bestLag := a1 >= a2 and a1 >= a3 ? LAG1 : (a2 >= a3 ? LAG2 : LAG3)
    bestCorr := a1 >= a2 and a1 >= a3 ? rL1 : (a2 >= a3 ? rL5 : rL20)

    // second best abs for margin
    secondAbs := bestLag == LAG1 ? math.max(a2, a3) : bestLag == LAG2 ? math.max(a1, a3) : math.max(a1, a2)
    margin := (not na(bestCorr) and not na(secondAbs)) ? (math.abs(bestCorr) - secondAbs) : na

    // Half-window consistency
    bestCorr_half :=
         bestLag == LAG1 ? ta.correlation(stressA_pct[LAG1], vnx_ret_clip, LEN_HALF) :
         bestLag == LAG2 ? ta.correlation(stressA_pct[LAG2], vnx_ret_clip, LEN_HALF) :
                           ta.correlation(stressA_pct[LAG3], vnx_ret_clip, LEN_HALF)

    half_ok := not na(bestCorr) and not na(bestCorr_half) and (math.sign(bestCorr) == math.sign(bestCorr_half)) and (math.abs(bestCorr_half) >= R_HALF_MIN)
else
    half_ok := false

float t_best = f_t_from_df(bestCorr, df_corr)

// BestLag accept/reject (strict)
bool best_accept = ready and persist_on and half_ok and
     (not na(margin) and margin >= MARGIN_MIN) and
     (not na(bestCorr) and math.abs(bestCorr) >= R_ACCEPT) and
     (not na(t_best) and math.abs(t_best) >= T_CRIT)

// BestLag stability (% unchanged) over LEN_STAB (use masked bestLag)
float eff_stab = f_count(not na(bestLag), LEN_STAB)
float chg_stab = f_count(not na(bestLag) and (bestLag != bestLag[1]), LEN_STAB)
float stab_pct = eff_stab > 0 ? 100.0 * (1.0 - chg_stab / eff_stab) : na

//======================================================
// 9) TABLES (ONLY UPDATE ON LAST BAR)
//======================================================
var table t1 = na
var table t2 = na
var table t3 = na

bg_title  = color.new(color.black, 10)
bg_head   = color.new(color.black, 25)
bg_a      = color.new(color.black, 18)
bg_b      = color.new(color.black, 28)
frame_col = color.new(color.black, 0)
tc = color.white

f_cell(t, c, r, txt, bg, ha, sz) =>
    table.cell(t, c, r, txt, bgcolor=bg, text_color=tc, text_halign=ha, text_size=sz)

if barstate.islast
    // -------- Panel 1: Shape
    if show_p1
        if na(t1)
            t1 := table.new(position.top_left, 4, 9, frame_width=2, frame_color=frame_col)

        f_cell(t1, 0, 0, "P1 | SHAPE (STRICT DEFAULTS)", bg_title, text.align_left, size.small)
        f_cell(t1, 1, 0, "", bg_title, text.align_left, size.small)
        f_cell(t1, 2, 0, "", bg_title, text.align_left, size.small)
        f_cell(t1, 3, 0, "", bg_title, text.align_left, size.small)

        f_cell(t1, 0, 1, "ITEM",  bg_head, text.align_left,  size.tiny)
        f_cell(t1, 1, 1, "VALUE", bg_head, text.align_right, size.tiny)
        f_cell(t1, 2, 1, "PCTL",  bg_head, text.align_right, size.tiny)
        f_cell(t1, 3, 1, "STATE", bg_head, text.align_left,  size.tiny)

        f_cell(t1, 0, 2, "LEVEL", bg_a, text.align_left, size.tiny)
        f_cell(t1, 1, 2, f_num(level, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t1, 2, 2, f_num(level_pct, "#.1") + "%", bg_a, text.align_right, size.tiny)
        f_cell(t1, 3, 2, level_reg, f_bg_tag(level_reg), text.align_left, size.tiny)

        f_cell(t1, 0, 3, "SLOPE(10-2)", bg_b, text.align_left, size.tiny)
        f_cell(t1, 1, 3, f_num(slope, "#.2"), bg_b, text.align_right, size.tiny)
        f_cell(t1, 2, 3, f_num(slope_pct, "#.1") + "%", bg_b, text.align_right, size.tiny)
        f_cell(t1, 3, 3, slope_reg, f_bg_tag(slope_reg), text.align_left, size.tiny)

        f_cell(t1, 0, 4, "YC REGIME", bg_a, text.align_left, size.tiny)
        f_cell(t1, 1, 4, yc_code, f_bg_tag(yc_code), text.align_right, size.tiny)
        f_cell(t1, 2, 4, "", bg_a, text.align_right, size.tiny)
        f_cell(t1, 3, 4, yc_label, bg_a, text.align_left, size.tiny)

        f_cell(t1, 0, 5, "STRESS PCTL (raw/adj)", bg_b, text.align_left, size.tiny)
        f_cell(t1, 1, 5, f_num(stress_pct, "#.1"), f_bg_tag(stress_reg), text.align_right, size.tiny)
        f_cell(t1, 2, 5, f_num(stressA_pct,"#.1"), f_bg_tag(stress_reg), text.align_right, size.tiny)
        f_cell(t1, 3, 5, stress_reg, f_bg_tag(stress_reg), text.align_left, size.tiny)

        f_cell(t1, 0, 6, "QUALITY / DATAQ", bg_a, text.align_left, size.tiny)
        f_cell(t1, 1, 6, quality_label, f_bg_tag(quality_label), text.align_right, size.tiny)
        f_cell(t1, 2, 6, dataq_label, f_bg_tag(dataq_label), text.align_right, size.tiny)
        f_cell(t1, 3, 6, "cov " + f_num(cov_core * 100.0, "#.1") + "%", bg_a, text.align_left, size.tiny)

        f_cell(t1, 0, 7, "RATES", bg_b, text.align_left, size.tiny)
        f_cell(t1, 1, 7, "IB " + f_num(ib, "#.2"), bg_b, text.align_left, size.tiny)
        f_cell(t1, 2, 7, "PR " + f_num(pr, "#.2"), bg_b, text.align_left, size.tiny)
        f_cell(t1, 3, 7, dist_label, f_bg_tag(dist_label), text.align_left, size.tiny)

        msg = (quality_label == "LOWQ" or dataq_label == "DATAQ LOW") ? "MESSAGE: LOW QUALITY -> avoid strong inference." : "MESSAGE: STRICT defaults; use P3 for research."
        f_cell(t1, 0, 8, msg, bg_title, text.align_left, size.small)
        f_cell(t1, 1, 8, "", bg_title, text.align_left, size.small)
        f_cell(t1, 2, 8, "", bg_title, text.align_left, size.small)
        f_cell(t1, 3, 8, "", bg_title, text.align_left, size.small)
    else
        if not na(t1)
            table.delete(t1)
            t1 := na

    // -------- Panel 2: Grid
    if show_p2
        if na(t2)
            t2 := table.new(position.top_left, 7, 7, frame_width=2, frame_color=frame_col)

        f_cell(t2, 0, 0, "P2 | GRID (Z-state + structure)", bg_title, text.align_left, size.small)
        for i = 1 to 6
            f_cell(t2, i, 0, "", bg_title, text.align_left, size.small)

        f_cell(t2, 0, 1, "TENOR", bg_head, text.align_left, size.tiny)
        f_cell(t2, 1, 1, "1Y", bg_head, text.align_right, size.tiny)
        f_cell(t2, 2, 1, "2Y", bg_head, text.align_right, size.tiny)
        f_cell(t2, 3, 1, "3Y", bg_head, text.align_right, size.tiny)
        f_cell(t2, 4, 1, "5Y", bg_head, text.align_right, size.tiny)
        f_cell(t2, 5, 1, "7Y", bg_head, text.align_right, size.tiny)
        f_cell(t2, 6, 1, "10Y", bg_head, text.align_right, size.tiny)

        f_cell(t2, 0, 2, "Z", bg_a, text.align_left, size.tiny)
        f_cell(t2, 1, 2, f_num(y1_z, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t2, 2, 2, f_num(y2_z, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t2, 3, 2, f_num(y3_z, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t2, 4, 2, f_num(y5_z, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t2, 5, 2, f_num(y7_z, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t2, 6, 2, f_num(y10_z,"#.2"), bg_a, text.align_right, size.tiny)

        f_cell(t2, 0, 3, "STRUCT", bg_b, text.align_left, size.tiny)
        f_cell(t2, 1, 3, dist_label, f_bg_tag(dist_label), text.align_right, size.tiny)
        f_cell(t2, 2, 3, "QUAL", bg_b, text.align_right, size.tiny)
        f_cell(t2, 3, 3, quality_label, f_bg_tag(quality_label), text.align_right, size.tiny)
        f_cell(t2, 4, 3, "DATAQ", bg_b, text.align_right, size.tiny)
        f_cell(t2, 5, 3, dataq_label, f_bg_tag(dataq_label), text.align_right, size.tiny)
        f_cell(t2, 6, 3, "", bg_b, text.align_right, size.tiny)

        take = "TAKEAWAY: " + yc_code + " | " + stress_reg + " | " + quality_label + " | " + dataq_label
        f_cell(t2, 0, 6, take, bg_title, text.align_left, size.small)
        for i = 1 to 6
            f_cell(t2, i, 6, "", bg_title, text.align_left, size.small)
    else
        if not na(t2)
            table.delete(t2)
            t2 := na

    // -------- Panel 3: Research (STRICT)
    if show_p3
        if na(t3)
            t3 := table.new(position.top_right, 4, 22, frame_width=2, frame_color=frame_col)

        f_cell(t3, 0, 0, "P3 | RESEARCH (STRICT: AR-AdjN + Partial Corr + BestLag discipline)", bg_title, text.align_left, size.small)
        f_cell(t3, 1, 0, "", bg_title, text.align_left, size.small)
        f_cell(t3, 2, 0, "", bg_title, text.align_left, size.small)
        f_cell(t3, 3, 0, "", bg_title, text.align_left, size.small)

        f_cell(t3, 0, 1, "STRESS PCTL (raw/adj)", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 1, f_num(stress_pct, "#.1"), f_bg_tag(stress_reg), text.align_right, size.tiny)
        f_cell(t3, 2, 1, f_num(stressA_pct,"#.1"), f_bg_tag(stress_reg), text.align_right, size.tiny)
        f_cell(t3, 3, 1, yc_code + " | " + quality_label, f_bg_tag(yc_code), text.align_right, size.tiny)

        ready_txt = ready ? "READY" : (tf_ok ? "WAIT" : "USE 1D")
        f_cell(t3, 0, 2, "SAMPLE", bg_b, text.align_left, size.tiny)
        f_cell(t3, 1, 2, "N " + f_num(n_eff, "#.0"), bg_b, text.align_right, size.tiny)
        f_cell(t3, 2, 2, "R " + f_num(ratio*100.0, "#.1") + "%", bg_b, text.align_right, size.tiny)
        f_cell(t3, 3, 2, ready_txt, ready ? color.new(color.lime, 75) : color.new(color.orange, 70), text.align_right, size.tiny)

        f_cell(t3, 0, 3, "PERSISTENCE (AR)", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 3, "AdjN " + f_num(n_eff_ar, "#.0"), bg_a, text.align_right, size.tiny)
        f_cell(t3, 2, 3, "rhoS " + f_num(rhoS, "#.2"), bg_a, text.align_right, size.tiny)
        f_cell(t3, 3, 3, (persist_on ? "ON" : "OFF") + " | cdi " + f_num(cdi, "#.2"), persist_on ? color.new(color.lime, 80) : color.new(color.red, 75), text.align_right, size.tiny)

        f_cell(t3, 0, 5, "ALL (Exploratory; not causal)", bg_head, text.align_left, size.tiny)
        f_cell(t3, 1, 5, "Corr", bg_head, text.align_right, size.tiny)
        f_cell(t3, 2, 5, "t(AR)", bg_head, text.align_right, size.tiny)
        f_cell(t3, 3, 5, "R2",   bg_head, text.align_right, size.tiny)

        f_cell(t3, 0, 6, "RAW t0", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 6, ready ? f_num(corr_raw, "#.3") : "NA", f_corrBg(corr_raw), text.align_right, size.tiny)
        f_cell(t3, 2, 6, "", bg_a, text.align_right, size.tiny)
        f_cell(t3, 3, 6, "", bg_a, text.align_right, size.tiny)

        f_cell(t3, 0, 7, "ADJ t0 (STRICT)", bg_b, text.align_left, size.tiny)
        f_cell(t3, 1, 7, ready ? f_num(corr_adj, "#.3") : "NA", f_corrBg(corr_adj), text.align_right, size.tiny)
        f_cell(t3, 2, 7, ready ? f_num(t_adj_ar, "#.2") : "NA", bg_b, text.align_right, size.tiny)
        f_cell(t3, 3, 7, ready ? f_num(r2_adj, "#.2")   : "NA", bg_b, text.align_right, size.tiny)

        f_cell(t3, 0, 8, "PARTIAL (ctr=avg IB/PR)", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 8, ready ? f_num(pcorr, "#.3") : "NA", f_corrBg(pcorr), text.align_right, size.tiny)
        f_cell(t3, 2, 8, ready ? f_num(t_pcorr_ar, "#.2") : "NA", bg_a, text.align_right, size.tiny)
        f_cell(t3, 3, 8, "", bg_a, text.align_right, size.tiny)

        f_cell(t3, 0, 10, "LAGS (AdjPCTL stress)", bg_head, text.align_left, size.tiny)
        f_cell(t3, 1, 10, "L1", bg_head, text.align_right, size.tiny)
        f_cell(t3, 2, 10, "L5", bg_head, text.align_right, size.tiny)
        f_cell(t3, 3, 10, "L20", bg_head, text.align_right, size.tiny)

        f_cell(t3, 0, 11, "Corr", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 11, ready ? f_num(rL1,  "#.3") : "NA", f_corrBg(rL1),  text.align_right, size.tiny)
        f_cell(t3, 2, 11, ready ? f_num(rL5,  "#.3") : "NA", f_corrBg(rL5),  text.align_right, size.tiny)
        f_cell(t3, 3, 11, ready ? f_num(rL20, "#.3") : "NA", f_corrBg(rL20), text.align_right, size.tiny)

        f_cell(t3, 0, 13, "BESTLAG (k=3 disciplined)", bg_head, text.align_left, size.tiny)
        f_cell(t3, 1, 13, "Pick", bg_head, text.align_right, size.tiny)
        f_cell(t3, 2, 13, "t", bg_head, text.align_right, size.tiny)
        f_cell(t3, 3, 13, "Stab", bg_head, text.align_right, size.tiny)

        pick_txt = "L" + str.tostring(bestLag) + ":" + f_num(bestCorr, "#.3") + " m=" + f_num(margin, "#.2")
        f_cell(t3, 0, 14, "Pick", bg_a, text.align_left, size.tiny)
        f_cell(t3, 1, 14, ready ? pick_txt : "NA", bg_a, text.align_right, size.tiny)
        f_cell(t3, 2, 14, ready ? f_num(t_best, "#.2") : "NA", bg_a, text.align_right, size.tiny)
        f_cell(t3, 3, 14, ready ? f_num(stab_pct, "#.1") + "%" : "NA", bg_a, text.align_right, size.tiny)

        acc_txt = best_accept ? "ACCEPT" : "REJECT"
        half_txt = half_ok ? "HalfOK Y" : "HalfOK N"
        f_cell(t3, 0, 15, "Accept?", bg_b, text.align_left, size.tiny)
        f_cell(t3, 1, 15, ready ? (acc_txt + " | " + half_txt) : "NA", best_accept ? color.new(color.lime, 80) : color.new(color.orange, 70), text.align_right, size.tiny)
        f_cell(t3, 2, 15, "req |t|>=2.4", bg_b, text.align_right, size.tiny)
        f_cell(t3, 3, 15, "req m>=0.05", bg_b, text.align_right, size.tiny)

        note1 = "STRICT: percentiles; inference uses AR-AdjN; partial corr controls avg(IB,PR)."
        note2 = "BestLag ACCEPT: margin>=0.05, |r|>=0.20, |t|>=2.4, consistent on half-window."
        f_cell(t3, 0, 20, note1, bg_title, text.align_left, size.small)
        f_cell(t3, 1, 20, "", bg_title, text.align_left, size.small)
        f_cell(t3, 2, 20, "", bg_title, text.align_left, size.small)
        f_cell(t3, 3, 20, "", bg_title, text.align_left, size.small)

        f_cell(t3, 0, 21, note2, bg_title, text.align_left, size.small)
        f_cell(t3, 1, 21, "", bg_title, text.align_left, size.small)
        f_cell(t3, 2, 21, "", bg_title, text.align_left, size.small)
        f_cell(t3, 3, 21, "", bg_title, text.align_left, size.small)
    else
        if not na(t3)
            table.delete(t3)
            t3 := na

//======================================================
// 10) EVENT TAGS (STRICT: percentile-based, throttled)
//======================================================
f_evCol(t) =>
    color c = color.new(color.gray, 0)
    if t == "REG"
        c := color.new(color.fuchsia, 0)
    else if t == "SU"
        c := color.new(color.red, 0)
    else if t == "SD"
        c := color.new(color.lime, 0)
    else if t == "INV"
        c := color.new(color.red, 0)
    else if t == "LQ"
        c := color.new(color.orange, 0)
    c

y_min_ev = ta.lowest(yc_min6, LEN_STATS)
y_max_ev = ta.highest(yc_max6, LEN_STATS)
y_rng_ev = y_max_ev - y_min_ev
y_pad = (y_rng_ev > 0 ? y_rng_ev : 1.0) * (EVENT_YPAD_PCT / 100.0)

f_tag(string t, string txt, float y, bool up) =>
    label lb = na
    if not na(y)
        float yy = up ? (y + y_pad) : (y - y_pad)
        lb := label.new(bar_index + EVENT_XOFF, yy, txt)
        label.set_textcolor(lb, color.white)
        label.set_color(lb, f_evCol(t))
        label.set_size(lb, size.tiny)
        label.set_style(lb, up ? label.style_label_down : label.style_label_up)
    lb

var int last_ev_bar = na
can_tag = na(last_ev_bar) ? true : (bar_index - last_ev_bar >= EVENT_MIN_GAP)

yc_prev = yc_code[1]
regime_change = (not na(yc_prev)) and (yc_code != yc_prev)

stress_up = ta.crossover(stressA_pct, STRESS_HIGH_PCTL)
stress_dn = ta.crossunder(stressA_pct, STRESS_LOW_PCTL)

inv_now = slope <= 0
inv_prev = slope[1] <= 0
inv_start = inv_now and not inv_prev

lq_now  = (quality_label == "LOWQ") or (dataq_label == "DATAQ LOW")
lq_prev = (quality_label[1] == "LOWQ") or (dataq_label[1] == "DATAQ LOW")
lq_start = lq_now and not lq_prev

float y_anchor = na(y10) ? level : y10

if SHOW_EVENTS and tf_ok and can_tag and barstate.isconfirmed and not na(y_anchor)
    if regime_change
        f_tag("REG", "REG: " + yc_prev + " -> " + yc_code, y_anchor, true)
        last_ev_bar := bar_index
    else if stress_up
        f_tag("SU", "STRESS UP (PCTL): " + f_num(stressA_pct, "#.1"), y_anchor, true)
        last_ev_bar := bar_index
    else if stress_dn
        f_tag("SD", "STRESS DN (PCTL): " + f_num(stressA_pct, "#.1"), y_anchor, false)
        last_ev_bar := bar_index
    else if inv_start
        f_tag("INV", "INVERT: slope<=0", y_anchor, true)
        last_ev_bar := bar_index
    else if lq_start
        f_tag("LQ", "LOW QUALITY: " + quality_label + " / " + dataq_label, y_anchor, false)
        last_ev_bar := bar_index

//======================================================
// 11) ALERTS (STRICT)
//======================================================
alertcondition(yc_code == "YC4" and quality_label != "LOWQ" and dataq_label != "DATAQ LOW", "YC4 Tight (STRICT OK)", "YC4 tight regime with acceptable quality/data.")
alertcondition(slope <= 0, "Yield curve inverted", "Slope 10-2 <= 0.")
alertcondition(stressA_pct >= STRESS_HIGH_PCTL and quality_label != "LOWQ" and dataq_label != "DATAQ LOW", "Stress High (PCTL, STRICT OK)", "Stress percentile high with acceptable quality/data.")
