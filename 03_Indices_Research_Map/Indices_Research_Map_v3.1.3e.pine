     horizon == 20 ? array.get(sumRR20_sector, idx) : array.get(sumRR60_sector, idx)


f_sector_sum_sq(int horizon, int idx) =>
    horizon == 5 ? array.get(sumSqRR5_sector, idx) :
     horizon == 20 ? array.get(sumSqRR20_sector, idx) : array.get(sumSqRR60_sector, idx)


f_sector_count(int horizon, int idx) =>
    horizon == 5 ? array.get(cntRR5_sector, idx) :
     horizon == 20 ? array.get(cntRR20_sector, idx) : array.get(cntRR60_sector, idx)


f_sector_win(int horizon, int idx) =>
    horizon == 5 ? array.get(winRR5_sector, idx) :
     horizon == 20 ? array.get(winRR20_sector, idx) : array.get(winRR60_sector, idx)


f_sector_reject_count(int horizon, int idx) =>
    horizon == 5 ? array.get(rejectRR5_sector, idx) :
     horizon == 20 ? array.get(rejectRR20_sector, idx) : array.get(rejectRR60_sector, idx)


f_vni_back_sum(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumBackR5_vni, bucket) :
     horizon == 20 ? array.get(sumBackR20_vni, bucket) : array.get(sumBackR60_vni, bucket)


f_vni_back_sum_sq(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumSqBackR5_vni, bucket) :
     horizon == 20 ? array.get(sumSqBackR20_vni, bucket) : array.get(sumSqBackR60_vni, bucket)


f_vni_back_count(int horizon, int bucket) =>
    horizon == 5 ? array.get(cntBackR5_vni, bucket) :
     horizon == 20 ? array.get(cntBackR20_vni, bucket) : array.get(cntBackR60_vni, bucket)


f_vni_cal_sum(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumCalR5_vni, bucket) :
     horizon == 20 ? array.get(sumCalR20_vni, bucket) : array.get(sumCalR60_vni, bucket)


f_vni_cal_sum_sq(int horizon, int bucket) =>
