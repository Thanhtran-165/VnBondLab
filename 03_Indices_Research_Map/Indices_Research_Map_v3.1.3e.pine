    f_reset_all_stats()
//=============================================================================
// 7) SAMPLE FILTERS & UPDATE ENGINE
//=============================================================================


f_sample_range_ok(int signalTime, int outcomeTime) =>
    bool ok = false
    if not na(signalTime) and not na(outcomeTime)
        int signalYear = year(signalTime)
        int outcomeYear = year(outcomeTime)
        ok := signalYear >= sample_start_year and outcomeYear <= sample_end_year
    ok


f_sample_ok(int signalTime, int outcomeTime) =>
    bool ok = false
    if f_sample_range_ok(signalTime, outcomeTime)
        int signalYear = year(signalTime)
        int outcomeYear = year(outcomeTime)
        ok := sample_mode == "Full sample" ? true :
             sample_mode == "Calibration" ? outcomeYear <= split_year :
             signalYear > split_year
    ok


var int research_bar_count = 0
bool commit_bar = barstate.isconfirmed
if commit_bar
    research_bar_count += 1


f_non_overlap_ok(int horizon) =>
    int phase = non_overlap_phase % horizon
    not use_non_overlap or (research_bar_count + phase) % horizon == 0


f_update_return_stats(float[] sumArr, float[] sumSqArr, float[] cntArr, float[] winArr, int idx, float ret, bool doUpdate) =>
    if doUpdate and not na(ret)
        array.set(sumArr, idx, array.get(sumArr, idx) + ret)
        array.set(sumSqArr, idx, array.get(sumSqArr, idx) + ret * ret)
        array.set(cntArr, idx, array.get(cntArr, idx) + 1.0)
        if ret > 0
            array.set(winArr, idx, array.get(winArr, idx) + 1.0)


f_update_sum_count(float[] sumArr, float[] cntArr, int idx, float value, bool doUpdate) =>
    if doUpdate and not na(value)
        array.set(sumArr, idx, array.get(sumArr, idx) + value)
        array.set(cntArr, idx, array.get(cntArr, idx) + 1.0)


f_update_sum_sq_count(float[] sumArr, float[] sumSqArr, float[] cntArr, int idx, float value, bool doUpdate) =>
    if doUpdate and not na(value)
        array.set(sumArr, idx, array.get(sumArr, idx) + value)
        array.set(sumSqArr, idx, array.get(sumSqArr, idx) + value * value)
        array.set(cntArr, idx, array.get(cntArr, idx) + 1.0)


f_update_one_market(
     int marketIndex,
     float closeSeries, float highSeries, float lowSeries,
     int horizon,
     float[] sumArr, float[] sumSqArr, float[] cntArr, float[] winArr,
     float[] sumMAEArr, float[] cntMAEArr,
     float[] sumMFEArr, float[] cntMFEArr,
     float[] sumMDDArr, float[] cntMDDArr,
     float[] rejectArr,
     float[] backSumArr, float[] backSumSqArr, float[] backCntArr,
     float[] diffSumArr, float[] diffSumSqArr, float[] diffCntArr,
     float[] calSumArr, float[] calSumSqArr, float[] calCntArr,
     float[] valSumArr, float[] valSumSqArr, float[] valCntArr) =>




    bool hasSignal = risk_valid[horizon] and not na(risk_bucket[horizon])
    int signalBucket = hasSignal ? risk_bucket[horizon] : na
    int signalTime = confirmed_market_time[horizon]
    int outcomeTime = confirmed_market_time
    bool sampleRange = f_sample_range_ok(signalTime, outcomeTime)
    bool doMainUpdate = commit_bar and hasSignal and f_sample_ok(signalTime, outcomeTime) and f_non_overlap_ok(horizon)
    bool doAuxUpdate = commit_bar and hasSignal and sampleRange and f_non_overlap_ok(horizon)


    float cThen = closeSeries[horizon]
    float ret = f_compute_return(closeSeries, cThen, use_log_return, ret_clip_lo, ret_clip_hi)
    [mae, mfe, closeMdd] = f_path_outcomes(closeSeries, highSeries, lowSeries, horizon, use_log_return)
    float maxDailyMove = max_index_daily_move_pct / 100.0
    bool forwardBreak = filter_index_breaks and f_has_jump_window(closeSeries, 0, horizon, maxDailyMove)
    bool forwardValid = not forwardBreak and not na(ret)


    if doMainUpdate
        int idx = marketIndex * N_BUCKETS + signalBucket
        if forwardValid
            f_update_return_stats(sumArr, sumSqArr, cntArr, winArr, idx, ret, true)
            f_update_sum_count(sumMAEArr, cntMAEArr, idx, mae, true)
            f_update_sum_count(sumMFEArr, cntMFEArr, idx, mfe, true)
            f_update_sum_count(sumMDDArr, cntMDDArr, idx, closeMdd, true)
        else
            array.set(rejectArr, idx, array.get(rejectArr, idx) + 1.0)


    // VNINDEX-only auxiliary tests use a fixed full-range sample, independent of panel sample mode.
    if marketIndex == 0 and doAuxUpdate and forwardValid
        float cBeforeSignal = closeSeries[horizon * 2]
        bool backwardBreak = filter_index_breaks and f_has_jump_window(closeSeries, horizon, horizon, maxDailyMove)
        float backwardRet = f_compute_return(cThen, cBeforeSignal, use_log_return, ret_clip_lo, ret_clip_hi)


        if not backwardBreak
            f_update_sum_sq_count(backSumArr, backSumSqArr, backCntArr, signalBucket, backwardRet, true)
            float pairedDiff = not na(ret) and not na(backwardRet) ? ret - backwardRet : na
            f_update_sum_sq_count(diffSumArr, diffSumSqArr, diffCntArr, signalBucket, pairedDiff, true)


        int signalYear = year(signalTime)
        int outcomeYear = year(outcomeTime)
        if outcomeYear <= split_year
            f_update_sum_sq_count(calSumArr, calSumSqArr, calCntArr, signalBucket, ret, true)
        if signalYear > split_year
            f_update_sum_sq_count(valSumArr, valSumSqArr, valCntArr, signalBucket, ret, true)


f_update_one_sector(
     int sectorIndex, float sectorSeries, int horizon,
     float[] sumArr, float[] sumSqArr, float[] cntArr, float[] winArr, float[] rejectArr) =>




    bool hasSignal = risk_valid[horizon] and not na(risk_bucket[horizon])
    int signalBucket = hasSignal ? risk_bucket[horizon] : na
    int signalTime = confirmed_market_time[horizon]
    bool doUpdate = commit_bar and hasSignal and f_sample_ok(signalTime, confirmed_market_time) and f_non_overlap_ok(horizon)


    float benchThen = benchmark_close[horizon]
    float benchRetRaw = f_compute_return_raw(benchmark_close, benchThen, use_log_return)
    float sectorThen = sectorSeries[horizon]
    float sectorRetRaw = f_compute_return_raw(sectorSeries, sectorThen, use_log_return)
    float relativeRetRaw = f_relative_return(sectorRetRaw, benchRetRaw, use_log_return)
    float relativeRet = f_clip_return(relativeRetRaw, ret_clip_lo, ret_clip_hi)
    float maxDailyMove = max_index_daily_move_pct / 100.0
    bool benchBreak = filter_index_breaks and f_has_jump_window(benchmark_close, 0, horizon, maxDailyMove)
    bool sectorBreak = filter_index_breaks and f_has_jump_window(sectorSeries, 0, horizon, maxDailyMove)
    bool windowValid = not benchBreak and not sectorBreak and not na(relativeRet)


    if doUpdate
        int idx = sectorIndex * N_BUCKETS + signalBucket
        if windowValid
            f_update_return_stats(sumArr, sumSqArr, cntArr, winArr, idx, relativeRet, true)
        else
            array.set(rejectArr, idx, array.get(rejectArr, idx) + 1.0)


f_update_transition(int horizon) =>
    bool hasFrom = risk_valid[horizon] and not na(risk_bucket[horizon])
    bool hasTo = risk_valid and not na(risk_bucket)
    int fromBucket = hasFrom ? risk_bucket[horizon] : na
    int toBucket = hasTo ? risk_bucket : na
    int signalTime = confirmed_market_time[horizon]
    bool doUpdate = commit_bar and hasFrom and hasTo and f_sample_ok(signalTime, confirmed_market_time) and f_non_overlap_ok(horizon)


    float benchRet = f_compute_return(benchmark_close, benchmark_close[horizon], use_log_return, ret_clip_lo, ret_clip_hi)
    float maxDailyMove = max_index_daily_move_pct / 100.0
    bool benchBreak = filter_index_breaks and f_has_jump_window(benchmark_close, 0, horizon, maxDailyMove)


    if doUpdate
        int idx = fromBucket * N_BUCKETS + toBucket
        array.set(trans_state_count, idx, array.get(trans_state_count, idx) + 1.0)
        if not benchBreak and not na(benchRet)
            array.set(trans_count, idx, array.get(trans_count, idx) + 1.0)
            array.set(trans_sum_ret, idx, array.get(trans_sum_ret, idx) + benchRet)
            array.set(trans_sum_sq_ret, idx, array.get(trans_sum_sq_ret, idx) + benchRet * benchRet)
            if benchRet > 0
                array.set(trans_win, idx, array.get(trans_win, idx) + 1.0)
        else
            array.set(trans_reject, idx, array.get(trans_reject, idx) + 1.0)


// Explicitly unrolled 5-bar market calls. Each written call owns an independent series history.
