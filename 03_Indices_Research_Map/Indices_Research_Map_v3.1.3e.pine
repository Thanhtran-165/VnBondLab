     horizon == 20 ? array.get(sumMFE20_market, idx) : array.get(sumMFE60_market, idx)


f_market_mfe_count(int horizon, int idx) =>
    horizon == 5 ? array.get(cntMFE5_market, idx) :
     horizon == 20 ? array.get(cntMFE20_market, idx) : array.get(cntMFE60_market, idx)


f_market_mdd_sum(int horizon, int idx) =>
    horizon == 5 ? array.get(sumMDD5_market, idx) :
     horizon == 20 ? array.get(sumMDD20_market, idx) : array.get(sumMDD60_market, idx)


f_market_mdd_count(int horizon, int idx) =>
    horizon == 5 ? array.get(cntMDD5_market, idx) :
     horizon == 20 ? array.get(cntMDD20_market, idx) : array.get(cntMDD60_market, idx)


f_market_reject_count(int horizon, int idx) =>
