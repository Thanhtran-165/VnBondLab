     horizon == 20 ? array.get(cntCalR20_vni, bucket) : array.get(cntCalR60_vni, bucket)


f_vni_val_sum(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumValR5_vni, bucket) :
     horizon == 20 ? array.get(sumValR20_vni, bucket) : array.get(sumValR60_vni, bucket)


f_vni_val_sum_sq(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumSqValR5_vni, bucket) :
     horizon == 20 ? array.get(sumSqValR20_vni, bucket) : array.get(sumSqValR60_vni, bucket)


f_vni_val_count(int horizon, int bucket) =>
    horizon == 5 ? array.get(cntValR5_vni, bucket) :
     horizon == 20 ? array.get(cntValR20_vni, bucket) : array.get(cntValR60_vni, bucket)


f_vni_diff_sum(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumDiffR5_vni, bucket) :
     horizon == 20 ? array.get(sumDiffR20_vni, bucket) : array.get(sumDiffR60_vni, bucket)


f_vni_diff_sum_sq(int horizon, int bucket) =>
    horizon == 5 ? array.get(sumSqDiffR5_vni, bucket) :
     horizon == 20 ? array.get(sumSqDiffR20_vni, bucket) : array.get(sumSqDiffR60_vni, bucket)


f_vni_diff_count(int horizon, int bucket) =>
    horizon == 5 ? array.get(cntDiffR5_vni, bucket) :
     horizon == 20 ? array.get(cntDiffR20_vni, bucket) : array.get(cntDiffR60_vni, bucket)


// Direction: 1 = risk up, 0 = same, -1 = risk down.
f_transition_aggregate(int fromBucket, int direction) =>
    float cnt = 0.0
    float sumRet = 0.0
    float sumSqRet = 0.0
    float wins = 0.0


    for toBucket = 0 to N_BUCKETS - 1
        bool include = direction == 1 ? toBucket > fromBucket :
             direction == -1 ? toBucket < fromBucket : toBucket == fromBucket
        if include
            int idx = fromBucket * N_BUCKETS + toBucket
            cnt += array.get(trans_count, idx)
            sumRet += array.get(trans_sum_ret, idx)
            sumSqRet += array.get(trans_sum_sq_ret, idx)
            wins += array.get(trans_win, idx)


    [cnt, sumRet, sumSqRet, wins]


f_transition_state_aggregate(int fromBucket, int direction) =>
    float stateCnt = 0.0
    float rejected = 0.0
    for toBucket = 0 to N_BUCKETS - 1
        bool include = direction == 1 ? toBucket > fromBucket :
             direction == -1 ? toBucket < fromBucket : toBucket == fromBucket
        if include
            int idx = fromBucket * N_BUCKETS + toBucket
            stateCnt += array.get(trans_state_count, idx)
            rejected += array.get(trans_reject, idx)
    [stateCnt, rejected]


f_transition_origin_totals(int fromBucket) =>
    float stateCnt = 0.0
    float retCnt = 0.0
    float rejected = 0.0
    for toBucket = 0 to N_BUCKETS - 1
        int idx = fromBucket * N_BUCKETS + toBucket
        stateCnt += array.get(trans_state_count, idx)
        retCnt += array.get(trans_count, idx)
        rejected += array.get(trans_reject, idx)
    [stateCnt, retCnt, rejected]


// Internal count invariant for the current origin bucket at the transition horizon.
// VNINDEX market counts and transition return/rejection counts must reconcile exactly.
int invariant_origin_safe = risk_valid and not na(risk_bucket) ? risk_bucket : 0
[invariant_state_raw, invariant_ret_raw, invariant_rej_raw] = f_transition_origin_totals(invariant_origin_safe)
float invariant_market_valid = risk_valid and not na(risk_bucket) ? f_market_count(transition_horizon, invariant_origin_safe) : na
float invariant_market_reject = risk_valid and not na(risk_bucket) ? f_market_reject_count(transition_horizon, invariant_origin_safe) : na
float invariant_state_n = risk_valid and not na(risk_bucket) ? invariant_state_raw : na
float invariant_return_n = risk_valid and not na(risk_bucket) ? invariant_ret_raw : na
float invariant_reject_n = risk_valid and not na(risk_bucket) ? invariant_rej_raw : na
bool internal_consistency_available = not na(invariant_state_n) and invariant_state_n > 0
bool internal_consistency_pass = not internal_consistency_available or (
     math.abs(nz(invariant_market_valid) - nz(invariant_return_n)) < 0.001 and
     math.abs(nz(invariant_market_reject) - nz(invariant_reject_n)) < 0.001 and
     math.abs(nz(invariant_state_n) - nz(invariant_return_n) - nz(invariant_reject_n)) < 0.001)
string internal_consistency_state = not internal_consistency_available ? "PENDING" :
     internal_consistency_pass ? "PASS" : "FAIL"


//=============================================================================
// 9) BUCKET & PANEL FLAGS
//=============================================================================


int bucket_auto = risk_valid and not na(risk_bucket) ? risk_bucket : na
int bucket_selected = bucket_view == "Auto (current)" ? bucket_auto :
     bucket_view == "B0 (0–20)" ? 0 :
     bucket_view == "B1 (20–40)" ? 1 :
     bucket_view == "B2 (40–60)" ? 2 :
     bucket_view == "B3 (60–80)" ? 3 : 4


bool show_panel1 = panel_view == "Panel 1 — Macro Weather"
bool show_panel2 = panel_view == "Panel 2 — Market Conditional Returns"
bool show_panel3 = panel_view == "Panel 3 — Sector Rotation"
bool show_panel4 = panel_view == "Panel 4 — Transition Matrix"


bool inference_approx_valid = use_non_overlap
float market_econ_floor = market_econ_floor_pct / 100.0
float sector_econ_floor = sector_econ_floor_pct / 100.0
float sector_z_effective = sector_multiple_testing == "Bonferroni 11" ? Z_BONFERRONI_11 : z_critical_sector


//=============================================================================
// 10) PANEL 1 — MACRO WEATHER & ROBUSTNESS
//=============================================================================


string liquidity_status = f_status_from_score(score_liquidity, "TIGHT", "EASY")
string curve_status = f_status_from_score(score_curve, "FLAT/INV", "STEEP/OK")
string external_status = f_status_from_score(score_external, "EXT PRESS", "OK")
string long_policy_status = f_status_from_score(score_long_policy, "COMPRESSED", "OK")


float vni_sum = na
float vni_sum_sq = na
float vni_n = na
float vni_win = na
float vni_mae_sum = na
float vni_mae_n = na
float vni_mfe_sum = na
float vni_mfe_n = na
float vni_mdd_sum = na
float vni_mdd_n = na
float vni_back_sum = na
float vni_back_sum_sq = na
float vni_back_n = na
float vni_cal_sum = na
float vni_cal_sum_sq = na
float vni_cal_n = na
float vni_val_sum = na
float vni_val_sum_sq = na
float vni_val_n = na
float vni_diff_sum = na
float vni_diff_sum_sq = na
float vni_diff_n = na
float vni_reject_n = na


if risk_valid and not na(risk_bucket)
    int vni_idx = risk_bucket
    vni_sum := f_market_sum(analysis_horizon, vni_idx)
    vni_sum_sq := f_market_sum_sq(analysis_horizon, vni_idx)
    vni_n := f_market_count(analysis_horizon, vni_idx)
    vni_win := f_market_win(analysis_horizon, vni_idx)
    vni_mae_sum := f_market_mae_sum(analysis_horizon, vni_idx)
    vni_mae_n := f_market_mae_count(analysis_horizon, vni_idx)
    vni_mfe_sum := f_market_mfe_sum(analysis_horizon, vni_idx)
    vni_mfe_n := f_market_mfe_count(analysis_horizon, vni_idx)
    vni_mdd_sum := f_market_mdd_sum(analysis_horizon, vni_idx)
    vni_mdd_n := f_market_mdd_count(analysis_horizon, vni_idx)
    vni_back_sum := f_vni_back_sum(analysis_horizon, vni_idx)
    vni_back_sum_sq := f_vni_back_sum_sq(analysis_horizon, vni_idx)
    vni_back_n := f_vni_back_count(analysis_horizon, vni_idx)
    vni_cal_sum := f_vni_cal_sum(analysis_horizon, vni_idx)
    vni_cal_sum_sq := f_vni_cal_sum_sq(analysis_horizon, vni_idx)
    vni_cal_n := f_vni_cal_count(analysis_horizon, vni_idx)
    vni_val_sum := f_vni_val_sum(analysis_horizon, vni_idx)
    vni_val_sum_sq := f_vni_val_sum_sq(analysis_horizon, vni_idx)
    vni_val_n := f_vni_val_count(analysis_horizon, vni_idx)
    vni_diff_sum := f_vni_diff_sum(analysis_horizon, vni_idx)
    vni_diff_sum_sq := f_vni_diff_sum_sq(analysis_horizon, vni_idx)
    vni_diff_n := f_vni_diff_count(analysis_horizon, vni_idx)
    vni_reject_n := f_market_reject_count(analysis_horizon, vni_idx)


float vni_mean = f_avg(vni_sum, vni_n)
float vni_ci_lo = f_ci_low_auto(vni_sum, vni_sum_sq, vni_n)
float vni_ci_hi = f_ci_high_auto(vni_sum, vni_sum_sq, vni_n)
float vni_win_rate = f_winrate(vni_win, vni_n)
float vni_win_ci_lo = f_wilson_low(vni_win, vni_n, Z95)
float vni_win_ci_hi = f_wilson_high(vni_win, vni_n, Z95)
float vni_avg_mae = f_avg(vni_mae_sum, vni_mae_n)
float vni_avg_mfe = f_avg(vni_mfe_sum, vni_mfe_n)
float vni_avg_mdd = f_avg(vni_mdd_sum, vni_mdd_n)
float vni_back_mean = f_avg(vni_back_sum, vni_back_n)
float vni_cal_mean = f_avg(vni_cal_sum, vni_cal_n)
float vni_val_mean = f_avg(vni_val_sum, vni_val_n)
float vni_diff_mean = f_avg(vni_diff_sum, vni_diff_n)
float vni_diff_ci_lo = f_ci_low_auto(vni_diff_sum, vni_diff_sum_sq, vni_diff_n)
float vni_diff_ci_hi = f_ci_high_auto(vni_diff_sum, vni_diff_sum_sq, vni_diff_n)
float vni_reject_rate = f_rejection_rate(vni_n, vni_reject_n)
string vni_sample_health = f_sample_health(
     vni_n, vni_reject_n,
     rejection_caution_pct, rejection_contaminated_pct, rejection_unusable_pct)
bool vni_quality_allows_inference = f_quality_allows_inference(vni_sample_health)


string vni_base_evidence = f_evidence_label(
     vni_sum, vni_sum_sq, vni_n, min_n_market,
     math.max(z_critical_market, f_tcrit95(vni_n)), market_econ_floor, inference_approx_valid)
string vni_stability = f_stability_label(
     vni_cal_sum, vni_cal_sum_sq, vni_cal_n,
     vni_val_sum, vni_val_sum_sq, vni_val_n,
     min_n_oos, market_econ_floor)
string vni_lead_lag = f_paired_control_label(
     vni_diff_sum, vni_diff_sum_sq, vni_diff_n,
     min_n_control, market_econ_floor, inference_approx_valid)
string vni_academic_base = f_academic_label(
     vni_base_evidence, integrity_state, vni_stability, vni_lead_lag, spec_agreement)
string vni_academic_evidence = internal_consistency_pass ? f_quality_evidence(vni_academic_base, vni_sample_health) : "INTERNAL-FAIL"


string macro_takeaway = not risk_valid ? "NO VALID COMPOSITE" :
     not internal_consistency_pass ? "INTERNAL CONSISTENCY FAIL — OUTCOME INFERENCE LOCKED" :
     integrity_state == "STALE" ? "COMPOSITE AVAILABLE — SOURCE DATA STALE" :
     vni_sample_health == "UNUSABLE" ? "MACRO VALID — VNINDEX OUTCOME DATA UNUSABLE" :
     vni_sample_health == "CONTAMINATED" ? "MACRO VALID — VNINDEX OUTCOME DATA CONTAMINATED" :
     tail_override and stress_breadth80 == 1 ? "NEUTRAL COMPOSITE WITH SINGLE-PILLAR TAIL RISK" :
     stress_breadth80 >= 2 ? "BROAD HIGH-STRESS CONFIGURATION" :
     consensus_state == "DIVERGENT" ? "DIVERGENT PILLARS — COMPOSITE MASKS DISPERSION" :
     vni_academic_evidence == "ROBUST-OOS" ? "ROBUST CONDITIONAL MARKET EVIDENCE" :
     vni_academic_evidence == "FRAGILE" ? "FULL-SAMPLE EFFECT IS OUT-OF-SAMPLE FRAGILE" :
     risk_bucket <= 1 and vni_mean > 0 ? "SUPPORTIVE MACRO / POSITIVE CONDITIONAL RETURN" :
     risk_bucket >= 3 and vni_mean < 0 ? "DEFENSIVE MACRO / NEGATIVE CONDITIONAL RETURN" :
     "MIXED CONDITIONAL EVIDENCE"


var table macro_table = na
var table method_table = na
var label risk_label = na


if barstate.islast
    if not na(risk_label)
        label.delete(risk_label)
    if risk_valid
        risk_label := label.new(
             bar_index, risk_pct,
             "Risk " + str.tostring(risk_pct, "#.#") + "% | " + f_bucket_label(risk_bucket) +
             " | " + integrity_state + " | Dominant " + dominant_pillar + " " + f_fmt_num(dominant_score, "#.#"),
             style=label.style_label_left, textcolor=color.white,
             color=tail_override ? color.new(color.orange, 35) : color.new(color.blue, 60), size=size.small)


if barstate.islast
    if show_panel1
        if na(macro_table)
            macro_table := table.new(position.top_right, 4, 12, bgcolor=color.new(color.black, 15), border_width=2, border_color=color.new(color.white, 25))
            table.merge_cells(macro_table, 0, 0, 3, 0)
    else
        if not na(macro_table)
            table.delete(macro_table)
            macro_table := na


if barstate.islast and show_panel1 and not na(macro_table)
    string date_text = not na(confirmed_market_time) ? str.format_time(confirmed_market_time, "yyyy-MM-dd") : "--"
    string header = risk_valid ?
         "Macro Weather v3.1.3 | " + f_bucket_label(risk_bucket) + " | Risk " + str.tostring(risk_pct, "#.#") +
         "% | " + integrity_state :
         "Macro Weather v3.1.3 | COMPOSITE UNAVAILABLE"


    table.cell(macro_table, 0, 0, header, bgcolor=color.new(color.orange, 0), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 1, "Pillar", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(macro_table, 1, 1, "Raw", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(macro_table, 2, 1, "Risk pct", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(macro_table, 3, 1, "State", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)


    table.cell(macro_table, 0, 2, "Liquidity: IB–Policy", bgcolor=color.new(color.black, 10), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 2, f_fmt_num(liquidity_stress, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 2, f_fmt_num(score_liquidity, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 2, liquidity_status + " | daily age " + str.tostring(stale_interbank), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 3, "Curve: 10Y–2Y", bgcolor=color.new(color.black, 10), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 3, f_fmt_num(curve_standard, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 3, f_fmt_num(score_curve, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 3, curve_status + " | daily age " + str.tostring(math.max(stale_2y, stale_10y)), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 4, "External: VN10Y–US10Y", bgcolor=color.new(color.black, 10), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 4, f_fmt_num(intl_yield_diff, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 4, f_fmt_num(score_external, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 4, external_status + " | daily age " + str.tostring(math.max(stale_10y, stale_us10y)), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 5, "Long–Policy: 10Y–Policy", bgcolor=color.new(color.black, 10), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 5, f_fmt_num(long_policy_spread, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 5, f_fmt_num(score_long_policy, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 5, long_policy_status + " | 10Y age " + str.tostring(stale_10y) + " | policy age " + str.tostring(stale_policy), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 6, "Structure", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(macro_table, 1, 6, "Dominant " + dominant_pillar + " " + f_fmt_num(dominant_score, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 6, "Breadth " + str.tostring(stress_breadth60) + "/4 | Extreme " + str.tostring(stress_breadth80) + "/4", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 6, consensus_state + " | Disp " + f_fmt_num(pillar_dispersion, "#.#"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 7, "Dynamics", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(macro_table, 1, 7, "Mom5 " + f_fmt_num(risk_mom5, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 7, "MA20 " + f_fmt_num(risk_ma20, "#.##") + " | Vol20 " + f_fmt_num(risk_vol20, "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 7, "20D " + f_regime_arrow(risk_bucket, risk_bucket_20ago) + " | Spec " + spec_bucket_text + " (" + str.tostring(spec_agreement) + "/3)", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 8, "VNINDEX | H=" + str.tostring(analysis_horizon), bgcolor=color.new(color.blue, 15), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 8, (vni_quality_allows_inference ? "Winsor mean " : "Diagnostic mean ") + f_fmt_pct(vni_mean, "#.##"), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 8, vni_quality_allows_inference ? "t-CI95 " + f_fmt_ci(vni_ci_lo, vni_ci_hi) : "CI suppressed | " + vni_sample_health, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 8,
         "Win " + (not na(vni_win_rate) ? str.tostring(vni_win_rate, "#.#") + "%" : "--") +
         (vni_quality_allows_inference ? " | W95 " + f_fmt_prob_ci(vni_win_ci_lo, vni_win_ci_hi) : " | diagnostic"),
         bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 9, "Path risk", bgcolor=color.new(color.blue, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 9, show_path_risk ? "MAE " + f_fmt_pct(vni_avg_mae, "#.##") : "OFF", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 9, show_path_risk ? "MFE " + f_fmt_pct(vni_avg_mfe, "#.##") : "OFF", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 9, show_path_risk ? "Close-MDD " + f_fmt_pct(vni_avg_mdd, "#.##") : "OFF", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 10, "Robustness", bgcolor=color.new(color.blue, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 10, vni_academic_evidence + " | QC " + vni_sample_health + " | Rej " + f_fmt_num(vni_reject_rate, "#.#") + "% | Internal " + internal_consistency_state, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 10,
         vni_stability + " | Cal " + f_fmt_pct(vni_cal_mean, "#.##") + " N" + str.tostring(math.round(nz(vni_cal_n, 0))) +
         " / Val " + f_fmt_pct(vni_val_mean, "#.##") + " N" + str.tostring(math.round(nz(vni_val_n, 0))),
         bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 10,
         vni_lead_lag + " | ΔF−B " + f_fmt_pct(vni_diff_mean, "#.##") + " " + f_fmt_ci(vni_diff_ci_lo, vni_diff_ci_hi) +
         " | N " + str.tostring(math.round(nz(vni_diff_n, 0))) + " | Rej " + str.tostring(math.round(nz(vni_reject_n, 0))),
         bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


    table.cell(macro_table, 0, 11, "TAKEAWAY", bgcolor=color.new(color.blue, 0), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 1, 11, macro_takeaway, bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 2, 11, "Tail " + (tail_override ? "ON" : "OFF") + " | " + dataq + " | " + integrity_state + " | Outcome " + vni_sample_health, bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)
    table.cell(macro_table, 3, 11, date_text + " | T−1 confirmed", bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small)


if barstate.islast
    if show_method_note
        if na(method_table)
            method_table := table.new(position.bottom_left, 2, 9, bgcolor=color.new(color.black, 78), border_width=1, border_color=color.new(color.white, 20))
            table.merge_cells(method_table, 0, 0, 1, 0)
    else
        if not na(method_table)
            table.delete(method_table)
            method_table := na


if barstate.islast and show_method_note and not na(method_table)
    table.cell(method_table, 0, 0, "Research diagnostics v3.1.3", bgcolor=color.new(color.blue, 35), text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 1, "Sample", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 1, sample_mode + " | " + str.tostring(sample_start_year) + "–" + str.tostring(sample_end_year) + " | split " + str.tostring(split_year), text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 2, "Dependence", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 2, use_non_overlap ? "Non-overlap phase " + str.tostring(non_overlap_phase % analysis_horizon) + " | approximate inference" : "Overlap | descriptive only", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 3, "Integrity", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 3, integrity_state + " | max daily age " + str.tostring(max_daily_stale_age) + " | policy age " + str.tostring(stale_policy) + " | " + str.tostring(pillar_count) + "/4", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 4, "Multiplicity", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 4, sector_multiple_testing + " | sector crit* " + str.tostring(sector_z_effective, "#.###"), text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 5, "Outcome QC", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 5, "Rejection gates " + str.tostring(rejection_caution_pct, "#") + "/" + str.tostring(rejection_contaminated_pct, "#") + "/" + str.tostring(rejection_unusable_pct, "#") + "% | jump >" + str.tostring(max_index_daily_move_pct, "#") + "%", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 6, "Internal", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 6, internal_consistency_state + " | Mkt " + f_fmt_num(invariant_market_valid, "#") + "/" + f_fmt_num(invariant_market_reject, "#") + " | Trans " + f_fmt_num(invariant_return_n, "#") + "/" + f_fmt_num(invariant_reject_n, "#"), text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 7, "Robustness", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 7, "Unrolled series + OOS split + paired F−B + dual-count transitions + breadth gate", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 0, 8, "Limit", text_color=color.white, text_size=size.tiny)
    table.cell(method_table, 1, 8, "Conditional association ≠ causality; path metrics use daily OHLC/close", text_color=color.white, text_size=size.tiny)


//=============================================================================
// 11) PANEL 2 — MARKET CONDITIONAL RETURNS & OUTCOME QUALITY
//=============================================================================


var table market_table = na
if barstate.islast
    if show_panel2
        if na(market_table)
            market_table := table.new(position.top_right, 10, 8, bgcolor=color.new(color.black, 18), border_width=2, border_color=color.new(color.white, 25))
            table.merge_cells(market_table, 0, 0, 9, 0)
    else
        if not na(market_table)
            table.delete(market_table)
            market_table := na


if barstate.islast and show_panel2 and not na(market_table)
    string bucket_text = not na(bucket_selected) ? f_bucket_label(bucket_selected) : "NA"
    table.cell(market_table, 0, 0,
         "Market Outcomes v3.1.3 | H=" + str.tostring(analysis_horizon) + " | " + bucket_text + " | QC-gated",
         bgcolor=color.new(color.blue, 0), text_color=color.white, text_size=size.small)


    table.cell(market_table, 0, 1, "Index", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 1, 1, "Mean (diag)", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 2, 1, "t-CI95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 3, 1, "Win | W95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 4, 1, "MAE", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 5, 1, "MFE", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 6, 1, "Close-MDD", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 7, 1, "t-stat", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 8, 1, "N / Rej", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(market_table, 9, 1, "Evidence / QC", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)


    for m = 0 to N_MARKETS - 1
        int row = m + 2
        bool validBucket = not na(bucket_selected)
        int idx = validBucket ? m * N_BUCKETS + bucket_selected : 0
        float sum = validBucket ? f_market_sum(analysis_horizon, idx) : na
        float sumSq = validBucket ? f_market_sum_sq(analysis_horizon, idx) : na
        float cnt = validBucket ? f_market_count(analysis_horizon, idx) : na
        float wins = validBucket ? f_market_win(analysis_horizon, idx) : na
        float maeSum = validBucket ? f_market_mae_sum(analysis_horizon, idx) : na
        float maeCnt = validBucket ? f_market_mae_count(analysis_horizon, idx) : na
        float mfeSum = validBucket ? f_market_mfe_sum(analysis_horizon, idx) : na
        float mfeCnt = validBucket ? f_market_mfe_count(analysis_horizon, idx) : na
        float mddSum = validBucket ? f_market_mdd_sum(analysis_horizon, idx) : na
        float mddCnt = validBucket ? f_market_mdd_count(analysis_horizon, idx) : na
        float rejected = validBucket ? f_market_reject_count(analysis_horizon, idx) : na


        float mean = f_avg(sum, cnt)
        float ciLo = f_ci_low_auto(sum, sumSq, cnt)
        float ciHi = f_ci_high_auto(sum, sumSq, cnt)
        float winRate = f_winrate(wins, cnt)
        float winLo = f_wilson_low(wins, cnt, Z95)
        float winHi = f_wilson_high(wins, cnt, Z95)
        float avgMae = f_avg(maeSum, maeCnt)
        float avgMfe = f_avg(mfeSum, mfeCnt)
        float avgMdd = f_avg(mddSum, mddCnt)
        float tstat = f_zstat(sum, sumSq, cnt)
        float marketCrit = math.max(z_critical_market, f_tcrit95(cnt))
        string baseEvidence = f_evidence_label(sum, sumSq, cnt, min_n_market, marketCrit, market_econ_floor, inference_approx_valid)
        string sampleHealth = f_sample_health(cnt, rejected, rejection_caution_pct, rejection_contaminated_pct, rejection_unusable_pct)
        string evidence = internal_consistency_pass ? f_quality_evidence(baseEvidence, sampleHealth) : "INTERNAL-FAIL"
        bool qualityAllows = f_quality_allows_inference(sampleHealth)
        bool hasDescriptive = not na(cnt) and cnt > 0
        bool enoughInference = hasDescriptive and cnt >= min_n_market and qualityAllows


        table.cell(market_table, 0, row, array.get(market_names, m), bgcolor=color.new(color.black, 10), text_color=color.white, text_size=size.small)
        table.cell(market_table, 1, row, hasDescriptive ? f_fmt_pct(mean, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 2, row, enoughInference ? f_fmt_ci(ciLo, ciHi) : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 3, row,
             hasDescriptive and not na(winRate) ? str.tostring(winRate, "#.#") + "%" + (enoughInference ? " " + f_fmt_prob_ci(winLo, winHi) : "") : "--",
             bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 4, row, hasDescriptive and show_path_risk ? f_fmt_pct(avgMae, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 5, row, hasDescriptive and show_path_risk ? f_fmt_pct(avgMfe, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 6, row, hasDescriptive and show_path_risk ? f_fmt_pct(avgMdd, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 7, row, enoughInference ? f_fmt_num(tstat, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 8, row, str.tostring(math.round(nz(cnt, 0))) + " / " + str.tostring(math.round(nz(rejected, 0))), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(market_table, 9, row, evidence, bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


//=============================================================================
// 12) PANEL 3 — SECTOR ROTATION WITH MULTIPLICITY & BREADTH GATES
//=============================================================================


var table sector_table = na
if barstate.islast
    if show_panel3
        if na(sector_table)
            sector_table := table.new(position.bottom_right, 7, 12, bgcolor=color.new(color.black, 15), border_width=2, border_color=color.new(color.white, 25))
            table.merge_cells(sector_table, 0, 0, 6, 0)
            table.merge_cells(sector_table, 1, 11, 6, 11)
    else
        if not na(sector_table)
            table.delete(sector_table)
            sector_table := na


if barstate.islast and show_panel3 and not na(sector_table)
    string bucket_text = not na(bucket_selected) ? f_bucket_label(bucket_selected) : "NA"


    float[] means = array.new_float(N_SECTORS, na)
    float[] counts = array.new_float(N_SECTORS, na)
    float[] tstats = array.new_float(N_SECTORS, na)
    float[] ciLows = array.new_float(N_SECTORS, na)
    float[] ciHighs = array.new_float(N_SECTORS, na)
    string[] evidenceArr = array.new_string(N_SECTORS, "THIN")
    string[] healthArr = array.new_string(N_SECTORS, "NO-DATA")
    float[] rejects = array.new_float(N_SECTORS, na)
    bool[] eligibleArr = array.new_bool(N_SECTORS, false)
    int eligibleCount = 0


    for s = 0 to N_SECTORS - 1
        bool validBucket = not na(bucket_selected)
        int idx = validBucket ? s * N_BUCKETS + bucket_selected : 0
        float sum = validBucket ? f_sector_sum(analysis_horizon, idx) : na
        float sumSq = validBucket ? f_sector_sum_sq(analysis_horizon, idx) : na
        float cnt = validBucket ? f_sector_count(analysis_horizon, idx) : na
        float rejected = validBucket ? f_sector_reject_count(analysis_horizon, idx) : na
        float mean = f_avg(sum, cnt)
        float tstat = f_zstat(sum, sumSq, cnt)
        float sectorCritCell = math.max(sector_z_effective, f_tcrit95(cnt))
        float ciLo = f_ci_low(sum, sumSq, cnt, sectorCritCell)
        float ciHi = f_ci_high(sum, sumSq, cnt, sectorCritCell)
        string baseEvidence = f_evidence_label(sum, sumSq, cnt, min_n_sector, sectorCritCell, sector_econ_floor, inference_approx_valid)
        string sampleHealth = f_sample_health(cnt, rejected, rejection_caution_pct, rejection_contaminated_pct, rejection_unusable_pct)
        string evidence = internal_consistency_pass ? f_quality_evidence(baseEvidence, sampleHealth) : "INTERNAL-FAIL"
        bool eligible = internal_consistency_pass and not na(cnt) and cnt >= min_n_sector and f_quality_allows_inference(sampleHealth)
        if eligible
            eligibleCount += 1
        array.set(means, s, mean)
        array.set(counts, s, cnt)
        array.set(tstats, s, tstat)
        array.set(ciLows, s, ciLo)
        array.set(ciHighs, s, ciHi)
        array.set(evidenceArr, s, evidence)
        array.set(healthArr, s, sampleHealth)
        array.set(rejects, s, rejected)
        array.set(eligibleArr, s, eligible)


    bool breadthOk = eligibleCount >= min_sector_breadth
    table.cell(sector_table, 0, 0,
         "Sector Rotation v3.1.3 | H=" + str.tostring(analysis_horizon) + " | " + bucket_text +
         " | Eligible " + str.tostring(eligibleCount) + "/" + str.tostring(N_SECTORS),
         bgcolor=color.new(color.teal, 0), text_color=color.white, text_size=size.small)


    int[] topIdx = array.new_int(3, -1)
    int[] bottomIdx = array.new_int(3, -1)
    bool[] selected = array.new_bool(N_SECTORS, false)


    // Always list up to three best eligible series. A Top/Bottom rotation claim requires breadthOk.
    for k = 0 to 2
        float bestValue = na
        int bestIndex = -1
        for sectorIndex = 0 to N_SECTORS - 1
            float value = array.get(means, sectorIndex)
            bool eligible = array.get(eligibleArr, sectorIndex)
            bool used = array.get(selected, sectorIndex)
            if eligible and not used and not na(value)
                if bestIndex == -1 or value > bestValue
                    bestValue := value
                    bestIndex := sectorIndex
        array.set(topIdx, k, bestIndex)
        if bestIndex != -1
            array.set(selected, bestIndex, true)


    if breadthOk
        for k = 0 to 2
            float worstValue = na
            int worstIndex = -1
            for sectorIndex = 0 to N_SECTORS - 1
                float value = array.get(means, sectorIndex)
                bool eligible = array.get(eligibleArr, sectorIndex)
                bool used = array.get(selected, sectorIndex)
                if eligible and not used and not na(value)
                    if worstIndex == -1 or value < worstValue
                        worstValue := value
                        worstIndex := sectorIndex
            array.set(bottomIdx, k, worstIndex)
            if worstIndex != -1
                array.set(selected, worstIndex, true)


    table.cell(sector_table, 0, 1, "Rank", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 1, 1, "Sector", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 2, 1, "Mean RR", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 3, 1, "Adj CI95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 4, 1, "t-stat", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 5, 1, "N / Rej", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(sector_table, 6, 1, "Evidence / QC", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)


    for k = 0 to 2
        int row = 2 + k
        int sidx = array.get(topIdx, k)
        table.cell(sector_table, 0, row, (breadthOk ? "TOP " : "ELIG ") + str.tostring(k + 1), bgcolor=color.new(color.green, 35), text_color=color.white, text_size=size.small)
        if sidx == -1
            for c = 1 to 6
                table.cell(sector_table, c, row, "--", bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)
        else
            table.cell(sector_table, 1, row, array.get(sector_names, sidx), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 2, row, f_fmt_pct(array.get(means, sidx), "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 3, row, f_fmt_ci(array.get(ciLows, sidx), array.get(ciHighs, sidx)), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 4, row, f_fmt_num(array.get(tstats, sidx), "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 5, row, str.tostring(math.round(array.get(counts, sidx))) + " / " + str.tostring(math.round(nz(array.get(rejects, sidx), 0))), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 6, row, array.get(evidenceArr, sidx), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    table.cell(sector_table, 0, 5, "—", bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)
    for c = 1 to 6
        table.cell(sector_table, c, 5, "", bgcolor=color.new(color.black, 70), text_color=color.white, text_size=size.small)


    for k = 0 to 2
        int row = 6 + k
        int sidx = breadthOk ? array.get(bottomIdx, k) : -1
        table.cell(sector_table, 0, row, breadthOk ? "BOT " + str.tostring(k + 1) : "NO ROTATION", bgcolor=color.new(color.red, 35), text_color=color.white, text_size=size.small)
        if sidx == -1
            for c = 1 to 6
                table.cell(sector_table, c, row, "--", bgcolor=color.new(color.black, 30), text_color=color.white, text_size=size.small)
        else
            table.cell(sector_table, 1, row, array.get(sector_names, sidx), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 2, row, f_fmt_pct(array.get(means, sidx), "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 3, row, f_fmt_ci(array.get(ciLows, sidx), array.get(ciHighs, sidx)), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 4, row, f_fmt_num(array.get(tstats, sidx), "#.##"), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 5, row, str.tostring(math.round(array.get(counts, sidx))) + " / " + str.tostring(math.round(nz(array.get(rejects, sidx), 0))), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
            table.cell(sector_table, 6, row, array.get(evidenceArr, sidx), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    string bestName = breadthOk and array.get(topIdx, 0) != -1 ? array.get(sector_names, array.get(topIdx, 0)) : "--"
    string worstName = breadthOk and array.get(bottomIdx, 0) != -1 ? array.get(sector_names, array.get(bottomIdx, 0)) : "--"
    string sectorTakeaway = breadthOk ? bestName + " vs " + worstName : "INSUFFICIENT BREADTH " + str.tostring(eligibleCount) + "/" + str.tostring(N_SECTORS)


    table.cell(sector_table, 0, 9, "TAKEAWAY", bgcolor=color.new(color.blue, 15), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 1, 9, sectorTakeaway, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 2, 9, breadthOk ? "ROTATION" : "DIAGNOSTIC", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 3, 9, "Min breadth " + str.tostring(min_sector_breadth), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 4, 9, "crit* ≥" + str.tostring(sector_z_effective, "#.###"), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 5, 9, use_non_overlap ? "NON-OVERLAP" : "OVERLAP", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 6, 9, sample_mode, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


    table.cell(sector_table, 0, 10, "Control", bgcolor=color.new(color.blue, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 1, 10, sector_multiple_testing, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 2, 10, "11 tests", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 3, 10, "Family-wise 5%", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 4, 10, "QC excludes ≥" + str.tostring(rejection_contaminated_pct, "#") + "%", bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 5, 10, dataq, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(sector_table, 6, 10, integrity_state, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


    table.cell(sector_table, 0, 11, "Note", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)
    table.cell(sector_table, 1, 11, "No Top/Bottom claim below breadth gate; contaminated series cannot receive ROBUST evidence.", bgcolor=color.new(color.black, 60), text_color=color.white, text_size=size.tiny)


//=============================================================================
// 13) PANEL 4 — DUAL-COUNT TRANSITION ANALYSIS
//=============================================================================


var table transition_table = na
if barstate.islast
    if show_panel4
        if na(transition_table)
            transition_table := table.new(position.top_right, 9, 6, bgcolor=color.new(color.black, 15), border_width=2, border_color=color.new(color.white, 25))
            table.merge_cells(transition_table, 0, 0, 8, 0)
    else
        if not na(transition_table)
            table.delete(transition_table)
            transition_table := na


if barstate.islast and show_panel4 and not na(transition_table)
    int origin = risk_valid and not na(risk_bucket) ? risk_bucket : na
    table.cell(transition_table, 0, 0,
         "Transition v3.1.3 | H=" + str.tostring(transition_horizon) + " | Origin " + f_bucket_label(origin) + " | State vs return samples",
         bgcolor=color.new(color.orange, 0), text_color=color.white, text_size=size.small)


    table.cell(transition_table, 0, 1, "Direction", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 1, 1, "Prob%", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 2, 1, "Prob W95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 3, 1, "Mean return", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 4, 1, "t-CI95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 5, 1, "Win | W95", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 6, 1, "N state", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 7, 1, "N ret / Rej", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)
    table.cell(transition_table, 8, 1, "Evidence / QC", bgcolor=color.new(color.white, 10), text_color=color.black, text_size=size.small)


    float totalOriginState = 0.0
    float totalOriginReturn = 0.0
    float totalOriginReject = 0.0
    if not na(origin)
        for destination = 0 to N_BUCKETS - 1
            int idx = origin * N_BUCKETS + destination
            totalOriginState += array.get(trans_state_count, idx)
            totalOriginReturn += array.get(trans_count, idx)
            totalOriginReject += array.get(trans_reject, idx)


    int[] directions = array.from(1, 0, -1)
    string[] directionNames = array.from("Risk ↑", "Same bucket", "Risk ↓")


    float upProb = na
    float sameProb = na
    float downProb = na


    for r = 0 to 2
        int direction = array.get(directions, r)
        float stateCnt = na
        float rejected = na
        float retCnt = na
        float sumRet = na
        float sumSqRet = na
        float wins = na
        if not na(origin)
            [aggStateCnt, aggRejected] = f_transition_state_aggregate(origin, direction)
            [aggRetCnt, aggSumRet, aggSumSqRet, aggWins] = f_transition_aggregate(origin, direction)
            stateCnt := aggStateCnt
            rejected := aggRejected
            retCnt := aggRetCnt
            sumRet := aggSumRet
            sumSqRet := aggSumSqRet
            wins := aggWins


        float probability = totalOriginState > 0 and not na(stateCnt) ? stateCnt / totalOriginState * 100.0 : na
        float probLo = f_wilson_low(stateCnt, totalOriginState, Z95)
        float probHi = f_wilson_high(stateCnt, totalOriginState, Z95)
        float mean = f_avg(sumRet, retCnt)
        float ciLo = f_ci_low_auto(sumRet, sumSqRet, retCnt)
        float ciHi = f_ci_high_auto(sumRet, sumSqRet, retCnt)
        float winRate = f_winrate(wins, retCnt)
        float winLo = f_wilson_low(wins, retCnt, Z95)
        float winHi = f_wilson_high(wins, retCnt, Z95)
        float transitionCrit = math.max(z_critical_market, f_tcrit95(retCnt))
        string baseEvidence = f_evidence_label(sumRet, sumSqRet, retCnt, min_n_transition_return, transitionCrit, market_econ_floor, inference_approx_valid)
        string sampleHealth = f_sample_health(retCnt, rejected, rejection_caution_pct, rejection_contaminated_pct, rejection_unusable_pct)
        string evidence = internal_consistency_pass ? f_quality_evidence(baseEvidence, sampleHealth) : "INTERNAL-FAIL"
        bool qualityAllows = f_quality_allows_inference(sampleHealth)
        bool enoughOrigin = totalOriginState >= min_n_transition
        bool hasReturn = not na(retCnt) and retCnt > 0
        bool enoughReturnInference = internal_consistency_pass and hasReturn and retCnt >= min_n_transition_return and qualityAllows
        int row = r + 2


        if direction == 1
            upProb := probability
        else if direction == 0
            sameProb := probability
        else
            downProb := probability


        table.cell(transition_table, 0, row, array.get(directionNames, r), bgcolor=color.new(color.black, 18), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 1, row, enoughOrigin and not na(probability) ? str.tostring(probability, "#.#") + "%" : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 2, row, enoughOrigin ? f_fmt_prob_ci(probLo, probHi) : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 3, row, hasReturn ? f_fmt_pct(mean, "#.##") : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 4, row, enoughReturnInference ? f_fmt_ci(ciLo, ciHi) : "--", bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 5, row,
             hasReturn and not na(winRate) ? str.tostring(winRate, "#.#") + "%" + (enoughReturnInference ? " " + f_fmt_prob_ci(winLo, winHi) : "") : "--",
             bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 6, row, str.tostring(math.round(nz(stateCnt, 0))), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 7, row, str.tostring(math.round(nz(retCnt, 0))) + " / " + str.tostring(math.round(nz(rejected, 0))), bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)
        table.cell(transition_table, 8, row, evidence, bgcolor=color.new(color.black, 28), text_color=color.white, text_size=size.small)


    string transition_takeaway = not internal_consistency_pass ? "INTERNAL CONSISTENCY FAIL" :
         totalOriginState < min_n_transition ? "ORIGIN STATE SAMPLE THIN" :
         not na(sameProb) and sameProb >= 50 ? "REGIME PERSISTENCE DOMINATES" :
         not na(upProb) and not na(downProb) and upProb > downProb ? "RISK DETERIORATION MORE FREQUENT" :
         not na(upProb) and not na(downProb) and downProb > upProb ? "RISK IMPROVEMENT MORE FREQUENT" : "BALANCED TRANSITIONS"
    string transitionOutcomeHealth = f_sample_health(totalOriginReturn, totalOriginReject, rejection_caution_pct, rejection_contaminated_pct, rejection_unusable_pct)


    table.cell(transition_table, 0, 5, "TAKEAWAY", bgcolor=color.new(color.blue, 15), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 1, 5, transition_takeaway, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 2, 5, "Nstate " + str.tostring(math.round(totalOriginState)), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 3, 5, "Nret " + str.tostring(math.round(totalOriginReturn)), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 4, 5, "Rej " + str.tostring(math.round(totalOriginReject)), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 5, 5, sample_mode, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 6, 5, "Hyst " + str.tostring(hysteresis_pts, "#.#"), bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 7, 5, "Internal " + internal_consistency_state, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)
    table.cell(transition_table, 8, 5, "Return QC " + transitionOutcomeHealth, bgcolor=color.new(color.black, 25), text_color=color.white, text_size=size.small)


//=============================================================================
// 14) ALERTS
//=============================================================================


bool risk_cross_high = risk_valid and risk_pct >= 80 and risk_pct[1] < 80
bool risk_cross_low = risk_valid and risk_pct <= 20 and risk_pct[1] > 20
bool integrity_became_stale = integrity_state == "STALE" and integrity_state[1] != "STALE"
bool tail_override_on = tail_override and not tail_override[1]
bool vni_outcome_became_unusable = vni_sample_health == "UNUSABLE" and vni_sample_health[1] != "UNUSABLE"
bool internal_consistency_failed = not internal_consistency_pass and internal_consistency_pass[1]


alertcondition(risk_cross_high, "Macro risk entered B4", "Macro composite risk entered the high-stress region.")
alertcondition(risk_cross_low, "Macro risk entered B0", "Macro composite risk entered the very-supportive region.")
alertcondition(integrity_became_stale, "Macro source data became stale", "At least one macro source timestamp exceeded the configured staleness limit.")
alertcondition(tail_override_on, "Dominant macro pillar entered tail risk", "At least one macro pillar crossed the dominant-pillar tail threshold.")
alertcondition(vni_outcome_became_unusable, "VNINDEX outcome sample became unusable", "The selected VNINDEX bucket/horizon exceeded the configured rejection-rate gate; outcome inference is disabled.")
alertcondition(internal_consistency_failed, "Internal consistency invariant failed", "VNINDEX market counts no longer reconcile with transition return/rejection counts; outcome inference is locked.")