f_update_one_sector(
     9, sec_vnheal, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     10, sec_vnuti, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)


if transition_horizon == 5
    f_update_transition(5)
else if transition_horizon == 20
    f_update_transition(20)
else
    f_update_transition(60)


//=============================================================================
// 8) ARRAY SELECTORS
//=============================================================================


f_market_sum(int horizon, int idx) =>
    horizon == 5 ? array.get(sumR5_market, idx) :
     horizon == 20 ? array.get(sumR20_market, idx) : array.get(sumR60_market, idx)


f_market_sum_sq(int horizon, int idx) =>
    horizon == 5 ? array.get(sumSqR5_market, idx) :
     horizon == 20 ? array.get(sumSqR20_market, idx) : array.get(sumSqR60_market, idx)


f_market_count(int horizon, int idx) =>
    horizon == 5 ? array.get(cntR5_market, idx) :
     horizon == 20 ? array.get(cntR20_market, idx) : array.get(cntR60_market, idx)


f_market_win(int horizon, int idx) =>
    horizon == 5 ? array.get(winR5_market, idx) :
     horizon == 20 ? array.get(winR20_market, idx) : array.get(winR60_market, idx)


f_market_mae_sum(int horizon, int idx) =>
    horizon == 5 ? array.get(sumMAE5_market, idx) :
     horizon == 20 ? array.get(sumMAE20_market, idx) : array.get(sumMAE60_market, idx)


f_market_mae_count(int horizon, int idx) =>
