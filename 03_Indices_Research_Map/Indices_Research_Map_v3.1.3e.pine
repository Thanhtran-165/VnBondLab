     rejectR60_market,
     sumBackR60_vni, sumSqBackR60_vni, cntBackR60_vni,
     sumDiffR60_vni, sumSqDiffR60_vni, cntDiffR60_vni,
     sumCalR60_vni, sumSqCalR60_vni, cntCalR60_vni,
     sumValR60_vni, sumSqValR60_vni, cntValR60_vni)
f_update_one_market(
     5, mkt_vnsmall, mkt_vnsmall_high, mkt_vnsmall_low, 60,
     sumR60_market, sumSqR60_market, cntR60_market, winR60_market,
     sumMAE60_market, cntMAE60_market, sumMFE60_market, cntMFE60_market, sumMDD60_market, cntMDD60_market,
     rejectR60_market,
     sumBackR60_vni, sumSqBackR60_vni, cntBackR60_vni,
     sumDiffR60_vni, sumSqDiffR60_vni, cntDiffR60_vni,
     sumCalR60_vni, sumSqCalR60_vni, cntCalR60_vni,
     sumValR60_vni, sumSqValR60_vni, cntValR60_vni)
// Explicitly unrolled 60-bar sector calls.
f_update_one_sector(
     0, sec_vnfin, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     1, sec_vnfin_sel, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     2, sec_vnind, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     3, sec_vnit, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     4, sec_vnreal, 60,
     sumRR60_sector, sumSqRR60_sector, cntRR60_sector, winRR60_sector, rejectRR60_sector)
f_update_one_sector(
     5, sec_vncons, 60,
