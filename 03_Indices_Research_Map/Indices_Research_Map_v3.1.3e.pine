//@version=6
indicator("Macro → VN Indices Research v3.1.3e — Bounded Global Buffer Fix",
     shorttitle="MacroIndices Academic v3.1.3e",
     overlay=false,
     max_bars_back=120,
     max_labels_count=100,
     max_lines_count=100)


//=============================================================================
// RESEARCH DESIGN — v3.1.3e
//=============================================================================
// 1) One common research clock. The chart timeframe MUST equal Research timeframe.
// 2) All external series use the last CONFIRMED source bar:
//       request.security(..., expression[1], lookahead = barmerge.lookahead_on)
//    This intentionally introduces a one-bar publication lag to eliminate HTF repaint.
// 3) Forward outcomes are aligned as:
//       regime at t-L  →  return from t-L to t.
// 4) Non-overlapping sampling is ON by default. If disabled, inference labels become
//    DESCRIPTIVE because overlapping forward returns are serially dependent.
// 5) Dispersion uses SAMPLE variance (n-1), not population variance.
// 6) Tables report mean, finite-sample t-approximation confidence interval, win rate, N,
//    and an evidence label combining statistical and economic significance.
// 7) Sector relative return is compounded correctly for arithmetic returns:
//       (1 + sector_return) / (1 + benchmark_return) - 1.
// 8) Composite macro risk dynamically renormalizes available pillars and exposes DATAQ.
// 9) Regime hysteresis reduces threshold-churn and spurious transition counts.
// 10) Calibration / validation sample modes support basic holdout robustness checks.
// 11) Path risk is separated into MAE, MFE, and close-to-close maximum drawdown.
// 12) Composite diagnostics expose dominant stress, breadth, dispersion, and tail override.
// 13) Data integrity distinguishes VALID, STALE, PARTIAL, WARMUP, and INVALID states.
// 14) Wilson intervals quantify uncertainty around win rates and transition probabilities.
// 15) Sector inference can apply a Bonferroni family-wise correction across 11 sectors.
// 16) Auxiliary calibration/validation and backward-return controls test stability and lead-lag asymmetry.
// 17) Fixed 504/756/1260-day specifications diagnose current-regime sensitivity.
// 18) Cadence-aware freshness excludes the stepwise policy-rate series from daily staleness failures.
// 19) Index discontinuity gates reject windows containing implausible one-day scale breaks.
// 20) OOS evidence uses a dedicated minimum N and reports calibration/validation counts.
// 21) The negative control uses paired forward-minus-backward differences with a t-CI.
// 22) Non-overlap phase is explicit and reproducible within the loaded research history.
// 23) Outcome-quality gates classify rejection rates as CLEAN, CAUTION, CONTAMINATED, or UNUSABLE.
// 24) Contaminated samples cannot receive ROBUST evidence; unusable samples are diagnostic only.
// 25) Sector rotation requires minimum cross-sectional breadth and never duplicates a sector across tails.
// 26) Transition probability uses all valid macro states, while return inference uses only clean market outcomes.
//
// 27) Market and sector time-series updates are explicitly unrolled by symbol. No selector-derived
//     local series is history-referenced inside a loop.
// 28) An internal invariant reconciles VNINDEX market counts with transition return/rejection counts.
//     Any mismatch locks outcome inference as INTERNAL-FAIL.
//
// 29) A bounded indicator-wide max_bars_back=120 covers the largest fixed offset used.
//     This is far below the prior 5000-bar allocation and avoids per-series parser issues.
//     It is designed to prevent RE10067, RE10143, and CE10013 simultaneously.
//
// IMPORTANT: This is a conditional historical research tool, not a causal model and
// not an investment recommendation. Parametric CIs remain approximate; Pine Script is not
// a substitute for a full econometric environment with HAC/bootstrap inference.


//=============================================================================
// 0) CONSTANTS & HELPERS
//=============================================================================


float Z95 = 1.959964
float Z_BONFERRONI_11 = 2.837596
int N_BUCKETS = 5
int N_MARKETS = 6
int N_SECTORS = 11


f_clamp(float x, float lo, float hi) =>
    math.max(lo, math.min(hi, x))


f_avg(float sum, float cnt) =>
    cnt > 0 ? sum / cnt : na


f_sample_var(float sum, float sumSq, float cnt) =>
    cnt > 1 ? math.max((sumSq - sum * sum / cnt) / (cnt - 1.0), 0.0) : na


f_sample_sd(float sum, float sumSq, float cnt) =>
    float v = f_sample_var(sum, sumSq, cnt)
    not na(v) ? math.sqrt(v) : na


f_se(float sum, float sumSq, float cnt) =>
    float sd = f_sample_sd(sum, sumSq, cnt)
    cnt > 1 and not na(sd) ? sd / math.sqrt(cnt) : na


f_zstat(float sum, float sumSq, float cnt) =>
    float mu = f_avg(sum, cnt)
    float se = f_se(sum, sumSq, cnt)
    cnt > 1 and not na(mu) and not na(se) and se > 0 ? mu / se : na


f_ci_low(float sum, float sumSq, float cnt, float zCrit) =>
    float mu = f_avg(sum, cnt)
    float se = f_se(sum, sumSq, cnt)
    not na(mu) and not na(se) ? mu - zCrit * se : na


f_ci_high(float sum, float sumSq, float cnt, float zCrit) =>
    float mu = f_avg(sum, cnt)
    float se = f_se(sum, sumSq, cnt)
    not na(mu) and not na(se) ? mu + zCrit * se : na


f_winrate(float win, float cnt) =>
    cnt > 0 ? win / cnt * 100.0 : na


f_reset_float_array(float[] arr) =>
    if array.size(arr) > 0
        for i = 0 to array.size(arr) - 1
            array.set(arr, i, 0.0)


f_score_high_bad(float src, int length) =>
    ta.percentrank(src, length)


f_score_low_bad(float src, int length) =>
    100.0 - ta.percentrank(src, length)


f_clip_return(float r, float lo, float hi) =>
    na(r) ? na : f_clamp(r, lo, hi)


f_compute_return_raw(float cNow, float cThen, bool useLog) =>
    not na(cNow) and not na(cThen) and cNow > 0 and cThen > 0 ?
         (useLog ? math.log(cNow / cThen) : cNow / cThen - 1.0) : na


f_compute_return(float cNow, float cThen, bool useLog, float clipLo, float clipHi) =>
    f_clip_return(f_compute_return_raw(cNow, cThen, useLog), clipLo, clipHi)


f_relative_return(float sectorRet, float benchRet, bool useLog) =>
    float rr = na
    if not na(sectorRet) and not na(benchRet)
        rr := useLog ? sectorRet - benchRet :
             (1.0 + benchRet != 0 ? (1.0 + sectorRet) / (1.0 + benchRet) - 1.0 : na)
    rr


f_bucket_raw(float risk) =>
    int b = na
    if not na(risk)
        b := risk < 20 ? 0 :
             risk < 40 ? 1 :
             risk < 60 ? 2 :
             risk < 80 ? 3 : 4
    b


f_bucket_label(int b) =>
    b == 0 ? "B0 (0–20)" :
     b == 1 ? "B1 (20–40)" :
     b == 2 ? "B2 (40–60)" :
     b == 3 ? "B3 (60–80)" :
     b == 4 ? "B4 (80–100)" : "NA"


f_bucket_text(int b) =>
    b == 0 ? "Very supportive" :
     b == 1 ? "Supportive" :
     b == 2 ? "Neutral" :
     b == 3 ? "Risky" :
     b == 4 ? "High stress" : "NA"


f_upper_boundary(int b) =>
    b == 0 ? 20.0 : b == 1 ? 40.0 : b == 2 ? 60.0 : b == 3 ? 80.0 : 100.0


f_lower_boundary(int b) =>
    b == 1 ? 20.0 : b == 2 ? 40.0 : b == 3 ? 60.0 : b == 4 ? 80.0 : 0.0


f_regime_arrow(int currentBucket, int priorBucket) =>
    na(currentBucket) or na(priorBucket) ? "→" :
     currentBucket > priorBucket ? "↑" :
     currentBucket < priorBucket ? "↓" : "→"


f_fmt_pct(float x, string pattern) =>
    not na(x) ? str.tostring(x * 100.0, pattern) + "%" : "--"


f_fmt_num(float x, string pattern) =>
    not na(x) ? str.tostring(x, pattern) : "--"


f_fmt_ci(float lo, float hi) =>
    not na(lo) and not na(hi) ? "[" + str.tostring(lo * 100.0, "#.##") + "; " + str.tostring(hi * 100.0, "#.##") + "]%" : "--"


f_dataq_label(int pillars, float coverage) =>
    pillars == 4 and coverage >= 0.95 ? "HIGHQ" :
     pillars >= 3 and coverage >= 0.70 ? "MEDQ" : "LOWQ"




f_tcrit95(float cnt) =>
    float df = cnt - 1.0
    df <= 1 ? 12.706 :
     df <= 2 ? 4.303 :
     df <= 3 ? 3.182 :
     df <= 4 ? 2.776 :
     df <= 5 ? 2.571 :
     df <= 6 ? 2.447 :
     df <= 7 ? 2.365 :
     df <= 8 ? 2.306 :
     df <= 9 ? 2.262 :
     df <= 12 ? 2.179 :
     df <= 15 ? 2.131 :
     df <= 20 ? 2.086 :
     df <= 30 ? 2.042 :
     df <= 60 ? 2.000 :
     df <= 120 ? 1.980 : Z95


f_ci_low_auto(float sum, float sumSq, float cnt) =>
    f_ci_low(sum, sumSq, cnt, f_tcrit95(cnt))


f_ci_high_auto(float sum, float sumSq, float cnt) =>
    f_ci_high(sum, sumSq, cnt, f_tcrit95(cnt))


f_wilson_low(float successes, float total, float zCrit) =>
    float out = na
    if total > 0 and not na(successes)
        float p = successes / total
        float z2 = zCrit * zCrit
        float denom = 1.0 + z2 / total
        float center = (p + z2 / (2.0 * total)) / denom
        float half = zCrit * math.sqrt((p * (1.0 - p) + z2 / (4.0 * total)) / total) / denom
        out := math.max(center - half, 0.0)
    out


f_wilson_high(float successes, float total, float zCrit) =>
    float out = na
    if total > 0 and not na(successes)
        float p = successes / total
        float z2 = zCrit * zCrit
        float denom = 1.0 + z2 / total
        float center = (p + z2 / (2.0 * total)) / denom
        float half = zCrit * math.sqrt((p * (1.0 - p) + z2 / (4.0 * total)) / total) / denom
        out := math.min(center + half, 1.0)
    out


f_fmt_prob_ci(float lo, float hi) =>
    not na(lo) and not na(hi) ? "[" + str.tostring(lo * 100.0, "#.#") + "; " + str.tostring(hi * 100.0, "#.#") + "]%" : "--"


f_pillar_dispersion(float a, float b, float c, float d) =>
    float sum = 0.0
    float sumSq = 0.0
    float n = 0.0
    if not na(a)
        sum += a
        sumSq += a * a
        n += 1.0
    if not na(b)
        sum += b
        sumSq += b * b
        n += 1.0
    if not na(c)
        sum += c
        sumSq += c * c
        n += 1.0
    if not na(d)
        sum += d
        sumSq += d * d
        n += 1.0
    f_sample_sd(sum, sumSq, n)


f_stale_age(int sourceTime) =>
    int age = ta.barssince(ta.change(sourceTime) != 0)
    na(sourceTime) ? 100000 : nz(age, 0)


f_integrity_label(bool warmup, bool inputValid, int pillars, float coverage, int maxStaleAge, int staleLimit) =>
    warmup ? "WARMUP" :
     not inputValid ? "INVALID" :
     maxStaleAge > staleLimit ? "STALE" :
     pillars < 4 or coverage < 0.95 ? "PARTIAL" : "VALID"


f_consensus_label(int breadth60, int breadth80, float dispersion, float dispersionWarn) =>
    breadth80 >= 2 ? "BROAD EXTREME" :
     breadth60 >= 3 ? "BROAD RISK" :
     not na(dispersion) and dispersion >= dispersionWarn ? "DIVERGENT" : "BALANCED"


f_stability_label(
     float calSum, float calSumSq, float calCnt,
     float valSum, float valSumSq, float valCnt,
     int minN, float econFloor) =>
    float calMean = f_avg(calSum, calCnt)
    float valMean = f_avg(valSum, valCnt)
    float calLo = f_ci_low_auto(calSum, calSumSq, calCnt)
    float calHi = f_ci_high_auto(calSum, calSumSq, calCnt)
    float valLo = f_ci_low_auto(valSum, valSumSq, valCnt)
    float valHi = f_ci_high_auto(valSum, valSumSq, valCnt)
    bool enough = calCnt >= minN and valCnt >= minN
    bool sameSign = not na(calMean) and not na(valMean) and ((calMean > 0 and valMean > 0) or (calMean < 0 and valMean < 0))
    bool bothMaterial = not na(calMean) and not na(valMean) and math.abs(calMean) >= econFloor and math.abs(valMean) >= econFloor
    bool calSig = not na(calLo) and not na(calHi) and (calLo > 0 or calHi < 0)
    bool valSig = not na(valLo) and not na(valHi) and (valLo > 0 or valHi < 0)
    not enough ? "OOS THIN" :
     sameSign and bothMaterial and calSig and valSig ? "OOS ROBUST" :
     sameSign and bothMaterial ? "OOS MATERIAL" :
     sameSign ? "SIGN STABLE" : "OOS FRAGILE"


f_paired_control_label(float diffSum, float diffSumSq, float diffCnt, int minN, float econFloor, bool independentApprox) =>
    float diffMean = f_avg(diffSum, diffCnt)
    float diffLo = f_ci_low_auto(diffSum, diffSumSq, diffCnt)
    float diffHi = f_ci_high_auto(diffSum, diffSumSq, diffCnt)
    diffCnt < minN ? "CONTROL THIN" :
     not independentApprox ? "DESCRIPTIVE CONTROL" :
     not na(diffMean) and not na(diffLo) and diffMean >= econFloor and diffLo > 0 ? "FORWARD-DOMINANT" :
     not na(diffMean) and not na(diffHi) and diffMean <= -econFloor and diffHi < 0 ? "BACKWARD-DOMINANT" :
     "NO CLEAR ASYMMETRY"


f_has_jump_window(float closeSeries, int startOffset, int horizon, float maxAbsDailyMove) =>
    bool broken = false
    if horizon > 0
        for j = 0 to horizon - 1
            float newer = closeSeries[startOffset + j]
            float older = closeSeries[startOffset + j + 1]
            if not na(newer) and not na(older) and newer > 0 and older > 0
                float oneDayMove = math.abs(newer / older - 1.0)
                if oneDayMove > maxAbsDailyMove
                    broken := true
    broken


f_rejection_rate(float validCnt, float rejectedCnt) =>
    float valid = nz(validCnt, 0.0)
    float rejected = nz(rejectedCnt, 0.0)
    float total = valid + rejected
    total > 0 ? rejected / total * 100.0 : na


f_sample_health(
     float validCnt, float rejectedCnt,
     float cautionPct, float contaminatedPct, float unusablePct) =>
    float rejectRate = f_rejection_rate(validCnt, rejectedCnt)
    na(rejectRate) ? "NO-DATA" :
     rejectRate > unusablePct ? "UNUSABLE" :
     rejectRate > contaminatedPct ? "CONTAMINATED" :
     rejectRate > cautionPct ? "CAUTION" : "CLEAN"


f_quality_allows_inference(string sampleHealth) =>
    sampleHealth == "CLEAN" or sampleHealth == "CAUTION"


f_quality_evidence(string baseEvidence, string sampleHealth) =>
    sampleHealth == "UNUSABLE" ? "UNUSABLE" :
     sampleHealth == "CONTAMINATED" ? "CONTAMINATED" :
     sampleHealth == "NO-DATA" ? "NO-DATA" :
     sampleHealth == "CAUTION" and baseEvidence == "ROBUST" ? "CAUTION-ROBUST" :
     sampleHealth == "CAUTION" and baseEvidence == "STAT-ONLY" ? "CAUTION-STAT" :
     sampleHealth == "CAUTION" and baseEvidence == "ECON-ONLY" ? "CAUTION-ECON" :
     sampleHealth == "CAUTION" and baseEvidence == "THIN" ? "CAUTION-THIN" :
     sampleHealth == "CAUTION" ? "CAUTION" : baseEvidence


f_academic_label(string baseEvidence, string integrity, string stability, string leadLag, int specAgreement) =>
    integrity == "INVALID" or integrity == "WARMUP" ? "INVALID" :
     integrity == "STALE" ? "DATA-STALE" :
     integrity == "PARTIAL" and baseEvidence == "ROBUST" ? "DATA-PARTIAL" :
     baseEvidence == "THIN" ? "THIN" :
     baseEvidence == "DESCRIPTIVE" ? "DESCRIPTIVE" :
     stability == "OOS FRAGILE" ? "FRAGILE" :
     baseEvidence == "ROBUST" and stability == "OOS ROBUST" and specAgreement >= 2 and leadLag != "BACKWARD-DOMINANT" ? "ROBUST-OOS" :
     (baseEvidence == "ROBUST" or baseEvidence == "STAT-ONLY" or baseEvidence == "ECON-ONLY") and
      (stability == "OOS ROBUST" or stability == "OOS MATERIAL" or stability == "SIGN STABLE") and specAgreement >= 2 ? "STABLE-CONDITIONAL" :
     baseEvidence


f_path_outcomes(float closeSeries, float highSeries, float lowSeries, int horizon, bool useLog) =>
    float startClose = closeSeries[horizon]


    // MAE/MFE begin AFTER the signal close, so the signal bar's pre-close range is excluded.
    float minLow = na
    float maxHigh = na
    if horizon > 0
        for j = 0 to horizon - 1
            int offset = horizon - 1 - j
            float h = highSeries[offset]
            float l = lowSeries[offset]
            if not na(h)
                maxHigh := na(maxHigh) ? h : math.max(maxHigh, h)
            if not na(l)
                minLow := na(minLow) ? l : math.min(minLow, l)


    float mae = not na(startClose) and startClose > 0 and not na(minLow) and minLow > 0 ?
         (useLog ? math.log(minLow / startClose) : minLow / startClose - 1.0) : na
    float mfe = not na(startClose) and startClose > 0 and not na(maxHigh) and maxHigh > 0 ?
         (useLog ? math.log(maxHigh / startClose) : maxHigh / startClose - 1.0) : na


    // Close-to-close path drawdown is unambiguous with daily data and includes the signal close as the initial peak.
    float peakClose = na
    float closeMdd = na
    if not na(startClose) and startClose > 0
        closeMdd := 0.0
        for j = 0 to horizon
            int offset = horizon - j
            float c = closeSeries[offset]
            if not na(c) and c > 0
                peakClose := na(peakClose) ? c : math.max(peakClose, c)
                float dd = useLog ? math.log(c / peakClose) : c / peakClose - 1.0
                closeMdd := math.min(closeMdd, dd)


    [mae, mfe, closeMdd]


f_evidence_label(float sum, float sumSq, float cnt, int minN, float zCrit, float econFloor, bool independentApprox) =>
    float mu = f_avg(sum, cnt)
    float z = f_zstat(sum, sumSq, cnt)
    bool statSig = not na(z) and math.abs(z) >= zCrit
    bool econSig = not na(mu) and math.abs(mu) >= econFloor
    na(cnt) or cnt < minN ? "THIN" :
     not independentApprox ? "DESCRIPTIVE" :
     statSig and econSig ? "ROBUST" :
     statSig ? "STAT-ONLY" :
     econSig ? "ECON-ONLY" : "WEAK"


f_status_from_score(float score, string highText, string lowText) =>
    na(score) ? "NA" : score >= 80 ? highText : score <= 20 ? lowText : "MID"


f_weighted_risk(float s1, float w1, float s2, float w2, float s3, float w3, float s4, float w4) =>
    float numerator = 0.0
    float validWeight = 0.0
    int pillars = 0
    float totalWeight = math.max(w1, 0) + math.max(w2, 0) + math.max(w3, 0) + math.max(w4, 0)


    if not na(s1) and w1 > 0
        numerator += s1 * w1
        validWeight += w1
        pillars += 1
    if not na(s2) and w2 > 0
        numerator += s2 * w2
        validWeight += w2
        pillars += 1
    if not na(s3) and w3 > 0
        numerator += s3 * w3
        validWeight += w3
        pillars += 1
    if not na(s4) and w4 > 0
        numerator += s4 * w4
        validWeight += w4
        pillars += 1


    float coverage = totalWeight > 0 ? validWeight / totalWeight : 0.0
    float risk = validWeight > 0 ? numerator / validWeight : na
    [risk, pillars, coverage]


//=============================================================================
// 1) INPUTS
//=============================================================================


group_clock = "01. Research Clock & Integrity"
research_tf = input.timeframe("1D", "Research timeframe", group=group_clock,
     tooltip="For correct event alignment, the chart timeframe must equal this timeframe.")
use_non_overlap = input.bool(true, "Use non-overlapping outcome samples", group=group_clock,
     tooltip="Recommended for approximate inference. Disable only for descriptive mapping.")
reset_stats = input.bool(false, "Reset accumulated statistics", group=group_clock)
max_stale_daily_bars = input.int(3, "Maximum stale bars: daily sources", minval=0, maxval=20, group=group_clock,
     tooltip="Applied to interbank and sovereign-yield sources. The policy-rate series is stepwise and is reported separately rather than treated as a daily stale failure.")
non_overlap_phase = input.int(0, "Non-overlap phase", minval=0, maxval=59, group=group_clock,
     tooltip="Selects the phase cohort used for non-overlapping outcomes. Values are reduced modulo the selected horizon.")
filter_index_breaks = input.bool(true, "Reject index scale-break windows", group=group_clock,
     tooltip="Excludes outcome windows containing an implausibly large one-day close move, which usually indicates a rebasing or data-stitching defect.")
max_index_daily_move_pct = input.float(15.0, "Maximum valid 1D index move (%)", minval=5.0, maxval=50.0, step=1.0, group=group_clock)


group_macro = "02. Macro Composite"
score_lb = input.int(756, "Percentile lookback", minval=252, maxval=2500, group=group_macro)
risk_smooth_len = input.int(5, "Risk smoothing EMA", minval=1, maxval=60, group=group_macro)
hysteresis_pts = input.float(3.0, "Bucket hysteresis (risk points)", minval=0.0, maxval=10.0, step=0.5, group=group_macro)
min_pillars = input.int(3, "Minimum available pillars", minval=1, maxval=4, group=group_macro)
min_weight_coverage = input.float(0.70, "Minimum valid weight coverage", minval=0.25, maxval=1.0, step=0.05, group=group_macro)
tail_warning_pct = input.float(80.0, "Dominant-pillar tail threshold", minval=60.0, maxval=99.0, step=1.0, group=group_macro)
breadth_warning_pct = input.float(60.0, "Stress-breadth threshold", minval=40.0, maxval=90.0, step=1.0, group=group_macro)
dispersion_warning = input.float(25.0, "Pillar-dispersion warning", minval=5.0, maxval=50.0, step=1.0, group=group_macro)


w_liquidity = input.float(0.35, "Weight: Liquidity stress", minval=0.0, maxval=1.0, step=0.05, group=group_macro)
w_curve = input.float(0.30, "Weight: Curve shape", minval=0.0, maxval=1.0, step=0.05, group=group_macro)
w_external = input.float(0.20, "Weight: International spread", minval=0.0, maxval=1.0, step=0.05, group=group_macro)
w_long_policy = input.float(0.15, "Weight: 10Y–policy spread", minval=0.0, maxval=1.0, step=0.05, group=group_macro)


group_outcome = "03. Outcome Definition"
analysis_horizon = input.int(20, "Displayed horizon", options=[5, 20, 60], group=group_outcome)
transition_horizon = input.int(20, "Transition horizon", options=[5, 20, 60], group=group_outcome)
use_log_return = input.bool(false, "Use log returns", group=group_outcome)
ret_clip_hi = input.float(0.80, "Winsor cap: upper return", minval=0.10, maxval=3.0, step=0.05, group=group_outcome)
ret_clip_lo = input.float(-0.60, "Winsor cap: lower return", minval=-0.95, maxval=-0.05, step=0.05, group=group_outcome)


group_sample = "04. Sample & Holdout"
sample_mode = input.string("Full sample", "Sample mode",
     options=["Full sample", "Calibration", "Validation"], group=group_sample)
sample_start_year = input.int(2015, "Start year", minval=2000, maxval=2100, group=group_sample)
sample_end_year = input.int(2100, "End year", minval=2000, maxval=2100, group=group_sample)
split_year = input.int(2022, "Calibration/validation split year", minval=2001, maxval=2099, group=group_sample)


group_inference = "05. Inference & Materiality"
min_n_market = input.int(30, "Minimum N: market", minval=10, maxval=500, group=group_inference)
min_n_sector = input.int(30, "Minimum N: sector", minval=10, maxval=500, group=group_inference)
min_n_transition = input.int(30, "Minimum N: transition state origin", minval=10, maxval=500, group=group_inference)
min_n_transition_return = input.int(20, "Minimum N: transition return direction", minval=10, maxval=500, group=group_inference,
     tooltip="State probability and market-return inference use separate sample-size gates.")
min_n_oos = input.int(15, "Minimum N: each OOS segment", minval=8, maxval=100, group=group_inference,
     tooltip="Calibration and validation are assessed separately. This threshold is intentionally distinct from the full-sample minimum N.")
min_n_control = input.int(20, "Minimum N: paired negative control", minval=10, maxval=200, group=group_inference)
z_critical_market = input.float(1.96, "Critical |z|: market", minval=1.0, maxval=4.0, step=0.01, group=group_inference)
z_critical_sector = input.float(2.58, "User critical |z|: sector", minval=1.0, maxval=4.0, step=0.01, group=group_inference)
sector_multiple_testing = input.string("Bonferroni 11", "Sector multiple-testing control",
     options=["Bonferroni 11", "User critical"], group=group_inference,
     tooltip="Bonferroni 11 uses a two-sided family-wise 5% threshold of approximately |z| = 2.84.")
market_econ_floor_pct = input.float(1.0, "Economic floor: market return (%)", minval=0.0, maxval=20.0, step=0.25, group=group_inference)
sector_econ_floor_pct = input.float(1.0, "Economic floor: sector relative return (%)", minval=0.0, maxval=20.0, step=0.25, group=group_inference)


group_quality = "06. Outcome Data Quality"
rejection_caution_pct = input.float(10.0, "Rejection rate: caution (%)", minval=0.0, maxval=50.0, step=1.0, group=group_quality)
rejection_contaminated_pct = input.float(20.0, "Rejection rate: contaminated (%)", minval=1.0, maxval=75.0, step=1.0, group=group_quality)
rejection_unusable_pct = input.float(35.0, "Rejection rate: unusable (%)", minval=1.0, maxval=95.0, step=1.0, group=group_quality,
     tooltip="Above this rejection rate, mean/path statistics remain visible only as diagnostics and inferential fields are suppressed.")
min_sector_breadth = input.int(6, "Minimum eligible sectors for rotation ranking", minval=4, maxval=11, group=group_quality,
     tooltip="Eligible means minimum N is met and rejection health is CLEAN or CAUTION. Below this breadth, the panel lists eligible series but does not claim Top/Bottom rotation.")


group_view = "07. View"
bucket_view = input.string("Auto (current)", "Bucket view",
     options=["Auto (current)", "B0 (0–20)", "B1 (20–40)", "B2 (40–60)", "B3 (60–80)", "B4 (80–100)"],
     group=group_view)
panel_view = input.string("Panel 1 — Macro Weather", "Panel",
     options=["Panel 1 — Macro Weather", "Panel 2 — Market Conditional Returns", "Panel 3 — Sector Rotation", "Panel 4 — Transition Matrix"],
     group=group_view)
show_method_note = input.bool(true, "Show methodology note", group=group_view)
show_path_risk = input.bool(true, "Show MAE / MFE / close-MDD", group=group_view)


//=============================================================================
// 2) RUNTIME INTEGRITY GATE
//=============================================================================


float chart_seconds = timeframe.in_seconds()
float research_seconds = timeframe.in_seconds(research_tf)


if barstate.isfirst and math.abs(chart_seconds - research_seconds) > 0.5
    runtime.error("Academic Build requires chart timeframe = Research timeframe. Change the chart to " + research_tf + ".")


if barstate.isfirst and sample_end_year < sample_start_year
    runtime.error("Sample end year must be greater than or equal to start year.")


if barstate.isfirst and not (rejection_caution_pct < rejection_contaminated_pct and rejection_contaminated_pct < rejection_unusable_pct)
    runtime.error("Outcome-quality thresholds must satisfy caution < contaminated < unusable.")


//=============================================================================
// 3) CONFIRMED DATA REQUESTS
//=============================================================================


f_request_close(string symbol) =>
    request.security(symbol, research_tf, close[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)


f_request_close_time(string symbol) =>
    request.security(symbol, research_tf, [close[1], time[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)


f_request_ohlct(string symbol) =>
    request.security(symbol, research_tf, [close[1], high[1], low[1], time[1]], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)


// Macro series. Close and source timestamp are requested together to preserve request-budget headroom.
[policy_rate, policy_time] = f_request_close_time("VNINTR")
[bond_2y, bond_2y_time] = f_request_close_time("VN02Y")
[bond_10y, bond_10y_time] = f_request_close_time("VN10Y")
[us_10y, us_10y_time] = f_request_close_time("US10Y")
[interbank_rate, interbank_time] = f_request_close_time("VNINBR")


// Market indices. OHLC and timestamp are requested as tuples.
[mkt_vnindex, mkt_vnindex_high, mkt_vnindex_low, confirmed_market_time] = f_request_ohlct("HOSE:VNINDEX")
[mkt_vn30, mkt_vn30_high, mkt_vn30_low, mkt_vn30_time] = f_request_ohlct("HOSE:VN30")
[mkt_vn100, mkt_vn100_high, mkt_vn100_low, mkt_vn100_time] = f_request_ohlct("HOSE:VN100")
[mkt_vnall, mkt_vnall_high, mkt_vnall_low, mkt_vnall_time] = f_request_ohlct("HOSE:VNALLSHARE")
[mkt_vnmid, mkt_vnmid_high, mkt_vnmid_low, mkt_vnmid_time] = f_request_ohlct("HOSE:VNMIDCAP")
[mkt_vnsmall, mkt_vnsmall_high, mkt_vnsmall_low, mkt_vnsmall_time] = f_request_ohlct("HOSE:VNSMALLCAP")


// Sector indices
float sec_vnfin = f_request_close("HOSE:VNFIN")
float sec_vnfin_sel = f_request_close("HOSE:VNFINSELECT")
float sec_vnind = f_request_close("HOSE:VNIND")
float sec_vnit = f_request_close("HOSE:VNIT")
float sec_vnreal = f_request_close("HOSE:VNREAL")
float sec_vncons = f_request_close("HOSE:VNCONS")
float sec_vncond = f_request_close("HOSE:VNCOND")
float sec_vnene = f_request_close("HOSE:VNENE")
float sec_vnmat = f_request_close("HOSE:VNMAT")
float sec_vnheal = f_request_close("HOSE:VNHEAL")
float sec_vnuti = f_request_close("HOSE:VNUTI")


//=============================================================================
// 4) MACRO ENGINE
//=============================================================================


float liquidity_stress = interbank_rate - policy_rate
float curve_standard = bond_10y - bond_2y
float intl_yield_diff = bond_10y - us_10y
float long_policy_spread = bond_10y - policy_rate


float score_liquidity = f_score_high_bad(liquidity_stress, score_lb)
float score_curve = f_score_low_bad(curve_standard, score_lb)
float score_external = f_score_low_bad(intl_yield_diff, score_lb)
float score_long_policy = f_score_low_bad(long_policy_spread, score_lb)


[risk_raw_unchecked, pillar_count, weight_coverage] = f_weighted_risk(
     score_liquidity, w_liquidity,
     score_curve, w_curve,
     score_external, w_external,
     score_long_policy, w_long_policy)


bool macro_warmup = bar_index < score_lb
bool risk_input_valid = pillar_count >= min_pillars and weight_coverage >= min_weight_coverage
float risk_raw = risk_input_valid ? f_clamp(risk_raw_unchecked, 0.0, 100.0) : na
float risk_pct = risk_smooth_len > 1 ? ta.ema(risk_raw, risk_smooth_len) : risk_raw
bool risk_valid = not na(risk_pct)
string dataq = f_dataq_label(pillar_count, weight_coverage)


// Source-age diagnostics. Source timestamps change even when a rate itself is unchanged.
int stale_policy = f_stale_age(policy_time)
int stale_2y = f_stale_age(bond_2y_time)
int stale_10y = f_stale_age(bond_10y_time)
int stale_us10y = f_stale_age(us_10y_time)
int stale_interbank = f_stale_age(interbank_time)
// The policy rate is a legitimate step function. Daily freshness is assessed only on market-observed rate/yield series.
int max_daily_stale_age = math.max(stale_2y, math.max(stale_10y, math.max(stale_us10y, stale_interbank)))
string integrity_state = f_integrity_label(macro_warmup, risk_input_valid, pillar_count, weight_coverage, max_daily_stale_age, max_stale_daily_bars)


// Cross-pillar structure diagnostics.
float dominant_score = na
string dominant_pillar = "NA"
if not na(score_liquidity)
    dominant_score := score_liquidity
    dominant_pillar := "Liquidity"
if not na(score_curve) and (na(dominant_score) or score_curve > dominant_score)
    dominant_score := score_curve
    dominant_pillar := "Curve"
if not na(score_external) and (na(dominant_score) or score_external > dominant_score)
    dominant_score := score_external
    dominant_pillar := "External"
if not na(score_long_policy) and (na(dominant_score) or score_long_policy > dominant_score)
    dominant_score := score_long_policy
    dominant_pillar := "Long–Policy"


int stress_breadth60 = (not na(score_liquidity) and score_liquidity >= breadth_warning_pct ? 1 : 0) +
     (not na(score_curve) and score_curve >= breadth_warning_pct ? 1 : 0) +
     (not na(score_external) and score_external >= breadth_warning_pct ? 1 : 0) +
     (not na(score_long_policy) and score_long_policy >= breadth_warning_pct ? 1 : 0)
int stress_breadth80 = (not na(score_liquidity) and score_liquidity >= tail_warning_pct ? 1 : 0) +
     (not na(score_curve) and score_curve >= tail_warning_pct ? 1 : 0) +
     (not na(score_external) and score_external >= tail_warning_pct ? 1 : 0) +
     (not na(score_long_policy) and score_long_policy >= tail_warning_pct ? 1 : 0)
float pillar_dispersion = f_pillar_dispersion(score_liquidity, score_curve, score_external, score_long_policy)
bool tail_override = not na(dominant_score) and dominant_score >= tail_warning_pct
string consensus_state = f_consensus_label(stress_breadth60, stress_breadth80, pillar_dispersion, dispersion_warning)


// Fixed-lookback specification sensitivity for the current macro-state classification.
float sens_liq_504 = f_score_high_bad(liquidity_stress, 504)
float sens_curve_504 = f_score_low_bad(curve_standard, 504)
float sens_external_504 = f_score_low_bad(intl_yield_diff, 504)
float sens_long_504 = f_score_low_bad(long_policy_spread, 504)
[sens_raw_504_u, sens_pillars_504, sens_cov_504] = f_weighted_risk(
     sens_liq_504, w_liquidity, sens_curve_504, w_curve,
     sens_external_504, w_external, sens_long_504, w_long_policy)
float sens_raw_504 = sens_pillars_504 >= min_pillars and sens_cov_504 >= min_weight_coverage ? sens_raw_504_u : na
float sens_risk_504 = risk_smooth_len > 1 ? ta.ema(sens_raw_504, risk_smooth_len) : sens_raw_504


float sens_liq_756 = f_score_high_bad(liquidity_stress, 756)
float sens_curve_756 = f_score_low_bad(curve_standard, 756)
float sens_external_756 = f_score_low_bad(intl_yield_diff, 756)
float sens_long_756 = f_score_low_bad(long_policy_spread, 756)
[sens_raw_756_u, sens_pillars_756, sens_cov_756] = f_weighted_risk(
     sens_liq_756, w_liquidity, sens_curve_756, w_curve,
     sens_external_756, w_external, sens_long_756, w_long_policy)
float sens_raw_756 = sens_pillars_756 >= min_pillars and sens_cov_756 >= min_weight_coverage ? sens_raw_756_u : na
float sens_risk_756 = risk_smooth_len > 1 ? ta.ema(sens_raw_756, risk_smooth_len) : sens_raw_756


float sens_liq_1260 = f_score_high_bad(liquidity_stress, 1260)
float sens_curve_1260 = f_score_low_bad(curve_standard, 1260)
float sens_external_1260 = f_score_low_bad(intl_yield_diff, 1260)
float sens_long_1260 = f_score_low_bad(long_policy_spread, 1260)
[sens_raw_1260_u, sens_pillars_1260, sens_cov_1260] = f_weighted_risk(
     sens_liq_1260, w_liquidity, sens_curve_1260, w_curve,
     sens_external_1260, w_external, sens_long_1260, w_long_policy)
float sens_raw_1260 = sens_pillars_1260 >= min_pillars and sens_cov_1260 >= min_weight_coverage ? sens_raw_1260_u : na
float sens_risk_1260 = risk_smooth_len > 1 ? ta.ema(sens_raw_1260, risk_smooth_len) : sens_raw_1260


int sens_bucket_504 = f_bucket_raw(sens_risk_504)
int sens_bucket_756 = f_bucket_raw(sens_risk_756)
int sens_bucket_1260 = f_bucket_raw(sens_risk_1260)
int spec_agreement = na(sens_bucket_504) or na(sens_bucket_756) or na(sens_bucket_1260) ? 0 :
     sens_bucket_504 == sens_bucket_756 and sens_bucket_756 == sens_bucket_1260 ? 3 :
     sens_bucket_504 == sens_bucket_756 or sens_bucket_504 == sens_bucket_1260 or sens_bucket_756 == sens_bucket_1260 ? 2 : 1
string spec_bucket_text = not na(sens_bucket_504) and not na(sens_bucket_756) and not na(sens_bucket_1260) ?
     "B" + str.tostring(sens_bucket_504) + "/B" + str.tostring(sens_bucket_756) + "/B" + str.tostring(sens_bucket_1260) : "--"


// Stateful hysteresis bucket.
var int risk_bucket = na
if risk_valid
    if na(risk_bucket)
        risk_bucket := f_bucket_raw(risk_pct)
    else
        while risk_bucket < 4 and risk_pct >= f_upper_boundary(risk_bucket) + hysteresis_pts
            risk_bucket += 1
        while risk_bucket > 0 and risk_pct < f_lower_boundary(risk_bucket) - hysteresis_pts
            risk_bucket -= 1


int risk_bucket_20ago = risk_valid[20] ? risk_bucket[20] : na
float risk_ma20 = ta.sma(risk_pct, 20)
float risk_mom5 = risk_pct - risk_pct[5]
float risk_vol20 = ta.stdev(risk_pct, 20)


plot(risk_pct, "Macro Risk % (confirmed)", color=color.new(color.orange, 0), linewidth=2)
plot(risk_ma20, "Risk MA20", color=color.new(color.blue, 20), linewidth=1)
plot(20, "B0/B1", color=color.new(color.gray, 88))
plot(40, "B1/B2", color=color.new(color.gray, 88))
plot(60, "B2/B3", color=color.new(color.gray, 88))
plot(80, "B3/B4", color=color.new(color.gray, 88))


//=============================================================================
// 5) SERIES ACCESSORS
//=============================================================================


var string[] market_names = array.from("VNINDEX", "VN30", "VN100", "VNALLSHARE", "VNMIDCAP", "VNSMALLCAP")
var string[] sector_names = array.from("VNFIN", "VNFINSELECT", "VNIND", "VNIT", "VNREAL", "VNCONS", "VNCOND", "VNENE", "VNMAT", "VNHEAL", "VNUTI")


f_market_close(int m) =>
    m == 0 ? mkt_vnindex :
     m == 1 ? mkt_vn30 :
     m == 2 ? mkt_vn100 :
     m == 3 ? mkt_vnall :
     m == 4 ? mkt_vnmid :
     m == 5 ? mkt_vnsmall : na


f_market_high(int m) =>
    m == 0 ? mkt_vnindex_high :
     m == 1 ? mkt_vn30_high :
     m == 2 ? mkt_vn100_high :
     m == 3 ? mkt_vnall_high :
     m == 4 ? mkt_vnmid_high :
     m == 5 ? mkt_vnsmall_high : na


f_market_low(int m) =>
    m == 0 ? mkt_vnindex_low :
     m == 1 ? mkt_vn30_low :
     m == 2 ? mkt_vn100_low :
     m == 3 ? mkt_vnall_low :
     m == 4 ? mkt_vnmid_low :
     m == 5 ? mkt_vnsmall_low : na


f_sector_close(int s) =>
    s == 0 ? sec_vnfin :
     s == 1 ? sec_vnfin_sel :
     s == 2 ? sec_vnind :
     s == 3 ? sec_vnit :
     s == 4 ? sec_vnreal :
     s == 5 ? sec_vncons :
     s == 6 ? sec_vncond :
     s == 7 ? sec_vnene :
     s == 8 ? sec_vnmat :
     s == 9 ? sec_vnheal :
     s == 10 ? sec_vnuti : na


float benchmark_close = mkt_vnindex


//=============================================================================
// 6) STATISTICS STORAGE
//=============================================================================


// Market cells: 6 markets × 5 buckets = 30 per horizon.
var float[] sumR5_market = array.new_float(30, 0.0)
var float[] sumSqR5_market = array.new_float(30, 0.0)
var float[] cntR5_market = array.new_float(30, 0.0)
var float[] winR5_market = array.new_float(30, 0.0)
var float[] sumMAE5_market = array.new_float(30, 0.0)
var float[] cntMAE5_market = array.new_float(30, 0.0)
var float[] sumMFE5_market = array.new_float(30, 0.0)
var float[] cntMFE5_market = array.new_float(30, 0.0)
var float[] sumMDD5_market = array.new_float(30, 0.0)
var float[] cntMDD5_market = array.new_float(30, 0.0)


var float[] sumR20_market = array.new_float(30, 0.0)
var float[] sumSqR20_market = array.new_float(30, 0.0)
var float[] cntR20_market = array.new_float(30, 0.0)
var float[] winR20_market = array.new_float(30, 0.0)
var float[] sumMAE20_market = array.new_float(30, 0.0)
var float[] cntMAE20_market = array.new_float(30, 0.0)
var float[] sumMFE20_market = array.new_float(30, 0.0)
var float[] cntMFE20_market = array.new_float(30, 0.0)
var float[] sumMDD20_market = array.new_float(30, 0.0)
var float[] cntMDD20_market = array.new_float(30, 0.0)


var float[] sumR60_market = array.new_float(30, 0.0)
var float[] sumSqR60_market = array.new_float(30, 0.0)
var float[] cntR60_market = array.new_float(30, 0.0)
var float[] winR60_market = array.new_float(30, 0.0)
var float[] sumMAE60_market = array.new_float(30, 0.0)
var float[] cntMAE60_market = array.new_float(30, 0.0)
var float[] sumMFE60_market = array.new_float(30, 0.0)
var float[] cntMFE60_market = array.new_float(30, 0.0)
var float[] sumMDD60_market = array.new_float(30, 0.0)
var float[] cntMDD60_market = array.new_float(30, 0.0)
var float[] rejectR5_market = array.new_float(30, 0.0)
var float[] rejectR20_market = array.new_float(30, 0.0)
var float[] rejectR60_market = array.new_float(30, 0.0)


// Sector cells: 11 sectors × 5 buckets = 55 per horizon.
var float[] sumRR5_sector = array.new_float(55, 0.0)
var float[] sumSqRR5_sector = array.new_float(55, 0.0)
var float[] cntRR5_sector = array.new_float(55, 0.0)
var float[] winRR5_sector = array.new_float(55, 0.0)


var float[] sumRR20_sector = array.new_float(55, 0.0)
var float[] sumSqRR20_sector = array.new_float(55, 0.0)
var float[] cntRR20_sector = array.new_float(55, 0.0)
var float[] winRR20_sector = array.new_float(55, 0.0)


var float[] sumRR60_sector = array.new_float(55, 0.0)
var float[] sumSqRR60_sector = array.new_float(55, 0.0)
var float[] cntRR60_sector = array.new_float(55, 0.0)
var float[] winRR60_sector = array.new_float(55, 0.0)
var float[] rejectRR5_sector = array.new_float(55, 0.0)
var float[] rejectRR20_sector = array.new_float(55, 0.0)
var float[] rejectRR60_sector = array.new_float(55, 0.0)


// VNINDEX auxiliary robustness cells: backward control and fixed calibration/validation.
var float[] sumBackR5_vni = array.new_float(5, 0.0)
var float[] sumSqBackR5_vni = array.new_float(5, 0.0)
var float[] cntBackR5_vni = array.new_float(5, 0.0)
var float[] sumCalR5_vni = array.new_float(5, 0.0)
var float[] sumSqCalR5_vni = array.new_float(5, 0.0)
var float[] cntCalR5_vni = array.new_float(5, 0.0)
var float[] sumValR5_vni = array.new_float(5, 0.0)
var float[] sumSqValR5_vni = array.new_float(5, 0.0)
var float[] cntValR5_vni = array.new_float(5, 0.0)


var float[] sumBackR20_vni = array.new_float(5, 0.0)
var float[] sumSqBackR20_vni = array.new_float(5, 0.0)
var float[] cntBackR20_vni = array.new_float(5, 0.0)
var float[] sumCalR20_vni = array.new_float(5, 0.0)
var float[] sumSqCalR20_vni = array.new_float(5, 0.0)
var float[] cntCalR20_vni = array.new_float(5, 0.0)
var float[] sumValR20_vni = array.new_float(5, 0.0)
var float[] sumSqValR20_vni = array.new_float(5, 0.0)
var float[] cntValR20_vni = array.new_float(5, 0.0)


var float[] sumBackR60_vni = array.new_float(5, 0.0)
var float[] sumSqBackR60_vni = array.new_float(5, 0.0)
var float[] cntBackR60_vni = array.new_float(5, 0.0)
var float[] sumCalR60_vni = array.new_float(5, 0.0)
var float[] sumSqCalR60_vni = array.new_float(5, 0.0)
var float[] cntCalR60_vni = array.new_float(5, 0.0)
var float[] sumValR60_vni = array.new_float(5, 0.0)
var float[] sumSqValR60_vni = array.new_float(5, 0.0)
var float[] cntValR60_vni = array.new_float(5, 0.0)
var float[] sumDiffR5_vni = array.new_float(5, 0.0)
var float[] sumSqDiffR5_vni = array.new_float(5, 0.0)
var float[] cntDiffR5_vni = array.new_float(5, 0.0)
var float[] sumDiffR20_vni = array.new_float(5, 0.0)
var float[] sumSqDiffR20_vni = array.new_float(5, 0.0)
var float[] cntDiffR20_vni = array.new_float(5, 0.0)
var float[] sumDiffR60_vni = array.new_float(5, 0.0)
var float[] sumSqDiffR60_vni = array.new_float(5, 0.0)
var float[] cntDiffR60_vni = array.new_float(5, 0.0)


// Transition cells: 5 origin buckets × 5 destination buckets = 25.
// State counts drive transition probabilities; return counts include only clean VNINDEX windows.
var float[] trans_state_count = array.new_float(25, 0.0)
var float[] trans_count = array.new_float(25, 0.0)
var float[] trans_reject = array.new_float(25, 0.0)
var float[] trans_sum_ret = array.new_float(25, 0.0)
var float[] trans_sum_sq_ret = array.new_float(25, 0.0)
var float[] trans_win = array.new_float(25, 0.0)


f_reset_all_stats() =>
    f_reset_float_array(sumR5_market)
    f_reset_float_array(sumSqR5_market)
    f_reset_float_array(cntR5_market)
    f_reset_float_array(winR5_market)
    f_reset_float_array(sumMAE5_market)
    f_reset_float_array(cntMAE5_market)
    f_reset_float_array(sumMFE5_market)
    f_reset_float_array(cntMFE5_market)
    f_reset_float_array(sumMDD5_market)
    f_reset_float_array(cntMDD5_market)
    f_reset_float_array(sumR20_market)
    f_reset_float_array(sumSqR20_market)
    f_reset_float_array(cntR20_market)
    f_reset_float_array(winR20_market)
    f_reset_float_array(sumMAE20_market)
    f_reset_float_array(cntMAE20_market)
    f_reset_float_array(sumMFE20_market)
    f_reset_float_array(cntMFE20_market)
    f_reset_float_array(sumMDD20_market)
    f_reset_float_array(cntMDD20_market)
    f_reset_float_array(sumR60_market)
    f_reset_float_array(sumSqR60_market)
    f_reset_float_array(cntR60_market)
    f_reset_float_array(winR60_market)
    f_reset_float_array(sumMAE60_market)
    f_reset_float_array(cntMAE60_market)
    f_reset_float_array(sumMFE60_market)
    f_reset_float_array(cntMFE60_market)
