     sumRR20_sector, sumSqRR20_sector, cntRR20_sector, winRR20_sector, rejectRR20_sector)


// Explicitly unrolled 60-bar market calls. Each written call owns an independent series history.
f_update_one_market(
     0, mkt_vnindex, mkt_vnindex_high, mkt_vnindex_low, 60,
     sumR60_market, sumSqR60_market, cntR60_market, winR60_market,
     sumMAE60_market, cntMAE60_market, sumMFE60_market, cntMFE60_market, sumMDD60_market, cntMDD60_market,
